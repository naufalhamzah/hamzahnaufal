---
/**
 * PREVIEW: ABOUT
 *
 * HOMEPAGE PREVIEW — deliberately short. It shows one paragraph and the focus
 * areas, then hands off to /about for the full background. The brief is
 * explicit that the homepage is an overview and the pages carry the detail.
 *
 * IMAGE BUDGET: one photograph.
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import { profile } from '@/data/profile';

/** The single strongest About visual. */
const photo = {
  src: '/images/about/office.webp',
  alt: 'Exterior view of the Beauty Innovation Laboratories office building',
  width: 1200,
  height: 1697,
};

const previewParagraph = profile.summary[1];
---

<section class="pv" id="about-preview">
  <div class="shell">
    <SectionHead
      index="01"
      eyebrow="About"
      title="Where data, process and technology meet"
      href="/about"
      linkLabel="Read full background"
    />

    <div class="pv__grid">
      <figure class="pv__figure">
        <img
          src={photo.src}
          alt={photo.alt}
          width={photo.width}
          height={photo.height}
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="pv__body">
        <p class="pv__text">{previewParagraph}</p>

        <ul class="pv__focus" aria-label="Focus areas">
          {profile.focusAreas.map((f) => <li class="pv__chip mono">{f}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .pv {
    padding-block: var(--section-y);
  }

  .pv__grid {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 860px) {
    .pv__grid {
      /* Image is the smaller column here — the text leads this section. */
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
    }
  }

  .pv__figure {
    margin: 0;
    position: relative;
  }

  .pv__figure img {
    width: 100%;
    height: auto;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-xs);
  }

  /* A short accent rule at the top-left, echoing the hero treatment. */
  .pv__figure::before {
    content: '';
    position: absolute;
    inset: -0.6rem auto auto -0.6rem;
    width: 2.5rem;
    height: 2px;
    background-color: var(--accent);
  }

  @media (max-width: 859px) {
    .pv__figure {
      max-width: 17rem;
    }
  }

  .pv__body {
    padding-top: 0.25rem;
  }

  .pv__text {
    max-width: 60ch;
    font-size: var(--text-lg);
    color: var(--fg-muted);
  }

  .pv__focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.5rem;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) 0 0;
    list-style: none;
    border-top: var(--hairline) solid var(--border-faint);
  }

  .pv__chip {
    padding: 0.3rem 0.7rem;
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-full);
    color: var(--fg-subtle);
    text-transform: none;
    letter-spacing: 0.03em;
  }
</style>
