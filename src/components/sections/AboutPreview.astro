---
/**
 * PREVIEW: ABOUT  (homepage)
 *
 * A curated introduction, not the full narrative. One paragraph and the focus
 * areas; /about carries the complete background.
 *
 * IMAGE BUDGET: one photograph.
 *
 * On the photograph — this slot previously held `/images/about/office.webp`, a
 * picture of an office building. It has been REPLACED, for two reasons:
 *
 *   1. The source image is a flattened slide composition: it carries the deck's
 *      own navy and teal decorative strokes and a diagonally-cropped white field
 *      baked into the pixels. It is not a photograph, it is a slide.
 *   2. Its alt text asserted it was "the Beauty Innovation Laboratories office
 *      building", but nothing in the frame shows any signage or name. Attributing
 *      a building to a named employer on that basis is a guess, and a guess is
 *      exactly what this project must not publish.
 *
 * What replaces it is a real photograph of the actual work — presenting at a
 * university programme in the UNNES faculty jacket — which supports the About
 * copy instead of decorating it, and needs no attribution it cannot prove.
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import { profile } from '@/data/profile';

const photo = {
  src: '/images/about/beautylab-system.webp',
  alt: 'The Beauty Innovation Laboratories customer data spreadsheet, listing brand, product, sample value, payment status and PIC columns',
  width: 1400,
  height: 788,
};
---

<section class="ab" id="about-preview">
  <div class="shell">
    <SectionHead
      index="01"
      eyebrow="About"
      title="Where data, process and technology meet"
      href="/about"
      linkLabel="See more about me"
    />

    <div class="ab__grid">
      <figure class="ab__figure">
        <img
          src={photo.src}
          alt={photo.alt}
          width={photo.width}
          height={photo.height}
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="ab__body">
        <p class="ab__text">{profile.summary[1]}</p>

        <ul class="ab__focus" aria-label="Focus areas">
          {profile.focusAreas.map((f) => <li class="ab__chip mono">{f}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .ab__grid {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 880px) {
    .ab__grid {
      /*
        The image column is WIDER here than in the previous version, because the
        photograph changed from a portrait building shot to a landscape
        screenshot. A landscape image in a narrow column renders about 180px
        tall — too small to read, and it looks like an afterthought.

        The text still leads: it keeps the larger share (1.15fr against 1fr) and
        the image sits on its own row alignment rather than being stretched.
      */
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }

  .ab__figure {
    position: relative;
    margin: 0;
    /*
      Theme-aware matte for the photograph, same treatment as the hero: a
      screenshot is mostly WHITE, so on paper it needs a visible edge to separate
      from ivory, and on dark it needs a matte so the bright panel reads as a
      deliberate plate rather than a hole punched in the page.
    */
    padding: 0.5rem;
    background-color: var(--photo-mat);
    border: var(--hairline) solid var(--photo-edge);
    border-radius: var(--r-xs);
    box-shadow: var(--photo-shadow);
  }

  .ab__figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--r-xs) - 2px);
    filter: var(--photo-filter);
  }

  /* A short accent rule at the top-left, echoing the hero. */
  .ab__figure::before {
    content: '';
    position: absolute;
    inset: -0.6rem auto auto -0.6rem;
    width: 2.5rem;
    height: 2px;
    background-color: var(--accent);
  }

  @media (max-width: 879px) {
    .ab__figure {
      max-width: 26rem;
    }
  }

  .ab__text {
    max-width: 56ch;
    font-size: var(--text-lg);
    color: var(--fg-muted);
  }

  .ab__focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.5rem;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) 0 0;
    list-style: none;
    border-top: var(--hairline) solid var(--border-faint);
  }

  .ab__chip {
    padding: 0.3rem 0.7rem;
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-full);
    color: var(--fg-subtle);
    text-transform: none;
    letter-spacing: 0.03em;
  }
</style>
