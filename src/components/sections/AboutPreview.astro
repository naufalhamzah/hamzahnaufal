---
/**
 * PREVIEW: ABOUT  (homepage)
 *
 * A curated introduction, not the full narrative. One paragraph and the focus
 * areas; /about carries the complete background.
 *
 * IMAGE BUDGET: one photograph.
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import { profile } from '@/data/profile';

const photo = {
  src: '/images/about/office.webp',
  alt: 'The Beauty Innovation Laboratories office building, where I built the marketing data system',
  width: 1200,
  height: 1697,
};
---

<section class="ab" id="about-preview">
  <div class="shell">
    <SectionHead
      index="01"
      eyebrow="About"
      title="Where data, process and technology meet"
      href="/about"
      linkLabel="Read full background"
    />

    <div class="ab__grid">
      <figure class="ab__figure">
        <img
          src={photo.src}
          alt={photo.alt}
          width={photo.width}
          height={photo.height}
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="ab__body">
        <p class="ab__text">{profile.summary[1]}</p>

        <ul class="ab__focus" aria-label="Focus areas">
          {profile.focusAreas.map((f) => <li class="ab__chip mono">{f}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .ab__grid {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 880px) {
    .ab__grid {
      /* The image is the smaller column — the text leads this section. */
      grid-template-columns: minmax(0, 0.62fr) minmax(0, 1fr);
    }
  }

  .ab__figure {
    position: relative;
    margin: 0;
  }

  .ab__figure img {
    width: 100%;
    height: auto;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-xs);
  }

  /* A short accent rule at the top-left, echoing the hero. */
  .ab__figure::before {
    content: '';
    position: absolute;
    inset: -0.6rem auto auto -0.6rem;
    width: 2.5rem;
    height: 2px;
    background-color: var(--accent);
  }

  @media (max-width: 879px) {
    .ab__figure {
      max-width: 15rem;
    }
  }

  .ab__text {
    max-width: 56ch;
    font-size: var(--text-lg);
    color: var(--fg-muted);
  }

  .ab__focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.5rem;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) 0 0;
    list-style: none;
    border-top: var(--hairline) solid var(--border-faint);
  }

  .ab__chip {
    padding: 0.3rem 0.7rem;
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-full);
    color: var(--fg-subtle);
    text-transform: none;
    letter-spacing: 0.03em;
  }
</style>
