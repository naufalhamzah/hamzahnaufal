---
/**
 * PREVIEW: ABOUT  (homepage)
 *
 * A curated introduction, not the full narrative. /about carries the rest.
 *
 * IMAGE BUDGET: NONE — deliberately.
 *
 * This section used to carry a screenshot of the marketing data system. It is
 * removed, for two reasons the user named directly:
 *
 *   1. "gambar pecah" — a dense spreadsheet screenshot carries its meaning in
 *      its TEXT, and at the column width this section allowed, that text
 *      rendered about 5px tall. It was not legible, so it proved nothing; it
 *      read as a broken image rather than a screenshot.
 *   2. The homepage's image budget belongs to the hero and the selected work.
 *      A third image here competed with both.
 *
 * The screenshot is still used where it CAN be read: on /experience inside the
 * BeautyLab entry, at full article width.
 *
 * So this section is set as pure typography plus a narrow reference rail.
 * Nothing is invented: every number below is COUNTED from the data files.
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import { profile } from '@/data/profile';
import { projectEntries } from '@/data/projects';
import { experienceSorted } from '@/data/experience';
import { publicationEntries } from '@/data/publications';

/**
 * Figures for the rail, counted from the data layer so they cannot drift out of
 * step with the content. Each is a count of something that exists — no invented
 * metrics, no percentages.
 */
const stats = [
  { value: String(projectEntries.length), label: 'Projects' },
  { value: String(experienceSorted.length), label: 'Roles' },
  { value: String(publicationEntries.length), label: 'Papers' },
];
---

<section class="ab" id="about-preview">
  <div class="shell">
    <SectionHead
      index="01"
      eyebrow="About"
      title="Where data, process and technology meet"
      href="/about"
      linkLabel="See more about me"
    />

    <div class="ab__grid">
      <div class="ab__body">
        <p class="ab__lede">{profile.summary[0]}</p>
        <p class="ab__text">{profile.summary[1]}</p>
      </div>

      <aside class="ab__side" aria-label="At a glance">
        <p class="label ab__side-h">At a glance</p>

        <dl class="ab__stats">
          {stats.map((s) => (
            <div class="ab__stat">
              <dt class="ab__stat-v">{s.value}</dt>
              <dd class="ab__stat-l mono">{s.label}</dd>
            </div>
          ))}
        </dl>

        <p class="label ab__side-h ab__side-h--2">Focus areas</p>
        <ul class="ab__focus" aria-label="Focus areas">
          {profile.focusAreas.map((f) => <li class="ab__chip mono">{f}</li>)}
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  /*
    Two columns on desktop: the prose leads on the left, a narrow reference rail
    on the right carries the counts and the focus chips.

    The asymmetry is deliberate. With the image gone, a plain two-paragraph block
    would have run the full measure and read as a wall of text, so the rail is
    what keeps the section structured without a picture — and the prose keeps the
    wider column because it is the introduction, not the fact panel.
  */
  .ab__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 880px) {
    .ab__grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }
  }

  .ab__lede {
    max-width: 58ch;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.34;
    color: var(--fg);
  }

  .ab__text {
    max-width: 58ch;
    margin-top: clamp(1rem, 2vw, 1.35rem);
    color: var(--fg-muted);
  }

  /* ---------------- reference rail ---------------- */
  .ab__side {
    padding-top: clamp(0.25rem, 1vw, 0.75rem);
  }

  @media (min-width: 880px) {
    .ab__side {
      /* A hairline down the left edge separates the rail from the prose without
         drawing a box around it. */
      padding-inline-start: clamp(1.5rem, 3vw, 2.25rem);
      border-inline-start: var(--hairline) solid var(--border-faint);
    }
  }

  .ab__side-h {
    display: block;
    margin-bottom: 1rem;
  }

  .ab__side-h--2 {
    margin-top: clamp(1.75rem, 3vw, 2.25rem);
    padding-top: clamp(1.5rem, 2.5vw, 1.75rem);
    border-top: var(--hairline) solid var(--border-faint);
  }

  /*
    The counts, set as editorial figures rather than boxes-with-numbers: three
    columns, each number large in the display face with its label small beneath.
    That is the same hierarchy the hero uses for the name and its role, which is
    what makes this read as part of the same document.
  */
  .ab__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.25rem);
    margin: 0;
  }

  .ab__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.3rem;
  }

  .ab__stat-v {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--fg-strong);
    /* Lining, tabular figures so the numerals sit on the baseline as a set. */
    font-variant-numeric: lining-nums tabular-nums;
  }

  .ab__stat-l {
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .ab__focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ab__chip {
    padding: 0.3rem 0.7rem;
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-full);
    color: var(--fg-subtle);
    text-transform: none;
    letter-spacing: 0.03em;
  }
</style>
