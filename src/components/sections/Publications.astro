---
/**
 * PUBLICATIONS
 * Treated as first-class evidence of analytical method, not an appendix.
 * Every field (venue, volume, issue, ISSN, page range, author position) comes
 * from the journal pages reproduced in the portfolio deck.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import ImageFrame from '@/components/ui/ImageFrame.astro';
import Tag from '@/components/ui/Tag.astro';
import TodoBadge from '@/components/ui/TodoBadge.astro';
import { publicationEntries } from '@/content/publications';

/** "Zuhdi, H. N." style short form for the byline, derived from the full name. */
function shortAuthor(name: string, position: number): string {
  const parts = name.trim().split(/\s+/);
  const last = parts[parts.length - 1];
  const initials = parts
    .slice(0, -1)
    .map((p) => `${p[0]}.`)
    .join(' ');
  return `${last}, ${initials}${position === 1 ? '*' : ''}`;
}
---

<Section id="publications" aria-labelledby="publications-title">
  <SectionHeader
    id="publications-title"
    eyebrow="Publications"
    title="Research & writing"
    lead="Peer-reviewed papers applying machine learning methods to real evaluation problems, plus a community-programme paper on smart farming."
    aside={`${publicationEntries.length} papers`}
  />

  <ol class="pubs">
    {
      publicationEntries.map((pub) => (
        <li class="pub">
          <div class="pub__grid">
            <div class="pub__body">
              <div class="pub__top">
                <span class="meta pub__venue">{pub.venue}</span>
                <span class="meta">
                  {pub.volume} {pub.issue} · {pub.year}
                </span>
                {pub.accreditation && (
                  <span class="pub__accred meta">{pub.accreditation}</span>
                )}
              </div>

              <h3 class="pub__title">{pub.title}</h3>
              {pub.titleId && <p class="pub__title-id">{pub.titleId}</p>}

              <p class="pub__authors">
                {pub.authors.map((a, ai) => (
                  <span
                    class:list={['pub__author', { 'pub__author--me': ai + 1 === pub.authorPosition }]}
                  >
                    {shortAuthor(a, ai + 1)}
                    {ai < pub.authors.length - 1 ? ', ' : ''}
                  </span>
                ))}
              </p>
              <p class="pub__authorpos meta">
                Author position {pub.authorPosition} of {pub.authors.length}
                {pub.authorPosition === 1 ? ' · first author' : ''}
              </p>

              {pub.abstract && <p class="pub__abstract">{pub.abstract}</p>}

              <dl class="pub__facts">
                <div>
                  <dt class="meta">Published in</dt>
                  <dd>{pub.venueFull}{pub.publisher ? ` · ${pub.publisher}` : ''}</dd>
                </div>
                {pub.pages && (
                  <div>
                    <dt class="meta">Pages</dt>
                    <dd>{pub.pages}</dd>
                  </div>
                )}
                {pub.issn && (
                  <div>
                    <dt class="meta">ISSN</dt>
                    <dd>
                      E-ISSN {pub.issn}
                      {pub.issnPrint ? ` · P-ISSN ${pub.issnPrint}` : ''}
                    </dd>
                  </div>
                )}
                {pub.metric && (
                  <div>
                    <dt class="meta">Reported result</dt>
                    <dd class="pub__metric">{pub.metric}</dd>
                  </div>
                )}
              </dl>

              {pub.keywords && pub.keywords.length > 0 && (
                <ul class="pub__kw" aria-label="Keywords">
                  {pub.keywords.map((k) => (
                    <li>
                      <Tag label={k} small />
                    </li>
                  ))}
                </ul>
              )}

              {pub.todo && <TodoBadge note={pub.todo} small />}
            </div>

            <div class="pub__media">
              <ImageFrame visual={pub.visual} />
              <p class="meta pub__media-note">
                Paper pages shown in the portfolio deck; no DOI or URL is present
                in the source.
              </p>
            </div>
          </div>
        </li>
      ))
    }
  </ol>

  <p class="pubs__note meta">
    * indicates the corresponding/first author. No DOI or publisher links are
    listed because none appear in the source documents.
  </p>
</Section>

<style>
  .pubs {
    display: grid;
    gap: clamp(1.5rem, 3.5vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pub {
    padding: clamp(1.1rem, 2.5vw, 1.6rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--surface-raised);
  }

  .pub__grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 860px) {
    .pub__grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .pub__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
  }

  .pub__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.85rem;
  }

  .pub__venue {
    color: var(--accent);
    font-weight: 600;
  }

  .pub__accred {
    padding: 0.1rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: var(--radius-full);
    background-color: var(--accent-soft);
    color: var(--accent);
    font-size: 0.62rem;
  }

  .pub__title {
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .pub__title-id {
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--subtle-foreground);
    line-height: 1.5;
  }

  .pub__authors {
    margin-top: 0.15rem;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .pub__author--me {
    color: var(--foreground);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  .pub__authorpos {
    margin-top: -0.2rem;
  }

  .pub__abstract {
    max-width: 72ch;
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--muted-foreground);
  }

  .pub__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 0.75rem 1.25rem;
    margin: 0.5rem 0 0;
    padding: 0.9rem 0 0;
    border-top: 1px solid var(--border);
  }

  .pub__facts dt {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.62rem;
  }

  .pub__facts dd {
    margin: 0.2rem 0 0;
    font-size: var(--text-sm);
  }

  .pub__metric {
    color: var(--accent);
    font-weight: 600;
    font-family: var(--font-mono);
    font-size: var(--text-xs) !important;
  }

  .pub__kw {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
  }

  .pub__media-note {
    margin-top: 0.5rem;
    line-height: 1.5;
  }

  .pubs__note {
    margin-top: 1.5rem;
    max-width: 74ch;
  }
</style>
