---
/**
 * HERO — the homepage's focal point.
 *
 * COMPOSITION
 * Not "[photo box] + [text]". The portrait is a tall panel that bleeds past the
 * top of the section, sits inside an offset hairline frame, and overlaps the
 * type column slightly on desktop — so the image reads as part of the layout
 * rather than an illustration dropped next to it.
 *
 *   1. eyebrow
 *   2. the name, set very large, surname in italic with a burgundy rule
 *   3. the positioning line
 *   4. a short lead paragraph
 *   5. two actions
 *   6. one mono meta rule (location · status)
 *
 * IDENTITY
 * The headline is the graduate positioning, NOT the employer. AirNav appears
 * only on the Experience page.
 *
 * IMAGE BUDGET: exactly ONE photograph.
 */
import { profile } from '@/data/profile';

/** Split the name so the surname can be set in italic. */
const parts = profile.name.trim().split(/\s+/);
const first = parts.slice(0, -1).join(' ');
const last = parts[parts.length - 1] ?? '';
---

<section class="hero" id="top">
  <div class="shell shell--wide hero__shell">
    <div class="hero__grid">
      <!-- ---------------- type ---------------- -->
      <div class="hero__type">
        <p class="hero__eyebrow label">Portfolio</p>

        <h1 class="hero__name">
          <span class="hero__name-line">{first}</span>
          <span class="hero__name-line hero__name-line--last"><em>{last}</em></span>
        </h1>

        <p class="hero__role">{profile.headline}</p>

        <p class="hero__fields mono">{profile.positioning.join('   ·   ')}</p>

        <p class="hero__lede">{profile.summary[0]}</p>

        <div class="hero__acts">
          <a href="/projects" class="hero__btn hero__btn--solid">
            View selected work
            <span aria-hidden="true">→</span>
          </a>
          <a href="/about" class="hero__btn hero__btn--ghost">About me</a>
        </div>
      </div>

      <!-- ---------------- portrait ---------------- -->
      <figure class="hero__figure">
        <span class="hero__frame" aria-hidden="true"></span>

        <img
          class="hero__img"
          src={profile.portrait.src}
          alt={profile.portrait.alt}
          width={profile.portrait.width}
          height={profile.portrait.height}
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>

    <!-- ---------------- meta rule ---------------- -->
    <div class="hero__meta">
      <span class="mono">{profile.location}</span>
      <span class="hero__meta-rule" aria-hidden="true"></span>
      <span class="mono">{profile.currentStatus}</span>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     HERO
     ========================================================================== */
  .hero {
    position: relative;
    /* The portrait is allowed to break the top edge, so the section clips. */
    overflow: hidden;
    padding-top: clamp(2.25rem, 5vw, 4rem);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media (min-width: 940px) {
    .hero__grid {
      /* Type leads. The portrait column is narrower and pulled upward, which
         is what creates the asymmetry. */
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.78fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: start;
    }
  }

  /* ---------------- type ---------------- */
  /*
    NO max-width on the column itself. An earlier `max-width: 20ch` here resolved
    against the body font, not the display font, and collapsed the whole column
    to ~200px — which wrapped the name into a narrow ribbon and made the hero
    twice as tall as intended. The measure is constrained per element instead
    (the h1 and the lead paragraph), which is where it actually matters.
  */
  @media (min-width: 940px) {
    .hero__type {
      padding-top: clamp(1.5rem, 4vw, 3.5rem);
      /* Sits above the portrait where they overlap. */
      position: relative;
      z-index: 2;
    }
  }

  .hero__eyebrow {
    margin-bottom: clamp(1.25rem, 2.6vw, 1.75rem);
  }

  .hero__name {
    font-family: var(--font-display);
    /* The largest type on the site. This is the hierarchy anchor; everything
       else is measured against it. */
    font-size: var(--text-display);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.032em;
    color: var(--fg-strong);
  }

  .hero__name-line {
    display: block;
  }

  /* Italic surname: an editorial contrast move that stops the name reading as
     one long grey block. */
  .hero__name-line--last em {
    font-style: italic;
    position: relative;
    padding-inline-end: 0.12em;
  }

  /* Burgundy rule running out of the surname into the whitespace. */
  .hero__name-line--last em::after {
    content: '';
    position: absolute;
    left: calc(100% + 0.3em);
    top: 0.56em;
    width: clamp(1.5rem, 7vw, 6rem);
    height: 2px;
    background-color: var(--accent);
  }

  .hero__role {
    margin-top: clamp(1.1rem, 2.4vw, 1.6rem);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--accent);
  }

  .hero__fields {
    margin-top: 0.9rem;
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.06em;
  }

  .hero__lede {
    margin-top: clamp(1.15rem, 2.4vw, 1.6rem);
    max-width: 42ch;
    color: var(--fg-muted);
  }

  .hero__acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: clamp(1.75rem, 3.2vw, 2.25rem);
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.8rem 1.35rem;
    border: var(--hairline) solid transparent;
    border-radius: var(--r-xs);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      background-color var(--t-base) var(--ease),
      border-color var(--t-base) var(--ease),
      color var(--t-base) var(--ease),
      transform var(--t-base) var(--ease);
  }

  .hero__btn--solid {
    background-color: var(--solid-bg);
    color: var(--on-solid);
  }

  .hero__btn--solid:hover {
    background-color: var(--solid-bg-hover);
    transform: translateY(-1px);
  }

  .hero__btn--ghost {
    border-color: var(--border-strong);
    color: var(--fg);
  }

  .hero__btn--ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
    background-color: var(--accent-soft);
  }

  /* ---------------- portrait ---------------- */
  .hero__figure {
    position: relative;
    margin: 0;
  }

  @media (min-width: 940px) {
    .hero__figure {
      /* Pulled up so the photograph breaks past the section's top padding and
         the composition feels cropped rather than contained. */
      margin-top: clamp(-5rem, -6vw, -2rem);
    }
  }

  /* Offset hairline frame — up and to the left of the photograph. */
  .hero__frame {
    position: absolute;
    inset: -0.85rem 0.85rem auto -0.85rem;
    height: 52%;
    border-top: 1px solid var(--accent-line);
    border-left: 1px solid var(--accent-line);
    pointer-events: none;
  }

  .hero__img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    /* Native portrait ratio — nothing cropped. */
    object-fit: cover;
    border-radius: var(--r-xs);
    /*
      Theme-aware photograph treatment.

      IMPORTANT, and it is not what it looks like: the source file is NOT a
      photograph on a black backdrop. It is RGBA with the backdrop TRANSPARENT —
      about 40% of the pixels have zero alpha, and the corner samples read
      rgba(0,0,0,0), not black.

      That matters, because a transparent backdrop is not a fixed colour: it
      shows whatever is behind it. On the dark theme the page showed through and
      it happened to read as a studio black; on paper the SAME FILE showed the
      ivory page through it and the portrait turned into a light-backdrop shot.
      The tone was following the page by accident, not by design.

      So the matte is painted as the image's OWN background instead of a plate
      behind it. Because the backdrop is transparent, that colour shows through
      exactly where the "backdrop" is, and the photograph now sits on a matte
      chosen per theme — a lifted charcoal on dark, a deep warm tone on light —
      with the tint coming from the tokens rather than from whatever happens to
      be underneath.
    */
    background-color: var(--photo-mat);
    border: var(--hairline) solid var(--photo-edge);
    box-shadow: var(--photo-shadow);
    filter: var(--photo-filter);
  }

  /* ---------------- meta rule ---------------- */
  .hero__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.1rem;
    border-top: var(--hairline) solid var(--border);
  }

  .hero__meta-rule {
    flex: 1;
    height: 1px;
    background-color: var(--border-faint);
  }

  /* ---------------- mobile ---------------- */
  @media (max-width: 939px) {
    /* Portrait first, and capped hard — a 2:3 photograph at full width would be
       ~530px tall and push the name off the first screen. */
    .hero__figure {
      order: -1;
      max-width: 14rem;
    }

    /* The offset frame reads as a stray line at this size. */
    .hero__frame {
      display: none;
    }

    .hero__name-line--last em::after {
      width: clamp(1.25rem, 12vw, 3.5rem);
    }

    .hero__lede {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .hero__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
    }

    .hero__meta-rule {
      display: none;
    }
  }
</style>
