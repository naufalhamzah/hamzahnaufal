---
/**
 * HERO — the homepage's focal point.
 *
 * COMPOSITION
 * Not "[photo box] + [text]". The portrait is a tall panel that bleeds past the
 * top of the section, sits inside an offset hairline frame, and overlaps the
 * type column slightly on desktop — so the image reads as part of the layout
 * rather than an illustration dropped next to it.
 *
 *   1. eyebrow
 *   2. the name, set very large, surname in italic with a burgundy rule
 *   3. the positioning line
 *   4. a short lead paragraph
 *   5. two actions
 *   6. one mono meta rule (location · status)
 *
 * IDENTITY
 * The headline is the graduate positioning, NOT the employer. AirNav appears
 * only on the Experience page.
 *
 * IMAGE BUDGET: exactly ONE photograph.
 */
import { profile } from '@/data/profile';

/** Split the name so the surname can be set in italic. */
const parts = profile.name.trim().split(/\s+/);
const first = parts.slice(0, -1).join(' ');
const last = parts[parts.length - 1] ?? '';
---

<section class="hero" id="top">
  <div class="shell shell--wide hero__shell">
    <div class="hero__grid">
      <!-- ---------------- type ---------------- -->
      <div class="hero__type">
        <p class="hero__eyebrow label">Portfolio</p>

        <h1 class="hero__name">
          <span class="hero__name-line">{first}</span>
          <span class="hero__name-line hero__name-line--last"><em>{last}</em></span>
        </h1>

        <p class="hero__role">{profile.headline}</p>

        <p class="hero__fields mono">{profile.positioning.join('   ·   ')}</p>

        <p class="hero__lede">{profile.summary[0]}</p>

        <div class="hero__acts">
          <a href="/projects" class="hero__btn hero__btn--solid">
            View selected work
            <span aria-hidden="true">→</span>
          </a>
          <a href="/about" class="hero__btn hero__btn--ghost">About me</a>
        </div>
      </div>

      <!-- ---------------- portrait ---------------- -->
      <figure class="hero__figure">
        <img
          class="hero__img"
          src={profile.portrait.src}
          alt={profile.portrait.alt}
          width={profile.portrait.width}
          height={profile.portrait.height}
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>

    <!-- ---------------- meta rule ---------------- -->
    <div class="hero__meta">
      <span class="mono">{profile.location}</span>
      <span class="hero__meta-rule" aria-hidden="true"></span>
      <span class="mono">{profile.currentStatus}</span>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     HERO
     ========================================================================== */
  .hero {
    position: relative;
    /* The portrait is allowed to break the top edge, so the section clips. */
    overflow: hidden;
    padding-top: clamp(2.25rem, 5vw, 4rem);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media (min-width: 940px) {
    .hero__grid {
      /*
        Type still leads, but the portrait is now close to parity (0.95fr against
        1fr, where it used to be 0.78fr against 1.1fr).

        Why: at 0.78fr the portrait rendered 521px wide on a 1440px viewport, and
        the user's note was that it should look "more real". Size is the main
        reason a cut-out reads as pasted: too small and the eye treats it as a
        graphic in a box rather than a person in the page. At 0.95fr the figure
        is roughly a third larger, the face reaches a usable size, and the
        stacked drop-shadows have enough silhouette to be legible.

        The asymmetry survives — the type column is still the wider one and the
        image still sits below the headline's optical line.
      */
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: start;
    }
  }

  /* ---------------- type ---------------- */
  /*
    NO max-width on the column itself. An earlier `max-width: 20ch` here resolved
    against the body font, not the display font, and collapsed the whole column
    to ~200px — which wrapped the name into a narrow ribbon and made the hero
    twice as tall as intended. The measure is constrained per element instead
    (the h1 and the lead paragraph), which is where it actually matters.
  */
  @media (min-width: 940px) {
    .hero__type {
      padding-top: clamp(1.5rem, 4vw, 3.5rem);
      /* Sits above the portrait where they overlap. */
      position: relative;
      z-index: 2;
    }
  }

  .hero__eyebrow {
    margin-bottom: clamp(1.25rem, 2.6vw, 1.75rem);
  }

  .hero__name {
    font-family: var(--font-display);
    /* The largest type on the site. This is the hierarchy anchor; everything
       else is measured against it. */
    font-size: var(--text-display);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.032em;
    color: var(--fg-strong);
  }

  .hero__name-line {
    display: block;
  }

  /* Italic surname: an editorial contrast move that stops the name reading as
     one long grey block. */
  .hero__name-line--last em {
    font-style: italic;
    position: relative;
    padding-inline-end: 0.12em;
  }

  /* Burgundy rule running out of the surname into the whitespace. */
  .hero__name-line--last em::after {
    content: '';
    position: absolute;
    left: calc(100% + 0.3em);
    top: 0.56em;
    width: clamp(1.5rem, 7vw, 6rem);
    height: 2px;
    background-color: var(--accent);
  }

  .hero__role {
    margin-top: clamp(1.1rem, 2.4vw, 1.6rem);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--accent);
  }

  .hero__fields {
    margin-top: 0.9rem;
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.06em;
  }

  .hero__lede {
    margin-top: clamp(1.15rem, 2.4vw, 1.6rem);
    max-width: 42ch;
    color: var(--fg-muted);
  }

  .hero__acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: clamp(1.75rem, 3.2vw, 2.25rem);
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.8rem 1.35rem;
    border: var(--hairline) solid transparent;
    border-radius: var(--r-xs);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      background-color var(--t-base) var(--ease),
      border-color var(--t-base) var(--ease),
      color var(--t-base) var(--ease),
      transform var(--t-base) var(--ease);
  }

  .hero__btn--solid {
    background-color: var(--solid-bg);
    color: var(--on-solid);
  }

  .hero__btn--solid:hover {
    background-color: var(--solid-bg-hover);
    transform: translateY(-1px);
  }

  .hero__btn--ghost {
    border-color: var(--border-strong);
    color: var(--fg);
  }

  .hero__btn--ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
    background-color: var(--accent-soft);
  }

  /* ---------------- portrait ---------------- */
  /*
    THE PORTRAIT IS A CUT-OUT.

    This is the single most important fact about this figure, and the design
    depends on it. The source has no backdrop at all — the background was removed
    and ~40% of the pixels are fully transparent. The subject's silhouette is the
    only thing in the file.

    An earlier version ignored that and treated it like a rectangular photograph:
    a filled plate, a 1px border and rounded corners on the <img>. On a cut-out
    those draw a visible RECTANGLE around a person who has no rectangle — which
    is exactly what makes it read as "pasted on". A box-shadow made it worse: it
    casts a rectangle, so the eye sees a card, not a person.

    So there is NO border, NO frame and NO radius anywhere on this figure.
    Instead:
      · `drop-shadow` — which follows the ALPHA SILHOUETTE, so the shadow the
        subject casts is their own shape (shoulders, arm, sash). This is what
        seats them in the page instead of pasting them on it.
      · a soft radial pool behind the figure, so the subject emerges from a lift
        in the background rather than starting at a hard edge.
      · a FADE-OUT at the bottom (see mask-image below) so the cut does not end
        in a hard horizontal edge.
  */
  .hero__figure {
    position: relative;
    margin: 0;
    isolation: isolate;
  }

  /* The pool: a soft elliptical lift in the background, sized to the figure and
     sitting BEHIND it. It has no edge to see, so the subject appears lit from
     within the page rather than placed on top of it.

     Two failure modes to avoid, both seen in earlier attempts:
       · too STRONG at the centre (the full matte colour) showed up as a visible
         beige ellipse floating behind the subject — a shape, not a lift;
       · too WEAK left the figure looking pasted onto a flat page.
     The falloff is therefore narrow and quick: a modest lift close to the
     subject that reaches fully transparent well before the edge, so there is no
     boundary anywhere for the eye to catch. */
    @media (min-width: 940px) {
    .hero__figure {
      /* Pulled up so the cut-out breaks past the section's top padding and the
         composition feels cropped rather than contained. */
      margin-top: clamp(-5rem, -6vw, -2rem);
    }
  }

  .hero__img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    /*
      NO OUTLINE ON THE IMAGE.

      The page's global `:focus-visible` rule draws a 3px accent outline, and the
      hero <img> receives focus on load — so a rectangle was drawn around a
      cut-out that has no rectangle. The user reported it as a "border" on the
      photo, which is exactly what it was.

      Suppressed deliberately: an image is not an interactive control, so a focus
      ring on it signals an affordance that does not exist. Nothing is lost for
      keyboard users — there is no action to reach here.
    */
    /*
      `!important` is load-bearing here, not laziness. The global `:focus-visible`
      rule sets BOTH `outline` and `outline-offset`, and a plain `outline: none`
      does not neutralise the offset — the browser then draws the ring from a
      stale offset on some engines. These three declarations together are what
      actually remove the rectangle.
    */
    outline: none !important;
    outline-offset: 0 !important;
    /*
      `drop-shadow`, NOT `box-shadow`.

      box-shadow draws around the element's BOX, so on a cut-out it paints a
      rectangle behind a person who has none — the "sticker" look. drop-shadow
      is applied to the rendered ALPHA, so the shadow traces the actual
      silhouette. Two stacked shadows: a tight one to seat the subject against
      the page, and a wide soft one for depth.
    */
    /*
      THREE stacked drop-shadows, which is what makes a cut-out read as a real
      person standing in the page rather than a flat sticker:

        1. a tight contact shadow — seats the figure, the way a hard light source
           would
        2. a mid shadow — gives the body a sense of separation from the surface
        3. a wide, very soft one — the ambient falloff, which is the part the eye
           reads as "occupying space"

      All three follow the ALPHA silhouette, so the shadow is the shape of the
      person (shoulders, arm, the sash's edge) and not a rectangle. One shadow
      alone reads as a graphic cut-out; the stack is what makes it photographic.
    */
    filter: var(--photo-filter) drop-shadow(
        0 1px 2px rgba(0, 0, 0, 0.45)
      ) drop-shadow(0 4px 10px rgba(0, 0, 0, 0.28))
      drop-shadow(0 14px 28px rgba(0, 0, 0, 0.26))
      drop-shadow(0 34px 60px rgba(0, 0, 0, 0.30));
    /*
      THE BOTTOM FADE — this is what removes the "patahan".

      The crop has to end somewhere, and a cut-out ending on a straight
      horizontal line looks like a torn photograph: the eye reads the edge as a
      FRACTURE because the figure simply stops mid-torso against the page.

      A mask that goes to fully transparent over the last fifth dissolves that
      edge. The subject now fades out into the page instead of being sliced, so
      there is no line to see — the portrait ends the way a vignette ends, not
      the way a cut ends.

      Order matters: filtering happens before masking, so drop-shadow is
      computed from the full silhouette and then faded along with it. The shadow
      therefore fades too, and no shadow edge is left floating below the figure.
    */
    /*
      A LONG, even fade — the earlier curve dropped from solid to 0.2 in the last
      fifth, which is a visible gradient band rather than a dissolve. Spreading
      it over the last third with a smooth ramp makes the figure recede instead of
      being wiped, so there is no line where the crop ends.
    */
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 66%,
      rgba(0, 0, 0, 0.86) 76%,
      rgba(0, 0, 0, 0.52) 87%,
      rgba(0, 0, 0, 0.18) 95%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 66%,
      rgba(0, 0, 0, 0.86) 76%,
      rgba(0, 0, 0, 0.52) 87%,
      rgba(0, 0, 0, 0.18) 95%,
      transparent 100%
    );
  }

  /* On paper the shadows have to be softer and warmer — a hard black drop on
     ivory reads as dirt rather than depth. */
  :global([data-theme='light']) .hero__img {
    filter: var(--photo-filter) drop-shadow(
        0 1px 2px rgba(62, 46, 30, 0.24)
      ) drop-shadow(0 4px 10px rgba(62, 46, 30, 0.15))
      drop-shadow(0 14px 26px rgba(62, 46, 30, 0.14))
      drop-shadow(0 32px 56px rgba(62, 46, 30, 0.18));
  }

  /* ---------------- meta rule ---------------- */
  .hero__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.1rem;
    border-top: var(--hairline) solid var(--border);
  }

  .hero__meta-rule {
    flex: 1;
    height: 1px;
    background-color: var(--border-faint);
  }

  /* ---------------- mobile ---------------- */
  @media (max-width: 939px) {
    /*
      Portrait first, and capped hard.

      The cap matters more now than it did with a rectangular photo: this is a
      CUT-OUT, so at full width a 3:4 figure would be ~530px of free-floating
      person with nothing containing it. Capping the column keeps it a portrait
      inset the eye reads as an introduction, not a full-bleed poster.
    */
    .hero__figure {
      order: -1;
      max-width: 13rem;
    }

    /* The pool scales with the figure; slightly tighter so it does not halo. */
    .hero__name-line--last em::after {
      width: clamp(1.25rem, 12vw, 3.5rem);
    }

    .hero__lede {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .hero__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
    }

    .hero__meta-rule {
      display: none;
    }
  }
</style>
