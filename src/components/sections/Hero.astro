---
/**
 * HERO
 * Asymmetric two-column layout: identity and CTAs on the left, a portrait slot
 * plus a small "at a glance" data panel on the right. Deliberately not the
 * centred-avatar-and-three-cards template.
 */
import Button from '@/components/ui/Button.astro';
import { profile } from '@/content/profile';
import { featuredProjects } from '@/content/projects';
import { experienceSorted } from '@/content/experience';

// CV download: there is no CV file yet, so the button renders in a clearly
// disabled state and is trivially activated later — see the TODO below.
const CV_AVAILABLE = false;
const CV_HREF = '/hamzah-naufal-zuhdi-cv.pdf';

const currentRole = experienceSorted.find((e) => e.current);
---

<section class="hero grid-texture" aria-labelledby="hero-title">
  <div class="container-page hero__grid">
    <!-- ---------------- Left: identity ---------------- -->
    <div class="hero__main">
      <p class="eyebrow">Portfolio</p>

      <h1 id="hero-title" class="hero__title">{profile.name}</h1>

      <p class="hero__headline">{profile.headline}</p>

      <ul class="hero__positioning">
        {
          profile.positioning.map((line) => (
            <li class="meta">{line}</li>
          ))
        }
      </ul>

      <p class="hero__status">
        <span class="hero__status-dot" aria-hidden="true"></span>
        <span class="meta">{profile.currentStatus}</span>
      </p>

      <p class="hero__summary">{profile.summary[0]}</p>

      <div class="hero__ctas">
        <Button href="#featured-work" variant="primary" arrow>View work</Button>
        <Button href="#contact">Contact me</Button>

        {
          CV_AVAILABLE ? (
            <Button href={CV_HREF} external>
              Download CV
            </Button>
          ) : (
            /* TODO: drop a PDF at public/hamzah-naufal-zuhdi-cv.pdf and set
               CV_AVAILABLE = true above to activate this button. */
            <Button disabled data-testid="cv-disabled">
              Download CV (soon)
            </Button>
          )
        }
      </div>

      <ul class="hero__focus" aria-label="Areas of focus">
        {
          profile.focusAreas.map((area) => (
            <li>{area}</li>
          ))
        }
      </ul>
    </div>

    <!-- ---------------- Right: portrait + facts ---------------- -->
    <aside class="hero__aside" aria-label="At a glance">
      <figure class="hero__portrait">
        <img
          src="/images/placeholders/portrait.svg"
          alt="Placeholder for a professional photograph of Hamzah Naufal Zuhdi"
          width="800"
          height="1067"
          loading="eager"
          decoding="async"
        />
        <figcaption class="hero__portrait-badge meta">
          <span class="hero__portrait-dot" aria-hidden="true"></span>
          Photo placeholder
        </figcaption>
      </figure>

      <dl class="hero__facts">
        <div>
          <dt class="meta">Current role</dt>
          <dd>{currentRole?.role ?? profile.currentRole}</dd>
        </div>
        <div>
          <dt class="meta">Location</dt>
          <dd>{profile.location}</dd>
        </div>
        <div>
          <dt class="meta">Focus</dt>
          <dd>Data · Systems · Business Process</dd>
        </div>
        <div>
          <dt class="meta">Featured projects</dt>
          <dd>{featuredProjects.length} case studies</dd>
        </div>
      </dl>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6rem) clamp(3rem, 7vw, 5rem);
    border-bottom: 1px solid var(--border);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.65fr) minmax(260px, 0.85fr);
    }
  }

  .hero__main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .hero__title {
    font-size: var(--text-5xl);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.038em;
  }

  .hero__headline {
    font-size: var(--text-xl);
    color: var(--foreground);
    max-width: 40ch;
    font-weight: 500;
  }

  .hero__positioning {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__positioning li {
    position: relative;
    padding-inline-start: 1.05rem;
  }

  .hero__positioning li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.58em;
    width: 0.42rem;
    height: 1px;
    background-color: var(--accent);
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    padding: 0.32rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    width: fit-content;
    background-color: var(--surface-raised);
  }

  .hero__status-dot {
    position: relative;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: var(--radius-full);
    background-color: var(--accent);
  }

  /* Soft pulse to signal "currently active" — suppressed for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__status-dot::after {
      content: '';
      position: absolute;
      inset: -4px;
      border-radius: var(--radius-full);
      border: 1px solid var(--accent);
      opacity: 0;
      animation: pulse 2.6s var(--ease-out-soft) infinite;
    }
  }

  @keyframes pulse {
    0% {
      opacity: 0.55;
      transform: scale(0.7);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(1.9);
    }
  }

  .hero__summary {
    max-width: 58ch;
    color: var(--muted-foreground);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  .hero__focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__focus li {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--subtle-foreground);
    background-color: var(--surface-raised);
  }

  .hero__aside {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero__portrait {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    aspect-ratio: 3 / 4;
    background-color: var(--surface-sunken);
  }

  .hero__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__portrait-badge {
    position: absolute;
    bottom: 0.6rem;
    left: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.22rem 0.55rem;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-sm);
    background-color: color-mix(in srgb, var(--surface) 88%, transparent);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero__portrait-dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: var(--radius-full);
    background-color: var(--subtle-foreground);
  }

  .hero__facts {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--surface-raised);
  }

  .hero__facts dt {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero__facts dd {
    margin: 0.15rem 0 0;
    font-size: var(--text-sm);
  }

  .hero__facts > div + div {
    padding-top: 0.85rem;
    border-top: 1px solid var(--border);
  }
</style>
