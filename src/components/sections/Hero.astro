---
/**
 * HERO — the homepage's opening statement.
 *
 * DESIGN INTENT
 * The brief asks for an editorial composition rather than the common
 * "[square photo] + [text]" block. So this is built as an asymmetric spread:
 *
 *   · an oversized serif name on two lines, the surname in italics with a
 *     burgundy rule running out of it into the page
 *   · the portrait as a tall layered panel offset from the type — not boxed
 *     beside it — with a thin accent frame echoing its top-left corner
 *   · a mono meta row and hairline rules, which is what makes the block read
 *     as designed rather than templated
 *   · a jump row linking into the homepage previews below
 *
 * IDENTITY
 * The headline is "Information Systems Graduate" — deliberately NOT the
 * current employer. AirNav appears only on the Experience page.
 *
 * IMAGE BUDGET: exactly ONE photograph here, per the brief.
 */
import { profile } from '@/data/profile';
import { homeSections } from '@/utils/navigation';

/** Split the name so the surname can be set in italic. */
const parts = profile.name.trim().split(/\s+/);
const first = parts.slice(0, -1).join(' ');
const last = parts[parts.length - 1] ?? '';
---

<section class="hero" id="top">
  <div class="shell hero__shell">
    <div class="hero__grid">
      <!-- ---------------- left: type ---------------- -->
      <div class="hero__type">
        <p class="hero__eyebrow label">
          <span class="hero__dot" aria-hidden="true"></span>
          Portfolio
        </p>

        <h1 class="hero__name">
          <span class="hero__name-line">{first}</span>
          <span class="hero__name-line hero__name-line--last"><em>{last}</em></span>
        </h1>

        <p class="hero__role">{profile.headline}</p>

        <ul class="hero__positioning" aria-label="Focus areas">
          {profile.positioning.map((p) => <li class="hero__pill mono">{p}</li>)}
        </ul>

        <p class="hero__lede">{profile.summary[0]}</p>

        <div class="hero__acts">
          <a href="/projects" class="hero__btn hero__btn--solid">
            View selected work
            <span aria-hidden="true">→</span>
          </a>
          <a href="/about" class="hero__btn hero__btn--ghost">About me</a>
        </div>
      </div>

      <!-- ---------------- right: portrait ---------------- -->
      <figure class="hero__figure">
        <span class="hero__frame" aria-hidden="true"></span>

        <img
          class="hero__img"
          src={profile.portrait.src}
          alt={profile.portrait.alt}
          width={profile.portrait.width}
          height={profile.portrait.height}
          fetchpriority="high"
          decoding="async"
        />

        <figcaption class="hero__cap">
          <span class="mono">{profile.location}</span>
          <span class="hero__cap-rule" aria-hidden="true"></span>
          <span class="mono hero__cap-status">{profile.currentStatus}</span>
        </figcaption>
      </figure>
    </div>

    <!-- ---------------- jump row ---------------- -->
    <nav class="hero__jump" aria-label="Sections on this page">
      <span class="mono hero__jump-label">On this page</span>
      <ul class="hero__jump-list">
        {
          homeSections.map((s) => (
            <li>
              <a href={`#${s.id}`} class="hero__jump-link mono">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    overflow: hidden;
  }

  /* The hero needs more horizontal room than the default shell, so the
     composition can push the portrait toward the right edge. */
  .hero__shell {
    max-width: 1440px;
  }

  .hero__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    grid-template-columns: 1fr;
    align-items: center;
  }

  /* From 900px the type and the portrait share a row, the portrait weighted a
     little narrower so the name remains the dominant element. */
  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: clamp(2rem, 5vw, 4.5rem);
      align-items: start;
    }
  }

  /* ---------------- type ---------------- */
  .hero__type {
    max-width: 34ch;
  }

  @media (min-width: 900px) {
    .hero__type {
      padding-top: clamp(1rem, 3vw, 2.5rem);
    }
  }

  .hero__eyebrow {
    margin-bottom: clamp(1.1rem, 2.5vw, 1.6rem);
  }

  .hero__eyebrow::before {
    display: none;
  }

  .hero__dot {
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    margin-inline-end: 0.5rem;
    border-radius: var(--r-full);
    background-color: var(--accent);
    vertical-align: middle;
  }

  .hero__name {
    font-family: var(--font-display);
    /* The largest type on the site — this is the hierarchy anchor. */
    font-size: clamp(2.6rem, 1rem + 7.4vw, 6.2rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--fg-strong);
  }

  .hero__name-line {
    display: block;
  }

  /* The surname is italic: an editorial contrast move that stops the two words
     reading as one long grey block. */
  .hero__name-line--last em {
    font-style: italic;
    position: relative;
    padding-inline-end: 0.15em;
  }

  /* Burgundy rule running out from the surname into the page. */
  .hero__name-line--last em::after {
    content: '';
    position: absolute;
    left: calc(100% + 0.28em);
    top: 0.58em;
    width: clamp(2rem, 9vw, 8rem);
    height: 2px;
    background-color: var(--accent);
  }

  .hero__role {
    margin-top: clamp(1.1rem, 2.4vw, 1.6rem);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--accent);
    letter-spacing: -0.005em;
  }

  .hero__positioning {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin: clamp(0.9rem, 2vw, 1.3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__pill {
    padding: 0.28rem 0.6rem;
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-full);
    color: var(--fg-muted);
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .hero__lede {
    margin-top: clamp(1.1rem, 2.4vw, 1.6rem);
    max-width: 46ch;
    font-size: var(--text-base);
    color: var(--fg-muted);
  }

  .hero__acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: clamp(1.5rem, 3vw, 2.1rem);
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.78rem 1.3rem;
    border: var(--hairline) solid transparent;
    border-radius: var(--r-xs);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      background-color var(--t-base) var(--ease),
      border-color var(--t-base) var(--ease),
      color var(--t-base) var(--ease),
      transform var(--t-base) var(--ease);
  }

  .hero__btn--solid {
    background-color: var(--solid-bg);
    color: var(--on-solid);
  }

  .hero__btn--solid:hover {
    background-color: var(--solid-bg-hover);
    transform: translateY(-1px);
  }

  .hero__btn--ghost {
    border-color: var(--border-strong);
    color: var(--fg);
  }

  .hero__btn--ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
    background-color: var(--accent-soft);
  }

  /* ---------------- portrait ---------------- */
  .hero__figure {
    position: relative;
    margin: 0;
  }

  /* Offset hairline frame: sits up and to the left of the photograph, which is
     what gives the composition its layered feel. */
  .hero__frame {
    position: absolute;
    inset: -0.75rem 0.75rem auto -0.75rem;
    height: 55%;
    border-top: 1px solid var(--accent-line);
    border-left: 1px solid var(--accent-line);
    pointer-events: none;
  }

  .hero__img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    /* Native portrait ratio — nothing cropped. */
    object-fit: cover;
    border-radius: var(--r-xs);
    /* A deep shadow lifts the photo off the background without a card wrapper. */
    box-shadow: var(--shadow-lg);
    filter: saturate(0.96) contrast(1.02);
  }

  .hero__cap {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 0.9rem;
  }

  .hero__cap-rule {
    flex: 1;
    height: 1px;
    background-color: var(--border);
  }

  .hero__cap-status {
    color: var(--fg-faint);
  }

  /* ---------------- jump row ---------------- */
  .hero__jump {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 1.1rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.1rem;
    border-top: var(--hairline) solid var(--border);
  }

  .hero__jump-label {
    color: var(--fg-faint);
    flex: none;
  }

  .hero__jump-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__jump-link {
    color: var(--fg-muted);
    text-transform: none;
    letter-spacing: 0.03em;
    transition: color var(--t-fast) var(--ease);
  }

  .hero__jump-link:hover {
    color: var(--accent);
  }

  /* ---------------- mobile ---------------- */
  @media (max-width: 899px) {
    /* Portrait leads on narrow screens: the face first, then the type. */
    .hero__figure {
      order: -1;
      /* Deliberately small. A 2:3 portrait at full width would be ~530px tall
         and push the name off the first screen, so it is capped hard. */
      max-width: 15rem;
    }

    /* The offset accent frame reads as a stray line at this size. */
    .hero__frame {
      display: none;
    }

    .hero__type {
      max-width: none;
    }

    .hero__name-line--last em::after {
      width: clamp(1.5rem, 14vw, 4rem);
    }

    /* Stack the caption so neither item wraps mid-phrase. */
    .hero__cap {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
    }

    .hero__cap-rule {
      display: none;
    }

    .hero__cap-status {
      order: -1;
    }
  }
</style>
