---
/**
 * CERTIFICATIONS
 * A gallery of the 10 documented credentials. Each card carries issuer, title,
 * date and credential ID where the source states them, plus a placeholder scan
 * slot that can later become a lightbox target.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import ImageFrame from '@/components/ui/ImageFrame.astro';
import TodoBadge from '@/components/ui/TodoBadge.astro';
import { certificationsSorted } from '@/content/certifications';

// Group by issuer so the gallery reads as a structured record, not a pile.
const byIssuer = certificationsSorted.reduce<Record<string, typeof certificationsSorted>>(
  (acc, cert) => {
    (acc[cert.issuer] ??= []).push(cert);
    return acc;
  },
  {},
);

const issuers = Object.keys(byIssuer);
---

<Section id="certifications" aria-labelledby="certifications-title">
  <SectionHeader
    id="certifications-title"
    eyebrow="Certifications"
    title="Credentials & training"
    lead="Certifications in data analytics, programming, networking and design — with issuers, dates and credential IDs where the source documents record them."
    aside={`${certificationsSorted.length} certificates`}
  />

  <div class="certs">
    {
      issuers.map((issuer) => (
        <section class="certs__group" aria-labelledby={`iss-${issuer.replace(/[^a-z]/gi, '-')}`}>
          <div class="certs__group-head">
            <h3 id={`iss-${issuer.replace(/[^a-z]/gi, '-')}`} class="certs__issuer">
              {issuer}
            </h3>
            <span class="meta">
              {byIssuer[issuer].length}{' '}
              {byIssuer[issuer].length === 1 ? 'certificate' : 'certificates'}
            </span>
          </div>

          <ul class="certs__list">
            {byIssuer[issuer].map((cert) => (
              <li class="cert">
                <div class="cert__media">
                  <ImageFrame visual={cert.visual} />
                </div>

                <div class="cert__body">
                  <h4 class="cert__title">{cert.title}</h4>
                  {cert.path && <p class="meta cert__path">{cert.path}</p>}

                  <dl class="cert__facts">
                    {cert.date && (
                      <div>
                        <dt class="meta">Issued</dt>
                        <dd>{cert.date}</dd>
                      </div>
                    )}
                    {cert.credentialId && (
                      <div>
                        <dt class="meta">Credential ID</dt>
                        <dd class="cert__id">{cert.credentialId}</dd>
                      </div>
                    )}
                  </dl>

                  {cert.todo && <TodoBadge note={cert.todo} small />}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <p class="certs__note meta">
    Certificate scans are placeholders. Drop real images into
    <code>/public/images/certifications/</code> and update the paths in
    <code>src/content/certifications.ts</code> — the layout stays the same.
  </p>
</Section>

<style>
  .certs {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.75rem);
  }

  .certs__group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }

  .certs__issuer {
    font-size: var(--text-lg);
    letter-spacing: -0.015em;
  }

  .certs__list {
    display: grid;
    gap: 1rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }

  @media (min-width: 700px) {
    .certs__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1150px) {
    .certs__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .cert {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--surface-raised);
    transition:
      border-color var(--duration-base) var(--ease-out-soft),
      transform var(--duration-base) var(--ease-out-soft);
  }

  .cert:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .cert__media {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .cert__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cert__title {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.008em;
  }

  .cert__path {
    line-height: 1.45;
  }

  .cert__facts {
    display: grid;
    gap: 0.5rem;
    margin: 0.35rem 0 0;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border);
  }

  .cert__facts dt {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.6rem;
  }

  .cert__facts dd {
    margin: 0.15rem 0 0;
    font-size: var(--text-xs);
  }

  .cert__id {
    font-family: var(--font-mono);
    word-break: break-all;
    color: var(--subtle-foreground);
  }

  .certs__note {
    margin-top: 1.5rem;
    max-width: 74ch;
    line-height: 1.6;
  }

  .certs__note code {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.1rem 0.3rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background-color: var(--surface-raised);
  }
</style>
