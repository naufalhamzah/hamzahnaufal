---
/**
 * PREVIEW: CREDENTIALS
 *
 * Combines three things the brief lists separately — certifications,
 * publications and achievements — because on the homepage they serve one
 * purpose: proof of work. Each block is a compact list with its own CTA.
 *
 * COUNTS ARE DERIVED, NEVER HARDCODED. `certificationsSorted.length` and
 * friends come straight from the data, so adding a certificate updates the
 * figure automatically. The brief explicitly warns against hardcoded numbers.
 *
 * IMAGE BUDGET: two certificate previews only, as requested.
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import CTALink from '@/components/ui/CTALink.astro';
import { certificationsSorted, certificationTotal, credentialCount } from '@/data/certifications';
import { publicationsSorted } from '@/data/publications';
import { achievementEntries } from '@/data/achievements';

/** The two most recent credential scans, as visual proof. */
const previews = certificationsSorted
  .filter((c) => c.kind === 'credential')
  .slice(0, 2);

const papers = publicationsSorted.slice(0, 3);
const awards = achievementEntries.slice(0, 3);
---

<section class="cp" id="credentials-preview">
  <div class="shell">
    <SectionHead
      index="05"
      eyebrow="Credentials"
      title="Certificates, research and awards"
      lede="Course credentials in data science and programming, peer-reviewed papers, and a funded research programme."
      href="/certifications"
      linkLabel="View all credentials"
      note={`${credentialCount} credentials · ${certificationTotal} total`}
    />

    <div class="cp__grid">
      <!-- ---------------- certifications ---------------- -->
      <div class="cp__col">
        <h3 class="cp__h mono">Certifications</h3>

        {
          previews.length > 0 && (
            <div class="cp__certs" data-lightbox-group>
              {previews.map((c) => (
                <button
                  type="button"
                  class="cp__thumb"
                  data-lightbox-src={c.visual.src}
                  data-lightbox-alt={c.visual.alt}
                  data-lightbox-caption={c.visual.alt}
                  aria-label={`View certificate: ${c.title}`}
                >
                  <img
                    src={c.visual.src}
                    alt={c.visual.alt}
                    width={c.visual.width}
                    height={c.visual.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="cp__thumb-label">
                    <span class="cp__thumb-issuer mono">{c.issuer}</span>
                    <span class="cp__thumb-title">{c.title}</span>
                  </span>
                </button>
              ))}
            </div>
          )
        }

        <CTALink
          href="/certifications"
          label="All certifications"
          note={`${certificationTotal}`}
        />
      </div>

      <!-- ---------------- publications ---------------- -->
      <div class="cp__col">
        <h3 class="cp__h mono">Publications</h3>

        <ol class="cp__list">
          {
            papers.map((p) => (
              <li class="cp__item">
                <a href="/publications" class="cp__row">
                  <span class="cp__item-year mono">{p.year}</span>
                  <span class="cp__item-body">
                    <span class="cp__item-title">{p.title}</span>
                    <span class="cp__item-meta mono">
                      {p.venue}
                      {p.authorPosition === 1 && ' · first author'}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>

        <CTALink href="/publications" label="All publications" note={`${publicationsSorted.length}`} />
      </div>

      <!-- ---------------- achievements ---------------- -->
      <div class="cp__col">
        <h3 class="cp__h mono">Achievements</h3>

        <ol class="cp__list">
          {
            awards.map((a) => (
              <li class="cp__item">
                <div class="cp__row">
                  <span class="cp__item-year mono">{a.year}</span>
                  <span class="cp__item-body">
                    <span class="cp__item-title">{a.title}</span>
                    {a.context && <span class="cp__item-meta mono">{a.context}</span>}
                  </span>
                </div>
              </li>
            ))
          }
        </ol>

        <CTALink href="/certifications#achievements" label="All achievements" />
      </div>
    </div>
  </div>
</section>

<style>
  .cp {
    padding-block: var(--section-y);
    background-color: color-mix(in srgb, var(--surface) 55%, transparent);
    border-block: var(--hairline) solid var(--border-faint);
  }

  .cp__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 900px) {
    .cp__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .cp__col {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    min-width: 0;
  }

  .cp__h {
    padding-bottom: 0.7rem;
    border-bottom: var(--hairline) solid var(--border);
    color: var(--fg-muted);
  }

  /* ---------------- certificate thumbs ---------------- */
  .cp__certs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .cp__thumb {
    position: relative;
    display: block;
    overflow: hidden;
    padding: 0;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-xs);
    background-color: var(--surface-2);
    cursor: zoom-in;
    /* Certificate scans are landscape; a fixed frame keeps the pair tidy. */
    aspect-ratio: 3 / 2;
  }

  .cp__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform var(--t-slow) var(--ease);
  }

  .cp__thumb:hover img {
    transform: scale(1.04);
  }

  .cp__thumb-label {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.4rem 0.5rem;
    background: linear-gradient(
      180deg,
      rgba(11, 9, 8, 0) 0%,
      rgba(11, 9, 8, 0.88) 100%
    );
    color: #f7f3ec;
    text-align: left;
  }

  .cp__thumb-issuer {
    color: #d8cfc2;
    font-size: 0.58rem;
  }

  .cp__thumb-title {
    font-size: 0.68rem;
    line-height: 1.25;
  }

  /* ---------------- compact lists ---------------- */
  .cp__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--hairline) solid var(--border-faint);
  }

  .cp__item {
    border-bottom: var(--hairline) solid var(--border-faint);
  }

  /*
    The grid lives on the ROW, not on the <li>. The <li> is a plain list item so
    that whether the row is an <a> (publications) or a <div> (achievements), it
    gets the full column width. Putting the grid on the <li> previously meant the
    inner <a> defaulted to a single column and the description collapsed to one
    word per line.
  */
  .cp__row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.8rem 0;
  }

  .cp__item-year {
    color: var(--fg-faint);
  }

  .cp__item-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .cp__item-title {
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--fg);
    transition: color var(--t-fast) var(--ease);
  }

  a.cp__row:hover .cp__item-title {
    color: var(--accent);
  }

  .cp__item-meta {
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.02em;
  }
</style>
