---
/**
 * PREVIEW: SELECTED WORK  (homepage's strongest section)
 *
 * THREE projects, in three DIFFERENT sizes — a wide lead spread followed by two
 * supporting cards. The brief objected to repeated identical cards, so the
 * composition varies rather than the card styling.
 *
 * No subjective ranking labels ("best", "top"). The three are chosen to show the
 * RANGE of the work — a data system, a product case study, a research project —
 * rather than three entries of the same kind. See `featuredProjects` in the data
 * layer for why the selection is explicit rather than filtered.
 *
 * IMAGE BUDGET: three project visuals, no more.
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import { featuredProjects, projectEntries } from '@/data/projects';

/** Index numbers follow the master list so they stay stable across pages. */
const numbered = featuredProjects.map((p) => ({
  project: p,
  index: projectEntries.findIndex((e) => e.id === p.id) + 1,
}));

const [lead, ...rest] = numbered;
---

<section class="fw" id="featured">
  <div class="shell">
    <SectionHead
      index="02"
      eyebrow="Selected Work"
      title="Projects I have built and researched"
      lede="A procurement monitoring dashboard, a product-design case study, and a funded smart-farming research programme — three different kinds of work."
      href="/projects"
      linkLabel="See more projects"
      note={`${projectEntries.length} total`}
      emphasis
    />

    {lead && <ProjectCard project={lead.project} index={lead.index} variant="hero" />}

    {
      rest.length > 0 && (
        <div class="fw__row">
          {rest.map((r) => (
            <ProjectCard project={r.project} index={r.index} variant="wide" />
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  /* A tinted band, not a border — how this section separates from its
     neighbours without adding another rule to the page. */
  .fw {
    background-color: var(--band);
    border-block: var(--hairline) solid var(--border-faint);
  }

  .fw__row {
    display: grid;
    gap: var(--gap);
    grid-template-columns: 1fr;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: var(--hairline) solid var(--border);
  }

  @media (min-width: 860px) {
    .fw__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(1.5rem, 3.5vw, 3rem);
    }
  }
</style>
