---
/**
 * PREVIEW: FEATURED WORK  (the homepage's ★★★★★ section)
 *
 * Shows the three featured projects with deliberately DIFFERENT card sizes, so
 * the section reads as a curated spread rather than a card grid:
 *
 *   01  a wide hero spread (visual left, text right)
 *   02  and 03 side by side, narrower
 *
 * The brief forbids subjective labels like "Best Project", so the heading is
 * "Selected Work" and the copy states only what the projects are.
 *
 * IMAGE BUDGET: three project visuals, no more.
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import { featuredProjects } from '@/data/projects';
import { projectEntries } from '@/data/projects';

/** Index numbers follow the full project list, so they stay stable. */
const numbered = featuredProjects.map((p) => ({
  project: p,
  index: projectEntries.findIndex((e) => e.id === p.id) + 1,
}));

const [lead, ...rest] = numbered;
---

<section class="fw" id="featured">
  <div class="shell">
    <SectionHead
      index="02"
      eyebrow="Selected Work"
      title="Projects I have built and researched"
      lede="Three projects that show the range: an internal data system built from scratch, a procurement monitoring dashboard, and a funded smart-farming research programme."
      href="/projects"
      linkLabel="All projects"
      note={`${projectEntries.length} total`}
      emphasis
    />

    {lead && <ProjectCard project={lead.project} index={lead.index} variant="hero" />}

    {
      rest.length > 0 && (
        <div class="fw__row">
          {rest.map((r) => (
            <ProjectCard project={r.project} index={r.index} variant="wide" />
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .fw {
    padding-block: var(--section-y);
    /* A slightly different surface separates this section from its
       neighbours — part of the hierarchy work the brief asks for. */
    background-color: color-mix(in srgb, var(--surface) 55%, transparent);
    border-block: var(--hairline) solid var(--border-faint);
  }

  /* The lead project is followed by an accent rule, which reads as a deliberate
     break between the hero spread and the pair below. */
  .fw__row {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    grid-template-columns: 1fr;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: var(--hairline) solid var(--border);
  }

  @media (min-width: 860px) {
    .fw__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
