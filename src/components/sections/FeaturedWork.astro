---
/**
 * PREVIEW: SELECTED WORK  (homepage's strongest section)
 *
 * A HORIZONTAL RAIL, not a stacked grid.
 *
 * This section used to be a vertical spread — one wide lead card followed by two
 * supporting cards — which read as "the whole portfolio, condensed" and set the
 * homepage up as a list of work rather than an invitation to open one thing. It
 * is now a carousel: one project holds the frame, the next stays half-visible at
 * the edge, and the visitor chooses how far to walk through it.
 *
 * The rail is a native scroll-snap container, so all three projects are in the
 * HTML and it works with JavaScript disabled. See `FeaturedRail.astro` for the
 * carousel itself and the reasoning behind the peek, the snap and the controls.
 *
 * No subjective ranking labels ("best", "top"). The three are chosen to show the
 * RANGE of the work — two data systems and a research programme — rather than
 * three entries of the same kind. See `featuredProjects` in the data layer for
 * why the selection is explicit rather than filtered.
 *
 * IMAGE BUDGET: three project visuals, no more.
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import FeaturedRail from '@/components/ui/FeaturedRail.astro';
import { featuredProjects, projectEntries } from '@/data/projects';
import { withBase } from '@/utils/url';

/**
 * Master-list indices, so the "01 / 02 / 03" the rail shows is the SAME number
 * the projects page gives that project — the numbering stays stable across
 * pages instead of restarting inside the carousel.
 */
const indices = featuredProjects.map(
  (p) => projectEntries.findIndex((e) => e.id === p.id) + 1,
);
---

<section class="fw" id="featured">
  <div class="shell">
    <SectionHead
      index="02"
      eyebrow="Selected Work"
      title="Projects I have built and researched"
      lede="A marketing data system built from scratch, a procurement monitoring dashboard, and a funded smart-farming research programme — three different kinds of work."
      href={withBase('/projects')}
      linkLabel="See more projects"
      note={`${projectEntries.length} total`}
      emphasis
    />

    <FeaturedRail projects={featuredProjects} indices={indices} />
  </div>
</section>

<style>
  /* A tinted band, not a border — how this section separates from its
     neighbours without adding another rule to the page. */
  .fw {
    background-color: var(--band);
    border-block: var(--hairline) solid var(--border-faint);
  }
</style>
