---
/**
 * EDUCATION
 * Two entries. No GPA and no graduation month is shown, because neither source
 * document states them — the TODO badge says so explicitly.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import TodoBadge from '@/components/ui/TodoBadge.astro';
import { educationSorted } from '@/content/education';
---

<Section id="education" aria-labelledby="education-title">
  <SectionHeader
    id="education-title"
    eyebrow="Education"
    title="Academic background"
    lead="Formal education in information systems, with a science foundation from secondary school."
  />

  <ol class="edu">
    {
      educationSorted.map((e) => (
        <li class="edu__item">
          <div class="edu__year meta">{e.dateRange}</div>

          <div class="edu__body">
            <h3 class="edu__institution">{e.institution}</h3>
            <p class="edu__degree">
              {e.degree}
              {e.field && <span class="edu__field"> · {e.field}</span>}
            </p>
            {e.location && <p class="meta edu__loc">{e.location}</p>}

            {e.highlights && e.highlights.length > 0 && (
              <ul class="edu__hl">
                {e.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}

            {e.todo && <TodoBadge note={e.todo} small />}
          </div>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .edu {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .edu__item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    padding: clamp(1.05rem, 2.5vw, 1.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--surface-raised);
  }

  @media (min-width: 700px) {
    .edu__item {
      grid-template-columns: minmax(140px, 0.32fr) minmax(0, 1fr);
      gap: 1.5rem;
      align-items: start;
    }
  }

  .edu__year {
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .edu__institution {
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }

  .edu__degree {
    margin-top: 0.3rem;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .edu__field {
    font-style: italic;
  }

  .edu__loc {
    margin-top: 0.2rem;
  }

  .edu__hl {
    display: grid;
    gap: 0.35rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    max-width: 68ch;
  }

  .edu__hl li {
    position: relative;
    padding-inline-start: 1.05rem;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--muted-foreground);
  }

  .edu__hl li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 1px;
    background-color: var(--accent);
  }
</style>
