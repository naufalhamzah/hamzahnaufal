---
/**
 * PREVIEW: EXPERIENCE  (homepage)
 *
 * A compact editorial timeline. No images at all here — the homepage's image
 * budget is spent on the hero, the selected work and nothing else, and an
 * experience preview is stronger as pure typography.
 *
 * AirNav appears as one row among four — it is experience, not identity.
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import { experienceSorted } from '@/data/experience';

/** A short preview: the four most recent roles. */
const preview = experienceSorted.slice(0, 4);
---

<section class="xp" id="experience-preview">
  <div class="shell">
    <SectionHead
      index="03"
      eyebrow="Experience"
      title="Where I have worked"
      lede="Professional roles across aviation IT, manufacturing, and beauty-industry data — plus the editorial work alongside them."
      href="/experience"
      linkLabel="View full experience"
      note={`${experienceSorted.length} roles`}
    />

    <ol class="xp__list">
      {
        preview.map((job) => (
          <li class="xp__row">
            <p class="xp__when mono">{job.dateRange.replace(' – ', '–')}</p>

            <div class="xp__body">
              <h3 class="xp__role">
                {job.role}
                {job.current && <span class="xp__now mono">Current</span>}
              </h3>
              <p class="xp__org">{job.company}</p>
            </div>

            {
              job.tools && job.tools.length > 0 && (
                <p class="xp__tools mono">{job.tools.slice(0, 2).join(' · ')}</p>
              )
            }
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .xp__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--hairline) solid var(--border);
  }

  .xp__row {
    display: grid;
    gap: 0.3rem 1.5rem;
    grid-template-columns: 1fr;
    padding: clamp(1.05rem, 2.2vw, 1.5rem) 0;
    border-bottom: var(--hairline) solid var(--border-faint);
  }

  /* Three-column rhythm: date | role | tools */
  @media (min-width: 860px) {
    .xp__row {
      grid-template-columns: minmax(0, 12rem) minmax(0, 1fr) minmax(0, 11rem);
      align-items: baseline;
    }
  }

  .xp__when {
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .xp__role {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--fg-strong);
  }

  .xp__now {
    padding: 0.15rem 0.45rem;
    border: var(--hairline) solid var(--accent-line);
    border-radius: var(--r-full);
    color: var(--accent);
    font-size: 0.6rem;
  }

  .xp__org {
    margin-top: 0.15rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .xp__tools {
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  @media (min-width: 860px) {
    .xp__tools {
      text-align: right;
    }
  }
</style>
