---
/**
 * PREVIEW: CONTACT  (homepage closing band)
 *
 * The closing call to action. A large serif line, the email as the primary
 * action, and the social links as a quiet row. No form: the site is static, so
 * a form would need a third-party service that was never approved, and a form
 * that silently drops messages is worse than no form.
 *
 * The phone number is NOT shown. Links come from `activeContactLinks`, which
 * filters disabled entries, so a hidden number cannot leak into the HTML.
 */
import { activeContactLinks } from '@/data/profile';
import { withBase } from '@/utils/url';

const email = activeContactLinks.find((l) => l.href.startsWith('mailto:'));
const socials = activeContactLinks.filter((l) => l !== email);
---

<section class="ct" id="contact-preview">
  <div class="shell">
    <div class="ct__grid">
      <div class="ct__main">
        <p class="label ct__eyebrow">05 — Contact</p>

        <h2 class="ct__title">
          Open to work in data,
          <br />
          <em>systems and process.</em>
        </h2>

        <p class="ct__lede">
          If you would like to talk about a role, a project, or a problem worth
          solving with data, email is the fastest way to reach me.
        </p>
      </div>

      <div class="ct__side">
        {
          email && (
            <a href={email.href} class="ct__mail">
              <span class="ct__mail-label mono">Email</span>
              <span class="ct__mail-addr">
                {email.href.replace('mailto:', '')}
              </span>
              <span class="ct__mail-arrow" aria-hidden="true">→</span>
            </a>
          )
        }

        <ul class="ct__socials" aria-label="Elsewhere">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  class="ct__social mono"
                  rel={s.external ? 'noopener noreferrer' : undefined}
                  target={s.external ? '_blank' : undefined}
                >
                  {s.label}
                  {s.external && <span aria-hidden="true"> ↗</span>}
                </a>
              </li>
            ))
          }
        </ul>

        <a href={withBase('/contact')} class="ct__more mono">
          Contact page <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .ct {
    padding-block: var(--space-section);
  }

  .ct__grid {
    display: grid;
    gap: clamp(2rem, 4.5vw, 4rem);
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media (min-width: 900px) {
    .ct__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }

  .ct__eyebrow {
    margin-bottom: clamp(1.1rem, 2.5vw, 1.6rem);
  }

  .ct__eyebrow::before {
    display: none;
  }

  .ct__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: 1.06;
    color: var(--fg-strong);
  }

  .ct__title em {
    font-style: italic;
    color: var(--accent);
  }

  .ct__lede {
    margin-top: clamp(1rem, 2.2vw, 1.4rem);
    max-width: 46ch;
    font-size: var(--text-lg);
    color: var(--fg-muted);
  }

  /* ---------------- the email row: the primary action ---------------- */
  .ct__mail {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-xs);
    background-color: var(--surface);
    transition:
      border-color var(--t-base) var(--ease),
      background-color var(--t-base) var(--ease);
  }

  .ct__mail:hover {
    border-color: var(--accent);
    background-color: var(--accent-soft);
  }

  .ct__mail-label {
    flex: none;
    color: var(--fg-faint);
  }

  .ct__mail-addr {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--fg-strong);
    /* Long addresses wrap rather than overflowing a narrow phone. */
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .ct__mail-arrow {
    margin-inline-start: auto;
    flex: none;
    color: var(--accent);
    transition: transform var(--t-base) var(--ease);
  }

  .ct__mail:hover .ct__mail-arrow {
    transform: translateX(4px);
  }

  /* ---------------- socials ---------------- */
  .ct__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: clamp(1.25rem, 2.5vw, 1.75rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .ct__social {
    color: var(--fg-muted);
    text-transform: none;
    letter-spacing: 0.03em;
    transition: color var(--t-fast) var(--ease);
  }

  .ct__social:hover {
    color: var(--accent);
  }

  .ct__more {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    color: var(--fg-subtle);
    text-transform: none;
    letter-spacing: 0.03em;
    transition: color var(--t-fast) var(--ease);
  }

  .ct__more:hover {
    color: var(--accent);
  }

  @media (max-width: 520px) {
    .ct__mail {
      flex-wrap: wrap;
      gap: 0.4rem 0.75rem;
    }

    .ct__mail-addr {
      font-size: var(--text-lg);
    }
  }
</style>
