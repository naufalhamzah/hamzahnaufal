---
/**
 * CONTACT
 * Final CTA. Only contact methods present in the source documents are shown.
 * The phone number is filtered out via `activeContactLinks`, so it cannot leak
 * into rendered HTML while CONTACT_PHONE_ENABLED stays false.
 */
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import { profile, activeContactLinks } from '@/content/profile';

const iconFor: Record<string, string> = {
  LinkedIn: 'in',
  Instagram: 'ig',
  Email: '@',
  Phone: 'tel',
};
---

<Section id="contact" aria-labelledby="contact-title" flush textured>
  <div class="contact">
    <div class="contact__main">
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title" class="contact__title">Let’s talk</h2>

      <p class="contact__lead">
        Open to conversations about data analytics, business intelligence,
        process improvement and digital solutions — or simply to connect.
      </p>

      <div class="contact__ctas">
        <Button href={`mailto:${profile.email}`} variant="primary" arrow>
          Email me
        </Button>
        <Button href="#featured-work">See the work</Button>
      </div>
    </div>

    <ul class="contact__links" aria-label="Contact methods">
      {
        activeContactLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="contact__link"
              rel={link.external ? 'noopener noreferrer' : undefined}
              target={link.external ? '_blank' : undefined}
            >
              <span class="contact__icon" aria-hidden="true">
                {iconFor[link.label] ?? link.label.slice(0, 2).toLowerCase()}
              </span>
              <span class="contact__label">{link.label}</span>
              <span class="contact__value meta">
                {link.href.replace(/^mailto:|^tel:/, '')}
              </span>
              <span class="contact__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="contact__tagline">“{profile.tagline}”</p>
  </div>
</Section>

<style>
  .contact {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    grid-template-columns: 1fr;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--surface-raised);
  }

  @media (min-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: center;
    }
  }

  .contact__title {
    margin-top: 0.55rem;
    font-size: var(--text-3xl);
    letter-spacing: -0.03em;
  }

  .contact__lead {
    margin-top: 0.9rem;
    max-width: 48ch;
    color: var(--muted-foreground);
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .contact__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .contact__links {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact__link {
    display: grid;
    grid-template-columns: 1.9rem auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--surface);
    transition:
      border-color var(--duration-fast) var(--ease-out-soft),
      background-color var(--duration-fast) var(--ease-out-soft);
  }

  .contact__link:hover {
    border-color: var(--accent);
    background-color: var(--accent-soft);
  }

  .contact__icon {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--accent);
    background-color: var(--surface-raised);
  }

  .contact__label {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .contact__value {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .contact__arrow {
    color: var(--subtle-foreground);
    transition: transform var(--duration-base) var(--ease-out-soft);
  }

  .contact__link:hover .contact__arrow {
    transform: translateX(3px);
    color: var(--accent);
  }

  /* Grid on narrow screens: value drops below the label. */
  @media (max-width: 520px) {
    .contact__link {
      grid-template-columns: 1.9rem 1fr auto;
    }

    .contact__value {
      grid-column: 2 / -1;
      font-size: 0.68rem;
    }
  }

  .contact__tagline {
    grid-column: 1 / -1;
    margin-top: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--subtle-foreground);
  }
</style>
