---
/**
 * PREVIEW: SKILLS
 *
 * Shows the tool logos at a size that is actually readable — the brief asked
 * for "logos large enough, not too small". Each tile is a 4rem target holding a
 * 2.4rem mark, with the name beneath.
 *
 * NO PROFICIENCY PERCENTAGES. Neither source document states any, so showing
 * "Python 90%" would be fabrication. The site lists what has been worked with,
 * grouped by area.
 *
 * Only the FIRST group of logos appears here; /skills carries all of them.
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import SkillTile from '@/components/ui/SkillTile.astro';
import { skillGroups, totalSkills } from '@/data/skills';

/** A representative slice: every group's iconed items, capped for the preview. */
const preview = skillGroups
  .flatMap((g) => g.items)
  .filter((i) => i.icon)
  .slice(0, 14);
---

<section class="sp" id="skills-preview">
  <div class="shell">
    <SectionHead
      index="04"
      eyebrow="Skills"
      title="Tools and methods I work with"
      lede="Grouped by area — analytics and visualisation, programming and databases, modelling, process work, design, and everyday tooling."
      href="/skills"
      linkLabel="Explore skills"
      note={`${totalSkills} entries`}
    />

    <ul class="sp__grid">
      {
        preview.map((item) => (
          <li>
            <SkillTile name={item.name} icon={item.icon} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sp {
    padding-block: var(--section-y);
    background-color: color-mix(in srgb, var(--surface) 55%, transparent);
    border-block: var(--hairline) solid var(--border-faint);
  }

  .sp__grid {
    display: grid;
    gap: clamp(0.6rem, 1.4vw, 1rem);
    margin: 0;
    padding: 0;
    list-style: none;
    /* auto-fill keeps tiles the right size at every width with no media query */
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
  }
</style>
