---
/**
 * PREVIEW: SKILLS  (homepage)
 *
 * A curated set of tool marks — NOT the full inventory. The brief asked for
 * selected skills on the homepage and the complete list on /skills.
 *
 * The selection is explicit rather than "the first N": these are the tools the
 * source material ties to actual work, so the preview shows the strongest
 * evidence rather than whatever happens to be first in the data file.
 *
 * NO PROFICIENCY PERCENTAGES — none are documented anywhere, so none are shown.
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import SkillTile from '@/components/ui/SkillTile.astro';
import { skillGroups, totalSkills } from '@/data/skills';

/**
 * Curated by name. A new skill added to `skills.ts` appears on /skills
 * automatically; it only reaches the homepage if it is listed here too, which
 * keeps this section deliberate.
 */
const SELECTED = [
  'Python',
  'SQL',
  'Java',
  'JavaScript',
  'Google Looker Studio',
  'Tableau',
  'Microsoft Excel',
  'Google Sheets',
  'Figma',
  'GitHub',
  'CapCut',
  'Google Apps Script',
];

/** Resolve the selection against the skill data, preserving the order above. */
const byName = new Map(skillGroups.flatMap((g) => g.items).map((i) => [i.name, i]));
const selected = SELECTED.map((n) => byName.get(n)).filter(Boolean);
---

<section class="sk" id="skills-preview">
  <div class="shell">
    <SectionHead
      index="04"
      eyebrow="Skills"
      title="Tools I work with"
      lede="Analytics and visualisation, programming and databases, modelling, process work, design, and everyday tooling."
      href="/skills"
      linkLabel="Explore all skills"
      note={`${totalSkills} entries`}
    />

    <ul class="sk__grid">
      {
        selected.map((item) => (
          <li>
            <SkillTile name={item!.name} icon={item!.icon} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sk {
    background-color: var(--band);
    border-block: var(--hairline) solid var(--border-faint);
  }

  .sk__grid {
    display: grid;
    gap: var(--gap-tight);
    margin: 0;
    padding: 0;
    list-style: none;
    /* auto-fill keeps tiles the right size at every width, with no media
       query and no dependence on how many skills are selected */
    grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
  }
</style>
