---
/**
 * SKILLS & TOOLS
 *
 * Deliberately NOT percentage bars. Neither source document states any
 * proficiency level, so inventing "Python 87%" would be fabrication. This lists
 * what has been worked with, grouped by area.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { skillGroups } from '@/content/skills';
---

<Section id="skills" aria-labelledby="skills-title">
  <SectionHeader
    id="skills-title"
    eyebrow="Skills & tools"
    title="What I work with"
    lead="Grouped by area rather than ranked — no proficiency scores, because the source documents don't state any."
    aside={`${skillGroups.length} areas`}
  />

  <div class="skills">
    {
      skillGroups.map((group) => (
        <section class="skgroup" aria-labelledby={`sk-${group.id}`}>
          <header class="skgroup__head">
            <h3 id={`sk-${group.id}`} class="skgroup__title">{group.title}</h3>
            {group.description && (
              <p class="skgroup__desc">{group.description}</p>
            )}
          </header>

          <ul class="skgroup__items">
            {group.items.map((item) => (
              <li class="skitem">
                <span class="skitem__mark" aria-hidden="true" />
                {item}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <p class="skills__note meta">
    Source: the portfolio deck's “Skills and Expertise” slide, plus tools
    evidenced in the documented experience descriptions.
  </p>
</Section>

<style>
  .skills {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 620px) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1040px) {
    .skills {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .skgroup {
    display: flex;
    flex-direction: column;
    padding: 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--surface-raised);
    transition: border-color var(--duration-base) var(--ease-out-soft);
  }

  .skgroup:hover {
    border-color: var(--border-strong);
  }

  .skgroup__head {
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--border);
  }

  .skgroup__title {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.012em;
  }

  .skgroup__desc {
    margin-top: 0.3rem;
    font-size: var(--text-xs);
    line-height: 1.55;
    color: var(--subtle-foreground);
  }

  .skgroup__items {
    display: grid;
    gap: 0.45rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  .skitem {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    line-height: 1.5;
  }

  .skitem__mark {
    flex-shrink: 0;
    width: 0.38rem;
    height: 1px;
    margin-top: 0.6em;
    background-color: var(--accent);
  }

  .skills__note {
    margin-top: 1.5rem;
    max-width: 74ch;
  }
</style>
