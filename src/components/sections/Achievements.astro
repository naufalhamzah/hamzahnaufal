---
/**
 * ACHIEVEMENTS
 * Factual wording only — no ranking inflation. A school-level olympiad medal is
 * described as a Silver Medal at the Olympiad, not upgraded to a national title.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { achievementEntries } from '@/content/achievements';

const KIND_LABEL: Record<string, string> = {
  award: 'Award',
  funding: 'Funding',
  competition: 'Competition',
};
---

<Section id="achievements" aria-labelledby="achievements-title">
  <SectionHeader
    id="achievements-title"
    eyebrow="Achievements"
    title="Awards & recognition"
    lead="Documented awards, competition results and programme funding."
    aside={`${achievementEntries.length} entries`}
  />

  <ul class="ach">
    {
      achievementEntries.map((a) => (
        <li class="ach__item">
          <div class="ach__marker" aria-hidden="true">
            <span class:list={['ach__glyph', `ach__glyph--${a.kind}`]}>
              {a.kind === 'award' ? '★' : a.kind === 'funding' ? '◆' : '▲'}
            </span>
          </div>

          <div class="ach__body">
            <div class="ach__top">
              <span class="ach__kind meta">{KIND_LABEL[a.kind]}</span>
              {a.year && <span class="meta">{a.year}</span>}
            </div>

            <h3 class="ach__title">{a.title}</h3>
            <p class="ach__detail">{a.detail}</p>
            {a.context && <p class="meta ach__context">{a.context}</p>}
          </div>
        </li>
      ))
    }
  </ul>

  <p class="ach__note meta">
    Wording reflects the source documents — no significance has been added.
  </p>
</Section>

<style>
  .ach {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }

  @media (min-width: 780px) {
    .ach {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .ach__item {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.85rem;
    padding: 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--surface-raised);
  }

  .ach__marker {
    display: flex;
    justify-content: center;
    padding-top: 0.15rem;
  }

  .ach__glyph {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: var(--radius-full);
    font-size: 0.7rem;
    line-height: 1;
  }

  .ach__glyph--award {
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    background-color: var(--accent-soft);
    color: var(--accent);
  }

  .ach__glyph--funding {
    border: 1px solid var(--border-strong);
    color: var(--foreground);
  }

  .ach__glyph--competition {
    border: 1px solid var(--border);
    color: var(--subtle-foreground);
  }

  .ach__body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .ach__top {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .ach__kind {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.6rem;
    color: var(--accent);
  }

  .ach__title {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.35;
  }

  .ach__detail {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--muted-foreground);
  }

  .ach__context {
    margin-top: 0.15rem;
  }

  .ach__note {
    margin-top: 1.5rem;
    max-width: 70ch;
  }
</style>
