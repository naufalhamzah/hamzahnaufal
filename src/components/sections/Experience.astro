---
/**
 * EXPERIENCE
 * A vertical timeline. The current role is visually prioritised: accent marker,
 * "Current" pill, and a highlighted left border.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Tag from '@/components/ui/Tag.astro';
import TodoBadge from '@/components/ui/TodoBadge.astro';
import { experienceSorted } from '@/content/experience';
---

<Section id="experience" aria-labelledby="experience-title">
  <SectionHeader
    id="experience-title"
    eyebrow="Experience"
    title="Professional experience"
    lead="Roles across information technology administration, data and marketing, IT support, and academic publishing."
    aside={`${experienceSorted.length} roles`}
  />

  <ol class="xp">
    {
      experienceSorted.map((job) => (
        <li class:list={['xp__item', { 'xp__item--current': job.current }]}>
          <div class="xp__rail" aria-hidden="true">
            <span class:list={['xp__dot', { 'xp__dot--current': job.current }]} />
          </div>

          <div class="xp__content">
            <div class="xp__top">
              <p class="meta xp__dates">
                {job.dateRange}
                {job.current && <span class="xp__now">Current</span>}
              </p>
              <p class="meta xp__loc">{job.location}</p>
            </div>

            <h3 class="xp__role">{job.role}</h3>

            <p class="xp__company">
              {job.company}
              {job.companyFull && (
                <span class="xp__company-full">{job.companyFull}</span>
              )}
            </p>

            <p class="xp__summary">{job.summary}</p>

            {job.highlights.length > 0 && (
              <ul class="xp__highlights">
                {job.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}

            {job.tools && job.tools.length > 0 && (
              <ul class="xp__tools" aria-label="Tools used">
                {job.tools.map((t) => (
                  <li>
                    <Tag label={t} small />
                  </li>
                ))}
              </ul>
            )}

            {job.todo && <TodoBadge note={job.todo} small />}
          </div>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .xp {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xp__item {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 0 clamp(0.75rem, 2vw, 1.5rem);
    padding-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  /* The connecting rail, drawn per item so there is no dangling line. */
  .xp__rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .xp__rail::before {
    content: '';
    position: absolute;
    top: 0.6rem;
    bottom: -0.6rem;
    width: 1px;
    background-color: var(--border);
  }

  .xp__item:last-child .xp__rail::before {
    bottom: auto;
    height: 1rem;
  }

  .xp__dot {
    position: relative;
    z-index: 1;
    margin-top: 0.45rem;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: var(--radius-full);
    border: 2px solid var(--border-strong);
    background-color: var(--surface);
  }

  @media (prefers-reduced-motion: no-preference) {
    .xp__dot--current::after {
      content: '';
      position: absolute;
      inset: -5px;
      border-radius: var(--radius-full);
      border: 1.5px solid var(--accent);
      opacity: 0.5;
      animation: xpulse 2.8s var(--ease-out-soft) infinite;
    }
  }

  @keyframes xpulse {
    0% {
      opacity: 0.5;
      transform: scale(0.75);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(1.8);
    }
  }

  .xp__item--current .xp__dot {
    border-color: var(--accent);
    background-color: var(--accent);
  }

  .xp__content {
    padding: 0.9rem 1.1rem 1.1rem;
    border: 1px solid var(--border);
    border-left: 2px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--surface-raised);
  }

  .xp__item--current .xp__content {
    border-left-color: var(--accent);
  }

  .xp__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
  }

  .xp__dates {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--foreground);
  }

  .xp__now {
    padding: 0.1rem 0.45rem;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: var(--radius-full);
    background-color: var(--accent-soft);
    color: var(--accent);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .xp__role {
    margin-top: 0.5rem;
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }

  .xp__company {
    margin-top: 0.2rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
  }

  .xp__company-full {
    display: block;
    margin-top: 0.1rem;
    font-weight: 400;
    font-size: var(--text-xs);
    color: var(--subtle-foreground);
    font-family: var(--font-mono);
  }

  .xp__summary {
    margin-top: 0.7rem;
    max-width: 74ch;
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--muted-foreground);
  }

  .xp__highlights {
    display: grid;
    gap: 0.4rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    max-width: 74ch;
  }

  .xp__highlights li {
    position: relative;
    padding-inline-start: 1.05rem;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--muted-foreground);
  }

  .xp__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 1px;
    background-color: var(--accent);
  }

  .xp__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .xp__item {
      grid-template-columns: 1.75rem minmax(0, 1fr);
    }
  }
</style>
