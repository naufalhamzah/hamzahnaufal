---
/**
 * Inline, blocking theme bootstrap.
 *
 * Why inline and why here: this must execute before the browser paints, or a
 * dark-first site flashes white first (FOUC). It therefore cannot be a module
 * import or a deferred script. It only reads storage + system preference and
 * toggles a class — a handful of bytes, no dependencies.
 */
---

<script is:inline>
  (function () {
    try {
      var stored = localStorage.getItem('hnz-theme');
      var theme =
        stored === 'dark' || stored === 'light'
          ? stored
          : window.matchMedia &&
              window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
      var root = document.documentElement;
      root.classList.toggle('dark', theme === 'dark');
      root.dataset.theme = theme;
      root.style.colorScheme = theme;
    } catch (e) {
      document.documentElement.classList.add('dark');
    }
  })();
</script>
