---
/**
 * NAVBAR — sticky, page-based, deliberately uncrowded.
 *
 * The bar carries only four primary destinations plus a "More" menu, so it
 * never reads as a wall of links. The grouping comes from
 * `src/utils/navigation.ts`, so the bar, the mobile panel and the footer can
 * never disagree about where a page lives.
 *
 * Active state is computed from the pathname on the SERVER, so it is already
 * correct before any JavaScript runs.
 */
import { primaryNav, secondaryNav, activePageFor } from '@/utils/navigation';
import { profile } from '@/data/profile';
import { monogram } from '@/data/monogram';
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '@/utils/url';

const path = Astro.url.pathname;
const active = activePageFor(path);
const isHome = path === '/' || path === '';

/** True when the current page lives under the "More" menu. */
const activeInMore = Boolean(
  active && secondaryNav.some((p) => p.href === active.href),
);
---

<header class="nav" id="site-nav">
  <div class="shell nav__inner">
    <!-- Identity — the monogram is one shared definition, so the tab icon and
         the nav mark can never drift apart. -->
    <a href={withBase('/')} class="nav__brand" aria-label={`${profile.name} — home`}>
      <span class="nav__mark" aria-hidden="true">
        <svg viewBox={`0 0 ${monogram.tile.size} ${monogram.tile.size}`} width="32" height="32" focusable="false">
          <rect width={monogram.tile.size} height={monogram.tile.size} rx={monogram.tile.rx} />
          <path d={monogram.h} class="nav__mark-glyph" />
          <path d={monogram.flourish} class="nav__mark-flourish" />
        </svg>
      </span>
      <span class="nav__name">{profile.shortName}</span>
    </a>

    <!-- Desktop: primary + More -->
    <nav class="nav__desk" aria-label="Main">
      <ul class="nav__list">
        <li>
          <a href={withBase('/')} class="nav__link" aria-current={isHome ? 'page' : undefined}>Home</a>
        </li>
        {
          primaryNav.map((page) => (
            <li>
              <a
                href={page.href}
                class="nav__link"
                aria-current={active?.href === page.href ? 'page' : undefined}
              >
                {page.short ?? page.label}
              </a>
            </li>
          ))
        }

        <!-- "More" — a disclosure, not a link, so it never navigates -->
        <li class="nav__more">
          <button
            type="button"
            id="nav-more"
            class="nav__link nav__link--btn"
            aria-expanded="false"
            aria-controls="nav-more-panel"
            data-active={activeInMore ? 'true' : undefined}
          >
            More
            <svg class="nav__caret" viewBox="0 0 10 6" width="9" height="6" aria-hidden="true">
              <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" />
            </svg>
          </button>

          <div id="nav-more-panel" class="more" hidden>
            <ul class="more__list">
              {
                secondaryNav.map((page) => (
                  <li>
                    <a
                      href={page.href}
                      class="more__item"
                      aria-current={active?.href === page.href ? 'page' : undefined}
                    >
                      <span class="more__label">{page.label}</span>
                      {page.blurb && <span class="more__blurb mono">{page.blurb}</span>}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
      </ul>
    </nav>

    <div class="nav__acts">
      <ThemeToggle />

      <a href={withBase('/contact')} class="nav__cta mono">Get in touch</a>

      <button
        type="button"
        id="nav-open"
        class="nav__burger"
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label="Open menu"
      >
        <span class="nav__bar" aria-hidden="true"></span>
        <span class="nav__bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- Mobile panel: every destination, numbered, with a one-line blurb -->
  <div id="nav-panel" class="panel" hidden>
    <nav class="panel__nav" aria-label="Main (mobile)">
      <ol class="panel__list">
        <li>
          <a href={withBase('/')} class="panel__link">
            <span class="panel__num mono" aria-hidden="true">00</span>
            <span class="panel__body">
              <span class="panel__label">Home</span>
              <span class="panel__blurb mono">Professional overview</span>
            </span>
          </a>
        </li>
        {
          [...primaryNav, ...secondaryNav].map((page, i) => (
            <li>
              <a
                href={page.href}
                class="panel__link"
                aria-current={active?.href === page.href ? 'page' : undefined}
              >
                <span class="panel__num mono" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="panel__body">
                  <span class="panel__label">{page.label}</span>
                  {page.blurb && <span class="panel__blurb mono">{page.blurb}</span>}
                </span>
              </a>
            </li>
          ))
        }
        <li>
          <a href={withBase('/contact')} class="panel__link">
            <span class="panel__num mono" aria-hidden="true">09</span>
            <span class="panel__body">
              <span class="panel__label">Contact</span>
              <span class="panel__blurb mono">Get in touch</span>
            </span>
          </a>
        </li>
      </ol>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 60;
    background-color: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: var(--hairline) solid transparent;
    transition: border-color var(--t-base) var(--ease);
  }

  .nav[data-scrolled='true'] {
    border-bottom-color: var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.25rem;
  }

  /* ---------- brand ---------- */
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-inline-end: auto;
  }

  .nav__mark {
    display: grid;
    place-items: center;
    width: 1.95rem;
    height: 1.95rem;
    flex: 0 0 auto;
  }

  /*
    The tile and the glyph are separate fills: the tile is the accent FILL, which
    carries light text, while the glyph sits on top of it. Using `--solid-bg` and
    `--on-solid` rather than `--accent` is what makes the mark legible in both
    themes — `--accent` is tuned for text ON the canvas and is too dark to carry a
    light glyph as a fill.
  */
  .nav__mark svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .nav__mark svg rect {
    fill: var(--solid-bg);
  }

  .nav__mark-glyph {
    fill: var(--on-solid);
  }

  /* The flourish is drawn OVER the letter, exactly as in the source artwork, so
     the crossing reads as one mark rather than as two shapes side by side. */
  .nav__mark-flourish {
    fill: var(--on-solid-soft);
  }

  .nav__brand:hover .nav__mark svg rect {
    fill: var(--solid-bg-hover);
  }

  .nav__name {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: -0.012em;
    white-space: nowrap;
  }

  /* ---------- desktop links ---------- */
  .nav__desk {
    display: none;
  }

  /* Six entries only, so the bar can appear earlier and stay airy. */
  @media (min-width: 900px) {
    .nav__desk {
      display: block;
    }
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.7rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    white-space: nowrap;
    transition: color var(--t-fast) var(--ease);
  }

  .nav__link:hover {
    color: var(--fg-strong);
  }

  .nav__link--btn {
    border: 0;
    background: none;
    cursor: pointer;
  }

  /* Active marker: a short accent rule under the label. */
  .nav__link[aria-current='page'],
  .nav__link[data-active='true'] {
    color: var(--accent);
  }

  .nav__link[aria-current='page']::after,
  .nav__link[data-active='true']::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.22rem;
    height: 1px;
    background-color: var(--accent);
  }

  .nav__caret {
    transition: transform var(--t-fast) var(--ease);
  }

  .nav__link[aria-expanded='true'] .nav__caret {
    transform: rotate(180deg);
  }

  /* ---------- "More" dropdown ---------- */
  .nav__more {
    position: relative;
  }

  .more {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 70;
    min-width: 17rem;
    padding: 0.5rem;
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-md);
    background-color: var(--surface);
    box-shadow: var(--shadow-lg);
    animation: more-in var(--t-base) var(--ease) both;
  }

  @keyframes more-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .more {
      animation: none;
    }
  }

  .more__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more__item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem 0.7rem;
    border-radius: var(--r-xs);
    transition: background-color var(--t-fast) var(--ease);
  }

  .more__item:hover {
    background-color: var(--accent-soft);
  }

  .more__label {
    font-size: var(--text-sm);
    color: var(--fg);
  }

  .more__item[aria-current='page'] .more__label {
    color: var(--accent);
  }

  .more__blurb {
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 0.64rem;
  }

  /* ---------- actions ---------- */
  .nav__acts {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav__cta {
    display: none;
    padding: 0.55rem 1rem;
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-xs);
    color: var(--fg);
    transition:
      border-color var(--t-fast) var(--ease),
      color var(--t-fast) var(--ease),
      background-color var(--t-fast) var(--ease);
  }

  .nav__cta:hover {
    border-color: var(--accent);
    color: var(--accent);
    background-color: var(--accent-soft);
  }

  @media (min-width: 900px) {
    .nav__cta {
      display: inline-block;
    }
  }

  .nav__burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.3rem;
    height: 2.3rem;
    padding: 0 0.6rem;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-xs);
    background: none;
    cursor: pointer;
  }

  .nav__bar {
    display: block;
    height: 1.5px;
    width: 100%;
    background-color: var(--fg-muted);
    transition: transform var(--t-base) var(--ease);
  }

  .nav__burger[aria-expanded='true'] .nav__bar:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav__burger[aria-expanded='true'] .nav__bar:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  @media (min-width: 900px) {
    .nav__burger {
      display: none;
    }
  }

  /* ---------- mobile panel ---------- */
  .panel {
    border-top: var(--hairline) solid var(--border);
    background-color: var(--bg);
    max-height: calc(100dvh - 4.25rem);
    overflow-y: auto;
  }

  .panel__list {
    display: grid;
    margin: 0;
    padding: 0.4rem var(--gutter) 1.75rem;
    list-style: none;
  }

  .panel__link {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.7rem 0;
    border-bottom: var(--hairline) solid var(--border-faint);
  }

  .panel__num {
    color: var(--fg-faint);
    flex: none;
  }

  .panel__body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .panel__label {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--fg-muted);
    transition: color var(--t-fast) var(--ease);
  }

  .panel__blurb {
    color: var(--fg-faint);
    font-size: 0.64rem;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .panel__link:hover .panel__label,
  .panel__link[aria-current='page'] .panel__label {
    color: var(--accent);
  }
</style>

<script>
  /**
   * Navbar behaviour:
   *   1. hairline appears once scrolled
   *   2. the "More" disclosure opens/closes with Escape and outside clicks
   *   3. the mobile panel does the same
   */
  const nav = document.getElementById('site-nav');
  const burger = document.getElementById('nav-open');
  const panel = document.getElementById('nav-panel');
  const moreBtn = document.getElementById('nav-more');
  const morePanel = document.getElementById('nav-more-panel');

  /* --- 1. scrolled --- */
  const onScroll = () => {
    if (nav) nav.dataset.scrolled = String(window.scrollY > 6);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  /* --- 2. "More" disclosure --- */
  function setMore(open: boolean) {
    if (!moreBtn || !morePanel) return;
    moreBtn.setAttribute('aria-expanded', String(open));
    morePanel.hidden = !open;
  }

  moreBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    setMore(moreBtn.getAttribute('aria-expanded') !== 'true');
  });

  /* --- 3. mobile panel --- */
  function setPanel(open: boolean) {
    if (!burger || !panel) return;
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    panel.hidden = !open;
  }

  burger?.addEventListener('click', () => {
    setPanel(burger.getAttribute('aria-expanded') !== 'true');
  });

  panel?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => setPanel(false)),
  );

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (moreBtn?.getAttribute('aria-expanded') === 'true') {
      setMore(false);
      moreBtn.focus();
    }
    if (burger?.getAttribute('aria-expanded') === 'true') {
      setPanel(false);
      burger.focus();
    }
  });

  document.addEventListener('click', (e) => {
    const t = e.target as Node;

    if (morePanel && !morePanel.hidden && !morePanel.contains(t) && !moreBtn?.contains(t)) {
      setMore(false);
    }
    if (panel && !panel.hidden && !panel.contains(t) && !burger?.contains(t)) {
      setPanel(false);
    }
  });
</script>
