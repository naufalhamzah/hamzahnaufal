---
/**
 * FOOTER — mirrors the navbar's section list and shows the contact links plus
 * the employer logos, which doubles as a quiet credibility band.
 */
import { primaryNav, secondaryNav, activePageFor } from '@/utils/navigation';
import { profile, activeContactLinks } from '@/data/profile';
import { experienceLogos } from '@/data/experience';

const year = new Date().getFullYear();
const active = activePageFor(Astro.url.pathname);
---

<footer class="ft">
  <div class="shell">
    <!-- Employer / institution logos -->
    {
      experienceLogos.length > 0 && (
        <div class="ft__logos" aria-label="Organisations">
          {experienceLogos.map((job) =>
            job.logo ? (
              <span class="ft__logo">
                <img
                  src={job.logo.src}
                  alt={job.logo.alt}
                  width={job.logo.width ?? 200}
                  height={job.logo.height ?? 80}
                  loading="lazy"
                  decoding="async"
                />
              </span>
            ) : null,
          )}
        </div>
      )
    }

    <div class="ft__grid">
      <div class="ft__col ft__col--brand">
        <p class="ft__name">{profile.name}</p>
        <p class="ft__role mono">{profile.headline}</p>
        <p class="ft__tag">“{profile.tagline}”</p>
      </div>

      <nav class="ft__col" aria-label="Footer navigation">
        <p class="label ft__h">Pages</p>
        <ul class="ft__list">
          <li>
            <a
              href="/"
              class="ft__link"
              aria-current={!active ? 'page' : undefined}>Home</a
            >
          </li>
          {
            [...primaryNav, ...secondaryNav].map((page) => (
              <li>
                <a
                  href={page.href}
                  class="ft__link"
                  aria-current={active?.href === page.href ? 'page' : undefined}
                >
                  {page.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/contact" class="ft__link">Contact</a>
          </li>
        </ul>
      </nav>

      <div class="ft__col">
        <p class="label ft__h">Elsewhere</p>
        <ul class="ft__list">
          {
            activeContactLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="ft__link"
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  target={link.external ? '_blank' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="ft__base">
      <p class="mono">© {year} {profile.name}</p>
      <p class="mono">Built with Astro, TypeScript &amp; Tailwind</p>
    </div>
  </div>
</footer>

<style>
  .ft {
    position: relative;
    z-index: 1;
    border-top: var(--hairline) solid var(--border);
    padding-block: clamp(2.5rem, 5vw, 4rem) 2rem;
    background-color: var(--band);
  }

  /* ---------- logos ---------- */
  .ft__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-bottom: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
    border-bottom: var(--hairline) solid var(--border-faint);
  }

  /*
    DO NOT put max-height:100% on the image here.

    The plate is a grid item whose row is sized by its content, so a percentage
    max-height has no definite height to resolve against and the declaration is
    dropped. The <img> then falls back to its intrinsic size and the source
    logos — AirNav is 447x447, the wide wordmarks are 900px — painted at full
    size inside a 32px plate, blowing the footer to 361px tall and overlapping
    the navigation links.

    So the chip has a FIXED height and width; `height:100%` on the image then
    resolves against something definite.
  */
  .ft__logo {
    display: grid;
    place-items: center;
    /*
      A uniform WHITE chip, deliberately.

      The supplied marks disagree on almost everything: three are on solid white
      plates with no alpha (AirNav, SMA, UNNES), four are transparent cut-outs,
      and the colour schemes run from navy to teal to gold. Dropped straight onto
      a dark band, the white-plate ones glare as bright rectangles while the
      dark-ink ones vanish.

      A white chip settles all of it at once: a white-plate mark merges into it
      seamlessly, and a transparent mark reads cleanly on it. The chip is held
      slightly back so the band stays quiet rather than shouting in a dark footer,
      and comes to full strength on hover.
    */
    height: 2.6rem;
    width: 6.5rem;
    padding: 0.4rem 0.55rem;
    background-color: #fdfcfa;
    border: var(--hairline) solid var(--border-faint);
    border-radius: var(--r-xs);
    opacity: 0.72;
    transition:
      opacity var(--t-base) var(--ease),
      transform var(--t-base) var(--ease);
  }

  .ft__logo:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .ft__logo img {
    /*
      max-height in ABSOLUTE terms, not a percentage.

      `max-height: 100%` on a grid item resolves against its grid area, and with
      padding on the chip plus an auto-height image that produced an 84px logo
      inside a 41px chip — the same percentage-resolution trap as before, one
      level down. A fixed value cannot fail: the chip is 2.6rem tall with 0.4rem
      of vertical padding, so the content box is 1.8rem and the image is capped
      just under it.
    */
    max-height: 1.7rem;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* ---------- grid ---------- */
  .ft__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 700px) {
    .ft__grid {
      grid-template-columns: 1.6fr 1fr 1fr;
      gap: 2.5rem;
    }
  }

  .ft__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--fg-strong);
  }

  .ft__role {
    margin-top: 0.4rem;
    max-width: 30ch;
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--fg-muted);
  }

  .ft__tag {
    margin-top: 1rem;
    max-width: 34ch;
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--fg-faint);
  }

  .ft__h {
    display: block;
    margin-bottom: 0.9rem;
  }

  .ft__h::before {
    display: none;
  }

  .ft__list {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ft__link {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    transition: color var(--t-fast) var(--ease);
  }

  .ft__link:hover {
    color: var(--accent);
  }

  .ft__base {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.25rem;
    border-top: var(--hairline) solid var(--border-faint);
  }
</style>
