---
/**
 * FOOTER — mirrors the navbar's section list and shows the contact links plus
 * the employer logos, which doubles as a quiet credibility band.
 */
import { primaryNav, secondaryNav, activePageFor } from '@/utils/navigation';
import { profile, activeContactLinks } from '@/data/profile';
import { experienceLogos } from '@/data/experience';

const year = new Date().getFullYear();
const active = activePageFor(Astro.url.pathname);
---

<footer class="ft">
  <div class="shell">
    <!-- Employer / institution logos -->
    {
      experienceLogos.length > 0 && (
        <div class="ft__logos" aria-label="Organisations">
          {experienceLogos.map((job) =>
            job.logo ? (
              /*
                The shape class is derived from the logo's OWN dimensions rather
                than being hand-assigned per entry, so adding a new logo to the
                data cannot forget it. A mark wider than 3:1 is a wordmark and
                needs the wide treatment; anything squarer is a badge.
              */
              <span
                class:list={[
                  'ft__logo',
                  (job.logo.width ?? 1) / (job.logo.height ?? 1) > 3 && 'ft__logo--wide',
                ]}
              >
                <img
                  src={job.logo.src}
                  alt={job.logo.alt}
                  width={job.logo.width ?? 200}
                  height={job.logo.height ?? 80}
                  loading="lazy"
                  decoding="async"
                />
              </span>
            ) : null,
          )}
        </div>
      )
    }

    <div class="ft__grid">
      <div class="ft__col ft__col--brand">
        <p class="ft__name">{profile.name}</p>
        <p class="ft__role mono">{profile.headline}</p>
        <p class="ft__tag">“{profile.tagline}”</p>
      </div>

      <nav class="ft__col" aria-label="Footer navigation">
        <p class="label ft__h">Pages</p>
        <ul class="ft__list">
          <li>
            <a
              href="/"
              class="ft__link"
              aria-current={!active ? 'page' : undefined}>Home</a
            >
          </li>
          {
            [...primaryNav, ...secondaryNav].map((page) => (
              <li>
                <a
                  href={page.href}
                  class="ft__link"
                  aria-current={active?.href === page.href ? 'page' : undefined}
                >
                  {page.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/contact" class="ft__link">Contact</a>
          </li>
        </ul>
      </nav>

      <div class="ft__col">
        <p class="label ft__h">Elsewhere</p>
        <ul class="ft__list">
          {
            activeContactLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="ft__link"
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  target={link.external ? '_blank' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="ft__base">
      <p class="mono">© {year} {profile.name}</p>
      <p class="mono">Built with Astro, TypeScript &amp; Tailwind</p>
    </div>
  </div>
</footer>

<style>
  .ft {
    position: relative;
    z-index: 1;
    border-top: var(--hairline) solid var(--border);
    padding-block: clamp(2.5rem, 5vw, 4rem) 2rem;
    background-color: var(--band);
  }

  /* ---------- logos ---------- */
  .ft__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.5rem, 3.5vw, 3rem);
    padding-bottom: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
    border-bottom: var(--hairline) solid var(--border-faint);
  }

  /*
    NO CHIP, NO PLATE — the logos are transparent.

    Every mark is now a cut-out (the three that arrived on opaque white plates are
    flood-filled clean by the asset pipeline), so they sit directly on the band.
    An earlier version boxed each one in a white chip to paper over the fact that
    only some had transparent backgrounds — which just drew a SECOND rectangle
    around the ones that already had one.

    SIZING. These marks have wildly different shapes: the content ratios run from
    1.00 (AirNav, a square badge) to 5.87 (JAIST, a very wide wordmark). Sizing
    them all to one BOX makes the wide ones tiny, because a wide mark inside a
    fixed width collapses to a few pixels of height — which is why JAIST was
    barely legible.

    So the sizing key is OPTICAL, not geometric: each logo is given a height in
    rem, and the wide wordmarks get a slightly larger one so their lettering
    reads at the same size as the square badges. `width: auto` lets each keep its
    own shape. The cap on width stops the widest mark from running away.
  */
  .ft__logo {
    display: block;
  }

  .ft__logo img {
    display: block;
    width: auto;
    /* Default: square-ish badges. */
    height: 2.1rem;
    max-width: 10rem;
    object-fit: contain;
    opacity: 0.72;
    transition:
      opacity var(--t-base) var(--ease),
      transform var(--t-base) var(--ease);
  }

  /* Wide wordmarks: taller box so their type matches the badges optically. */
  .ft__logo--wide img {
    /*
      Taller AND allowed to be wider.

      JAIST is an extremely wide mark (content ratio ~6.3). At the badge's height
      it renders only ~25px tall and its lettering is barely legible, so the wide
      variant gets a larger box — and the width cap has to grow with it, or the
      cap itself becomes the binding constraint and collapses the height again.
    */
    height: 1.9rem;
    max-width: 13rem;
  }

  .ft__logo:hover img {
    opacity: 1;
    transform: translateY(-2px);
  }

  /* ---------- grid ---------- */
  .ft__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 700px) {
    .ft__grid {
      grid-template-columns: 1.6fr 1fr 1fr;
      gap: 2.5rem;
    }
  }

  .ft__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--fg-strong);
  }

  .ft__role {
    margin-top: 0.4rem;
    max-width: 30ch;
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--fg-muted);
  }

  .ft__tag {
    margin-top: 1rem;
    max-width: 34ch;
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--fg-faint);
  }

  .ft__h {
    display: block;
    margin-bottom: 0.9rem;
  }

  .ft__h::before {
    display: none;
  }

  .ft__list {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ft__link {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    transition: color var(--t-fast) var(--ease);
  }

  .ft__link:hover {
    color: var(--accent);
  }

  .ft__base {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.25rem;
    border-top: var(--hairline) solid var(--border-faint);
  }
</style>
