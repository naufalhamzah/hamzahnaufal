---
/**
 * THEME TOGGLE — not a React island.
 *
 * One button with one boolean of state; shipping a component runtime for that
 * would cost far more JavaScript than the component is worth. React is reserved
 * for the project filter, which genuinely needs client state.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="tt"
  aria-pressed="false"
  aria-label="Switch to light theme"
  title="Toggle colour theme"
>
  <svg class="tt__i tt__i--sun" viewBox="0 0 24 24" width="16" height="16" fill="none"
    stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>

  <svg class="tt__i tt__i--moon" viewBox="0 0 24 24" width="16" height="16" fill="none"
    stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
</button>

<style>
  .tt {
    display: inline-grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    padding: 0;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-xs);
    background: none;
    color: var(--fg-muted);
    cursor: pointer;
    transition:
      color var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
  }

  .tt:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .tt__i--moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .tt__i--sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .tt__i--moon {
    display: block;
  }
</style>

<script>
  import { applyTheme, resolveTheme, type Theme } from '@/utils/theme';

  const btn = document.getElementById('theme-toggle');

  function sync(theme: Theme) {
    if (!btn) return;
    const next = theme === 'dark' ? 'light' : 'dark';
    btn.setAttribute('aria-pressed', String(theme === 'light'));
    btn.setAttribute('aria-label', `Switch to ${next} theme`);
  }

  if (btn) {
    sync(resolveTheme());
    btn.addEventListener('click', () => {
      const next: Theme = resolveTheme() === 'dark' ? 'light' : 'dark';
      // `animate` turns on the crossfade guard for this change only.
      applyTheme(next, true, true);
      sync(next);
    });
  }
</script>
