---
/**
 * Theme toggle.
 *
 * Deliberately NOT a React island: it is one button with one boolean of state.
 * Shipping the React runtime for that would cost far more JavaScript than the
 * component itself. A small inline script is the honest engineering choice.
 * React is reserved for the genuinely stateful parts of the site (project
 * filtering, the certification lightbox).
 *
 * Accessibility: uses aria-pressed to expose the current state, and the label
 * always names the action that will happen.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="theme-toggle"
  aria-pressed="false"
  aria-label="Switch to light theme"
  title="Toggle colour theme"
>
  <!-- Sun: shown when dark (clicking switches to light) -->
  <svg
    class="theme-toggle__icon theme-toggle__icon--sun"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <!-- Moon: shown when light (clicking switches to dark) -->
  <svg
    class="theme-toggle__icon theme-toggle__icon--moon"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: transparent;
    color: var(--muted-foreground);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out-soft),
      border-color var(--duration-fast) var(--ease-out-soft),
      background-color var(--duration-fast) var(--ease-out-soft);
  }

  .theme-toggle:hover {
    color: var(--foreground);
    border-color: var(--border-strong);
    background-color: var(--surface-raised);
  }

  /* Only one icon is visible at a time; we key off the .dark class on <html>. */
  .theme-toggle__icon--moon {
    display: none;
  }

  :global(.dark) .theme-toggle__icon--sun {
    display: none;
  }

  :global(.dark) .theme-toggle__icon--moon {
    display: block;
  }
</style>

<script>
  import { applyTheme, resolveTheme, type Theme } from '@/lib/theme';

  const button = document.getElementById('theme-toggle');

  function syncButton(theme: Theme) {
    if (!button) return;
    const goingTo = theme === 'dark' ? 'light' : 'dark';
    button.setAttribute('aria-pressed', String(theme === 'light'));
    button.setAttribute('aria-label', `Switch to ${goingTo} theme`);
  }

  if (button) {
    syncButton(resolveTheme());

    button.addEventListener('click', () => {
      const next: Theme =
        document.documentElement.classList.contains('dark') ? 'light' : 'dark';
      applyTheme(next);
      syncButton(next);
    });
  }
</script>
