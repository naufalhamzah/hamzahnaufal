---
/**
 * Small reusable pieces: tag pills.
 * Kept as its own file so the class list lives in exactly one place.
 */
interface TagProps {
  label: string;
  /** Accent-coloured variant for the primary category. */
  accent?: boolean;
  /** Compact variant for dense lists. */
  small?: boolean;
}
const { label, accent = false, small = false } = Astro.props as TagProps;
---

<span class:list={['tag', { 'tag--accent': accent, 'tag--small': small }]}>
  {label}
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background-color: var(--surface-raised);
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .tag--small {
    padding: 0.12rem 0.5rem;
    font-size: 0.68rem;
  }

  .tag--accent {
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    background-color: var(--accent-soft);
    color: var(--accent);
  }
</style>
