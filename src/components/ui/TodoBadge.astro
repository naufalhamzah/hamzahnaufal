---
/**
 * TODO badge — rendered wherever content is provisional or unresolved.
 *
 * This is the visible half of the "never invent information" rule: an unknown
 * fact is shown as an honest gap instead of being filled with a plausible guess.
 */
interface Props {
  note: string;
  /** Compact variant for use inside dense lists. */
  small?: boolean;
}

const { note, small = false } = Astro.props;
---

<aside class:list={['todo', { 'todo--small': small }]} role="note">
  <span class="todo__label">TODO</span>
  <span class="todo__text">{note}</span>
</aside>

<style>
  .todo {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin-top: 0.85rem;
    padding: 0.55rem 0.75rem;
    border: 1px dashed var(--border-strong);
    border-left: 2px solid var(--subtle-foreground);
    border-radius: var(--radius-sm);
    background-color: color-mix(in srgb, var(--surface-sunken) 60%, transparent);
  }

  .todo--small {
    padding: 0.4rem 0.6rem;
    margin-top: 0.6rem;
  }

  .todo__label {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--subtle-foreground);
    padding-top: 0.1rem;
  }

  .todo__text {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--subtle-foreground);
  }
</style>
