---
/**
 * Section header — used by every top-level section so the eyebrow, title and
 * optional lead paragraph stay visually consistent.
 */
interface Props {
  /** DOM id applied to the heading, so the section can reference it via aria-labelledby. */
  id?: string;
  /** Small monospace label above the title. */
  eyebrow?: string;
  title: string;
  /** Optional lead paragraph. */
  lead?: string;
  /** Optional count/badge shown on the right (e.g. "3 featured"). */
  aside?: string;
  /** Center the block (used on the contact section). */
  centered?: boolean;
}

const { id, eyebrow, title, lead, aside, centered = false } = Astro.props;
---

<header class:list={['section-header', { 'section-header--centered': centered }]}>
  <div class="section-header__text">
    {
      eyebrow && (
        <div class="section-header__top">
          <p class="eyebrow">{eyebrow}</p>
          {aside && <p class="meta section-header__aside">{aside}</p>}
        </div>
      )
    }
    {!eyebrow && aside && <p class="meta section-header__aside">{aside}</p>}

    <h2 id={id} class="section-header__title">{title}</h2>

    {lead && <p class="section-header__lead">{lead}</p>}
  </div>
</header>

<style>
  .section-header {
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
  }

  .section-header--centered {
    text-align: center;
  }

  .section-header--centered .section-header__lead {
    margin-inline: auto;
  }

  .section-header__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .section-header__aside {
    margin-inline-start: auto;
  }

  .section-header--centered .section-header__top {
    justify-content: center;
  }

  .section-header--centered .section-header__aside {
    margin-inline-start: 0;
  }

  .section-header__title {
    margin-top: 0.55rem;
    font-size: var(--text-3xl);
    letter-spacing: -0.028em;
  }

  .section-header__lead {
    margin-top: 0.9rem;
    max-width: 62ch;
    color: var(--muted-foreground);
    font-size: var(--text-lg);
  }
</style>
