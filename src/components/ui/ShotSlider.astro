---
/**
 * SHOT SLIDER — a horizontal snap rail of images.
 *
 * ONE frame shape, and a slider when there is more than one image. Two places
 * needed this: the Experience page framed every role differently by image count
 * and the Projects grid shaped each card like its own image, so one list held
 * THREE different frame ratios (measured 1.60, 0.56, 0.80).
 *
 * PROGRESSIVE ENHANCEMENT: the rail is a native scroll-snap element, so swiping,
 * trackpad and keyboard scrolling work with NO script. A delegated listener then
 * adds the arrows and the counter.
 *
 * TWO MODES:
 *   lightbox = true   (default) each slide opens the shared lightbox.
 *   lightbox = false  slides are plain images. Required inside a project card,
 *                     whose own link already covers its whole surface — two
 *                     competing actions on one click is worse than either alone,
 *                     and a <button> inside an <a> is invalid HTML.
 */
import type { MediaAsset } from '@/types/content';
import { asset } from '@/utils/url';

interface Props {
  images: MediaAsset[];
  /** Optional caption shown under the frame. */
  caption?: string;
  /** Aspect ratio of the frame. Defaults to 16:10. */
  ratio?: string;
  /** Whether slides open the shared lightbox. Default true. */
  lightbox?: boolean;
  /** Accessible name for the rail. */
  label?: string;
  /**
   * How images fill the frame, applied to EVERY slide. `contain` lets a mixed set
   * work in one frame: the sources run from a 0.49 phone screenshot to a 1.78
   * dashboard, and `cover` would crop the phone screenshot by 70% — it stops
   * being a screenshot of anything. The matte then makes the differing shapes
   * read as a deliberate plate.
   */
  fit?: 'cover' | 'contain';
  /**
   * Group NARROW images side by side within one slide. A ~0.49 phone screenshot
   * under `contain` leaves most of a 16:10 frame as matte — a narrow strip
   * floating in space. Paired, two screenshots together fill the frame's width
   * while keeping the single ratio and staying uncropped.
   *
   * WIDE images are never paired; they already fill the frame on their own.
   */
  pairNarrow?: boolean;
  /**
   * Present narrow screenshots as DEVICE MOCKUPS. A raw phone screenshot in a
   * wide frame reads as a picture of a phone, not as product work: it says "this
   * is a mobile product" without a caption, gives the capture a deliberate
   * boundary instead of a letterbox edge, and lifts the frame because the shell
   * is taller than the screenshot.
   *
   * The shell is drawn in CSS, so it costs no extra image and follows the theme.
   * It is decoration applied TO an image, never a substitute for one.
   */
  mockup?: boolean;
}

const {
  images,
  caption,
  ratio = '16 / 10',
  lightbox = true,
  label = 'Image gallery',
  fit = 'cover',
  pairNarrow = false,
  mockup = false,
} = Astro.props;

/** A mark is a device mockup only if the image is actually portrait. */
const asMockup = (m: MediaAsset) => {
  if (!mockup) return false;
  const ar = m.width && m.height ? m.width / m.height : 1.5;
  /*
    A DOCUMENT IS NOT A PHONE even when portrait: the threshold alone caught the
    Ampoen journal page (ratio 0.734) and wrapped it in the 9:19.5 device box,
    rendering the page at ~30% of the frame's width. Documents declare
    `fit: 'contain'`, and that flag is what tells the two apart.
  */
  return ar < 0.75 && m.fit !== 'contain';
};

/**
 * With `pairNarrow`, consecutive images narrower than 0.75 are grouped two at a
 * time; everything else gets its own slide. Grouping here rather than in the
 * data keeps the same images working if the prop is turned off.
 */
const isNarrow = (m: MediaAsset) => {
  const ar = m.width && m.height ? m.width / m.height : 1.5;
  /* A document is never paired as if it were a phone screenshot. */
  return ar < 0.75 && m.fit !== 'contain';
};

const slides: MediaAsset[][] = [];
if (pairNarrow) {
  for (let i = 0; i < images.length; i++) {
    const a = images[i];
    const b = images[i + 1];
    if (a && isNarrow(a) && b && isNarrow(b)) {
      slides.push([a, b]);
      i++; // consumed b
    } else {
      slides.push([a]);
    }
  }
} else {
  for (const img of images) slides.push([img]);
}

const uid = `sl-${Math.random().toString(36).slice(2, 8)}`;
const many = images.length > 1;
---

{
  images.length > 0 && (
    <figure class="sl" style={`--sl-ratio: ${ratio};`}>
      <div class="sl__viewport">
        <div
          class="sl__rail"
          id={uid}
          role="group"
          aria-label={`${label} — ${images.length} images`}
          tabindex={many ? '0' : '-1'}
        >
          {slides.map((slide, si) => (
            <div
              class:list={['sl__slide', slide.length > 1 && 'sl__slide--pair']}
              data-slide
            >
              {slide.map((img, ii) =>
                lightbox ? (
                  <button
                    type="button"
                    class="sl__item"
                    data-lightbox-src={asset(img.src)}
                    data-lightbox-alt={img.alt}
                    data-lightbox-caption={img.caption ?? img.alt}
                    aria-label={`View larger: ${img.alt}`}
                  >
                    {asMockup(img) ? (
                      <span class="sl__device">
                        <img
                          src={asset(img.src)}
                          alt={img.alt}
                          width={img.width}
                          height={img.height}
                          loading={si === 0 && ii === 0 ? 'eager' : 'lazy'}
                          decoding="async"
                        />
                      </span>
                    ) : (
                      <img
                        src={asset(img.src)}
                        alt={img.alt}
                        width={img.width}
                        height={img.height}
                        loading={si === 0 && ii === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                        class:list={[
                          (fit === 'contain' || img.fit === 'contain') && 'sl__img--contain',
                        ]}
                      />
                    )}
                  </button>
                ) : (
                  <div class="sl__item">
                    {asMockup(img) ? (
                      <span class="sl__device">
                        <img
                          src={asset(img.src)}
                          alt={img.alt}
                          width={img.width}
                          height={img.height}
                          loading={si === 0 && ii === 0 ? 'eager' : 'lazy'}
                          decoding="async"
                        />
                      </span>
                    ) : (
                      <img
                        src={asset(img.src)}
                        alt={img.alt}
                        width={img.width}
                        height={img.height}
                        loading={si === 0 && ii === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                        class:list={[
                          (fit === 'contain' || img.fit === 'contain') && 'sl__img--contain',
                        ]}
                      />
                    )}
                  </div>
                ),
              )}
            </div>
          ))}
        </div>


        {
          many && (
            <>
              <button
                type="button"
                class="sl__arrow sl__arrow--prev"
                data-slider-prev
                aria-label="Previous image"
              >
                <span aria-hidden="true">‹</span>
              </button>
              <button
                type="button"
                class="sl__arrow sl__arrow--next"
                data-slider-next
                aria-label="Next image"
              >
                <span aria-hidden="true">›</span>
              </button>
            </>
          )
        }

        {
          many && (
            <span class="sl__count mono" data-slider-count aria-hidden="true">
              1 / {images.length}
            </span>
          )
        }
      </div>

      {caption && <figcaption class="sl__cap mono">{caption}</figcaption>}
    </figure>
  )
}

<style>
  .sl {
    margin: 0;
    height: 100%;
  }

  .sl__viewport {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-xs);
    background-color: var(--photo-mat);
    /* ONE shape for whatever this slider sits in. */
    aspect-ratio: var(--sl-ratio, 16 / 10);
  }

  .sl__rail {
    display: flex;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .sl__rail::-webkit-scrollbar {
    display: none;
  }

  .sl__rail:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  /* A slide is a flex ROW so it can hold one image or a pair; two narrow
     screenshots together fill the frame's width, removing the matte a single one
     would leave. */
  .sl__slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    display: flex;
    gap: 0.6rem;
    padding: 0;
    border: 0;
    background: none;
    scroll-snap-align: start;
  }

  /* A paired slide sits on the matte too, so the gap between the two reads as
     part of the same plate rather than as a hole. */
  .sl__slide--pair {
    padding: 0.75rem;
    background-color: var(--photo-mat);
  }

  .sl__item {
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .sl__item img {
    display: block;
    width: 100%;
    height: 100%;
    /* Anchor the crop to the TOP: a centred crop of a person cuts the head off
       and keeps the floor. */
    object-fit: cover;
    object-position: center top;
  }

  .sl__item img {
    transition: transform var(--t-slow) var(--ease);
  }

  .sl__item:hover img {
    transform: scale(1.02);
  }

  /* Documents (a journal page, a cover) are letterboxed — their meaning lives at
     the edges. */
  .sl__img--contain {
    object-fit: contain !important;
    object-position: center !important;
    padding: 0.75rem;
  }

  /* Inside a paired slide the inset is the slide's own padding, so the images
     must not add a second one. */
  .sl__slide--pair .sl__img--contain {
    padding: 0;
  }

  /* device mockup
     THE RENDER IS THE PHONE — this wrapper adds NO hardware of its own. The box is
     sized by HEIGHT first (`height: 100%`, width from the aspect ratio): sizing by
     width would let a very tall capture push past the frame and clip it. Every
     capture ships as a full device render with its own bezel, corner radius,
     dynamic island and shadow, so a drawn shell would be a SECOND rectangle around
     a phone that already has one. What remains is a transparent layout box that
     reserves space, sizes from the device's own ratio and centres the render. */
  .sl__device {
    display: block;
    position: relative;
    height: calc(100% - 1.1rem);
    aspect-ratio: 9 / 19.5;
    max-width: 100%;
    margin: 0 auto;
    padding: 0;
    border: 0;
    border-radius: 0;
    background-color: transparent;
    box-shadow: none;
    overflow: visible;
  }

  .sl__device img {
    display: block;
    width: 100%;
    height: 100%;
    /* The render supplies its own rounded corners, so `border-radius` here would
       round the wrong rectangle. */
    border-radius: 0;
    object-fit: contain;
    object-position: center bottom;
    padding: 0;
    /* Depth follows the ALPHA silhouette — the bezel, not a rectangle around it. */
    filter: var(--photo-filter) drop-shadow(0 2px 4px rgba(0, 0, 0, 0.34))
      drop-shadow(0 14px 30px rgba(0, 0, 0, 0.3));
  }

  :global([data-theme='light']) .sl__device img {
    filter: var(--photo-filter) drop-shadow(0 2px 4px rgba(62, 46, 30, 0.18))
      drop-shadow(0 14px 28px rgba(62, 46, 30, 0.16));
  }

  /* NO DRAWN NOTCH — same defect as in `Collage.astro`: the `::before` pill landed
     on top of the dynamic island the captures already carry (measured: every device
     capture holds its own dark pill, ~24% of the frame width, 35px down). If a bare
     screen capture is ever added, render THAT one without the shell rather than
     re-adding a pill to every phone. */

  .sl__slide--pair .sl__device {
    height: calc(100% - 0.6rem);
  }

  .sl__item:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -3px;
  }

  /* arrows
     `z-index: 3` puts these ABOVE the project card's stretched link (`z-index: 2`),
     so clicking an arrow slides the rail instead of following the card link. */
  .sl__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border: var(--hairline) solid rgba(255, 255, 255, 0.22);
    border-radius: var(--r-full);
    background-color: rgba(11, 9, 8, 0.55);
    color: #f7f3ec;
    font-size: 1.25rem;
    line-height: 1;
    transform: translateY(-50%);
    backdrop-filter: blur(6px);
    transition:
      background-color var(--t-base) var(--ease),
      border-color var(--t-base) var(--ease);
  }

  .sl__arrow:hover {
    background-color: rgba(11, 9, 8, 0.8);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .sl__arrow--prev {
    left: 0.6rem;
  }

  .sl__arrow--next {
    right: 0.6rem;
  }

  .sl__count {
    position: absolute;
    /* Clear of the scan line and the frame edge, so it never looks clipped. */
    right: 0.7rem;
    bottom: 0.7rem;
    z-index: 3;
    padding: 0.25rem 0.55rem;
    border-radius: var(--r-full);
    background-color: rgba(11, 9, 8, 0.6);
    color: #f7f3ec;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    backdrop-filter: blur(6px);
  }

  .sl__cap {
    margin-top: 0.7rem;
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.02em;
  }
</style>

<script>
  /**
   * Slider controls — progressive enhancement over the scroll-snap rail.
   *
   * One delegated listener handles every slider on the page; a projects grid can
   * hold several rails, and a listener per instance costs a frame during scroll.
   *
   * The arrows move by ONE SLIDE, not one viewport: each slide is exactly the
   * rail's width (`flex: 0 0 100%`). Smooth scrolling is downgraded to a jump by
   * the browser when the visitor asks for reduced motion.
   */
  const rails = document.querySelectorAll<HTMLElement>('.sl__rail');

  if (rails.length) {
    const step = (rail: HTMLElement, dir: 1 | -1) => {
      rail.scrollBy({ left: rail.clientWidth * dir, behavior: 'smooth' });
    };

    const sync = (rail: HTMLElement) => {
      const viewport = rail.closest('.sl__viewport');
      const counter = viewport?.querySelector('[data-slider-count]');
      if (!counter) return;
      // Count SLIDES, not images: a paired slide holds two images but is one
      // position on the rail, so the counter must match what the visitor sees.
      const total = rail.children.length;
      const index = Math.round(rail.scrollLeft / Math.max(rail.clientWidth, 1)) + 1;
      counter.textContent = `${Math.min(Math.max(index, 1), total)} / ${total}`;
    };

    rails.forEach((rail) => {
      rail.addEventListener('scroll', () => sync(rail), { passive: true });
      sync(rail);
    });

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const btn = target?.closest('[data-slider-prev], [data-slider-next]');
      if (!btn) return;
      const viewport = btn.closest('.sl__viewport');
      const rail = viewport?.querySelector<HTMLElement>('.sl__rail');
      if (!rail) return;
      step(rail, btn.hasAttribute('data-slider-prev') ? -1 : 1);
    });

    /*
      MOUSE DRAG — native scroll containers do not drag with a mouse. Touch is left
      to the browser on purpose: hijacking it would cost the platform's momentum and
      rubber-banding. The 6px threshold keeps a plain CLICK working.

      Same implementation as `FeaturedRail.astro`, duplicated because the two differ
      in one detail: this rail steps by its own WIDTH (one slide is 100% of it),
      while the featured rail steps by the measured distance between two slides.
    */
    rails.forEach((rail) => {
      let dragging = false;
      let startX = 0;
      let startLeft = 0;
      let moved = 0;

      rail.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'mouse' || event.button !== 0) return;
        dragging = true;
        moved = 0;
        startX = event.clientX;
        startLeft = rail.scrollLeft;
      });

      rail.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const dx = event.clientX - startX;
        moved = Math.max(moved, Math.abs(dx));

        if (moved > 6) {
          // Claim the gesture only once it is clearly a drag, never on mousedown.
          if (!rail.hasAttribute('data-dragging')) {
            rail.setAttribute('data-dragging', '');
            rail.setPointerCapture(event.pointerId);
          }
          event.preventDefault();
          rail.scrollLeft = startLeft - dx;
        }
      });

      const endDrag = (event: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        rail.removeAttribute('data-dragging');
        if (rail.hasPointerCapture?.(event.pointerId)) {
          rail.releasePointerCapture(event.pointerId);
        }

        // Snap by hand — `data-dragging` disabled snap for the duration.
        if (moved > 6) {
          const s = rail.clientWidth;
          rail.scrollTo({ left: Math.round(rail.scrollLeft / s) * s, behavior: 'smooth' });
        }
      };

      rail.addEventListener('pointerup', endDrag);
      rail.addEventListener('pointercancel', endDrag);

      /* A drag must not also fire the click on the image beneath it. */
      rail.addEventListener(
        'click',
        (event) => {
          if (moved > 6) {
            event.preventDefault();
            event.stopPropagation();
            moved = 0;
          }
        },
        true,
      );

      /* An anchor drag ghost would fight the pointer drag above. */
      rail.addEventListener('dragstart', (event) => event.preventDefault());

      rail.setAttribute('data-ready', '');
    });
  }
</script>
