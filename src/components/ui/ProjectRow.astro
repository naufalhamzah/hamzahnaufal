---
/**
 * PROJECT ROW — the editorial entry used on /projects.
 *
 * WHY NOT THE CARD: a card frame at full page width rendered 1152px — a stack of
 * billboards for a list of eight. A row keeps the image a sensible share, puts
 * the text BESIDE it, and alternates sides down the page so the eye zig-zags. A
 * project with extra documentation also shows up to two supporting frames under
 * its hero, so a visitor sees a project's breadth without opening it.
 *
 * ONE SHAPE, ONE RATIO (16:10) for everything that is NOT a phone mockup.
 * Documents are letterboxed inside it, so a journal page and a dashboard share a
 * box without crop.
 *
 * IT DOES NOT HOLD FOR PHONE SCREENS: a 0.488-ratio phone fills only 30% of a
 * 16:10 box — measured in the row, 233px wide inside a 487px frame (~65% empty
 * matte). So a project whose ENTIRE image set is portrait screens renders WITHOUT
 * a frame: the device stands on the page at its own proportions. Mixed or
 * landscape/document sets keep the frame. The test is per PROJECT, not per image,
 * so a row never mixes framed and floating images.
 */
import type { ProjectEntry, MediaAsset } from '@/types/content';
import { PROJECT_CATEGORY_LABELS } from '@/types/content';
import { getImageDims } from '@/data/image-dims';
import { asset, withBase } from '@/utils/url';

interface Props {
  project: ProjectEntry;
  /** 1-based master-list index, so numbering is stable across pages. */
  index: number;
  /** Which side the image sits on. Alternated by the caller. */
  side?: 'left' | 'right';
}

const { project, index, side = 'left' } = Astro.props;

const num = String(index).padStart(2, '0');
const href = withBase(`/projects/${project.id}`);
const primary = project.categories[0];

/** Every image, hero first, de-duplicated — the hero is never repeated. */
const shots: MediaAsset[] = [
  project.visual,
  ...(project.gallery ?? []).filter((g) => g.src !== project.visual.src),
];

const hero = shots[0];
const supporting = shots.slice(1, 3);
const moreCount = Math.max(0, shots.length - 3);

/**
 * True only when every image the project owns is portrait, i.e. a device render.
 * Documents (`fit: 'contain'`) are excluded explicitly: a journal page is also
 * portrait, but it is a page read on a matte, not a device standing on the page.
 */
const isPortrait = (m: MediaAsset) => {
  const ar = m.width && m.height ? m.width / m.height : 1.5;
  return ar < 0.75 && m.fit !== 'contain';
};
const phones = shots.length > 0 && shots.every(isPortrait);

/**
 * The device ratio, read off the real image so the group's boxes match it. Kept
 * per-project rather than hardcoded: the ratio belongs to the export, and a
 * re-export at a different shape must not letterbox silently.
 */
const phoneAr =
  hero.width && hero.height ? (hero.width / hero.height).toFixed(4) : '0.488';

const dims =
  getImageDims(hero.src) ??
  (hero.width && hero.height ? ([hero.width, hero.height] as [number, number]) : null);

/**
 * How a SUPPORTING image fills its 16:9 cell: fill for a landscape photograph or
 * screenshot, letterbox for anything that must be seen whole — a document
 * (`fit: 'contain'`) or a portrait device render, which `cover` would slice down
 * the middle of the phone.
 */
const thumbFit = (m: MediaAsset) => {
  const ar = m.width && m.height ? m.width / m.height : 1.5;
  return ar >= 1.2 && m.fit !== 'contain' ? 'cover' : 'contain';
};
---

<article class:list={['pr', `pr--${side}`, phones && 'pr--phones']}>
  <div class="pr__inner">
    <div class="pr__media">
      {
        phones ? (
          /*
            PHONES STAND ON THE PAGE — no frame, no matte, no box. A 0.488-ratio
            device inside a 16:10 frame used about a third of the box's width, so
            two thirds of every "phone" row was empty plate; the renders are cut-outs
            with their own bezel and shadow, so the frame added nothing.
          */
          <div class="ph" style={`--phone-ar: ${phoneAr};`} data-lightbox-group>
            <div class="ph__viewport">
              <div
                class="ph__row"
                data-row-rail
                role="group"
                aria-label={`${shots.length} screens — swipe or use the arrows`}
                tabindex="0"
              >
                {shots.map((img, i) => {
                  const d =
                    getImageDims(img.src) ??
                    (img.width && img.height
                      ? ([img.width, img.height] as [number, number])
                      : null);
                  return (
                    <button
                      type="button"
                      class:list={['ph__item', i === 0 && 'ph__item--lead']}
                      data-lightbox-src={asset(img.src)}
                      data-lightbox-alt={img.alt}
                      data-lightbox-caption={img.caption ?? img.alt}
                      aria-label={`View larger: ${img.alt}`}
                    >
                      <img
                        src={asset(img.src)}
                        alt={img.alt}
                        width={d?.[0] ?? img.width}
                        height={d?.[1] ?? img.height}
                        loading="lazy"
                        decoding="async"
                      />
                    </button>
                  );
                })}
              </div>

              {shots.length > 1 && (
                <>
                  <button
                    type="button"
                    class="ph__arrow ph__arrow--prev"
                    data-row-prev
                    aria-label="Previous screen"
                    hidden
                  >
                    <span aria-hidden="true">‹</span>
                  </button>
                  <button
                    type="button"
                    class="ph__arrow ph__arrow--next"
                    data-row-next
                    aria-label="Next screen"
                    hidden
                  >
                    <span aria-hidden="true">›</span>
                  </button>
                </>
              )}
            </div>

            {shots.length > 1 && (
              <p class="ph__more mono" data-row-count hidden>
                <span data-row-index>1</span> / {shots.length}
              </p>
            )}

            <span class="pr__rule" aria-hidden="true" />
          </div>
        ) : (
          <>
            <figure
              class:list={[
                'pr__frame',
                hero.fit === 'contain' && 'pr__frame--contain',
              ]}
            >
              <img
                src={asset(hero.src)}
                alt={hero.alt}
                width={dims?.[0] ?? hero.width}
                height={dims?.[1] ?? hero.height}
                loading="lazy"
                decoding="async"
              />
              <span class="pr__rule" aria-hidden="true" />
            </figure>

            {supporting.length > 0 && (
              <div class="pr__strip">
                {supporting.map((img) => {
                  const d =
                    getImageDims(img.src) ??
                    (img.width && img.height
                      ? ([img.width, img.height] as [number, number])
                      : null);
                  return (
                    <figure class:list={['pr__thumb', thumbFit(img) === 'contain' && 'pr__thumb--contain']}>
                      <img
                        src={asset(img.src)}
                        alt={img.alt}
                        width={d?.[0] ?? img.width}
                        height={d?.[1] ?? img.height}
                        loading="lazy"
                        decoding="async"
                      />
                    </figure>
                  );
                })}

                {moreCount > 0 && (
                  <p class="pr__more mono">
                    +{moreCount} more
                    <span class="sr-only"> in this project's gallery</span>
                  </p>
                )}
              </div>
            )}
          </>
        )
      }
    </div>

    <!-- text -->
    <div class="pr__body">
      <p class="pr__meta">
        <span class="pr__num" aria-hidden="true">{num}</span>
        <span class="pr__cat mono">{PROJECT_CATEGORY_LABELS[primary]}</span>
        {project.year && <span class="pr__year mono">{project.year}</span>}
      </p>

      <h3 class="pr__title">
        <a href={href} class="pr__link">{project.title}</a>
      </h3>

      {project.subtitle && <p class="pr__sub mono">{project.subtitle}</p>}

      <p class="pr__tag">{project.tagline}</p>

      {project.role && (
        <p class="pr__role">
          <span class="pr__role-k mono">Role</span>
          {project.role}
        </p>
      )}

      {project.tools.length > 0 && (
        <ul class="pr__tools" aria-label={`Tools (${project.tools.length})`}>
          {project.tools.slice(0, 6).map((t) => (
            <li class="pr__tool mono">{t}</li>
          ))}
          {project.tools.length > 6 && (
            <li class="pr__tool pr__tool--more mono" aria-hidden="true">
              +{project.tools.length - 6}
            </li>
          )}
        </ul>
      )}

      {/*
        THE CTA IS A REAL LINK, and the title carries the stretched layer.

        It was a `<span>` — a control that looks pressable and is not, unreachable
        by keyboard and invisible to a screen reader's link list. Two links to one
        destination is intentional: the stretched layer makes the whole row
        clickable, and the CTA sits ABOVE it (z-index 3) for its own hover/focus.
      */}
      <a href={href} class="pr__cta">
        <span>View project</span>
        <span class="pr__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>

<style>
  .pr {
    position: relative;
  }

  .pr__inner {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 900px) {
    /* The image takes the larger share but never the whole width — the fix for
       "gambar terlalu besar". 1.25fr against 1fr puts it at ~55% of the row. */
    .pr__inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: clamp(1.75rem, 4vw, 3.5rem);
    }

    /* Alternate the sides so the list zig-zags instead of running down one edge. */
    .pr--right .pr__media {
      order: 2;
    }
  }

  .pr__media {
    min-width: 0;
  }

  .pr__frame {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: var(--hairline) solid var(--photo-edge);
    border-radius: var(--r-xs);
    background-color: var(--photo-mat);
    aspect-ratio: 16 / 10;
  }

  /*
    FILL BY DEFAULT — LETTERBOX ONLY WHAT MUST BE SEEN WHOLE. Both selectors used
    to hardcode `contain`: a 4:3 group photograph filled 83% of a 16:10 frame, and
    the inset took a bite more. The distinguishing rule already exists in the data
    — `fit: 'contain'` marks a document or a screen whose edges carry meaning;
    everything else fills.
  */
  .pr__frame img,
  .pr__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: var(--photo-filter);
    transition: transform var(--t-slow) var(--ease);
  }

  /* The letterbox, applied only where the image declares itself a document. */
  .pr__frame--contain img,
  .pr__thumb--contain img {
    object-fit: contain;
    object-position: center;
    padding: 0.7rem;
  }

  .pr:hover .pr__frame img {
    transform: scale(1.015);
  }

  /* The accent rule that wipes in on hover — the site's shared gesture. */
  .pr__rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background-color: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-slow) var(--ease);
  }

  .pr:hover .pr__rule,
  .pr:has(.pr__link:focus-visible) .pr__rule {
    transform: scaleX(1);
  }

  /* ---------------- supporting strip ---------------- */
  .pr__strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
    margin-top: 0.7rem;
    align-items: center;
  }

  .pr__thumb {
    margin: 0;
    overflow: hidden;
    border: var(--hairline) solid var(--photo-edge);
    border-radius: var(--r-xs);
    background-color: var(--photo-mat);
    /* A shorter frame than the hero, so the strip reads as supporting material
       rather than a second row of equal images. */
    aspect-ratio: 16 / 9;
  }

  .pr:hover .pr__thumb img {
    transform: scale(1.03);
  }

  .pr__more {
    grid-column: 2;
    align-self: center;
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.03em;
  }

  /* phone screens: no frame
     THE DEVICE IS THE PICTURE. These renders are cut-outs — transparent margin,
     their own bezel, screen and baked-in shadow — so a wrapper can only add a box
     around a phone that already looks like a phone. No border, matte, aspect box
     or hidden overflow.

     GRID WITH EXPLICIT PROPORTIONS, not flex with per-item heights: per-item
     `max-height` clamps tie the sizes to the VIEWPORT (`vh`), not the space the
     image column has — measured at 1440px the lead rendered 183x374, smaller than
     the plain framed screenshot on the next row. A grid whose COLUMN RATIOS mirror
     the size relationship (lead 1.5x the supporting columns) scales every phone
     from its column width at any viewport.

     `--phone-ar` comes from the frontmatter, read off the real image — the set's
     ratio is a property of the export, not of this stylesheet.
  */
  .ph {
    position: relative;
  }

  .ph__viewport {
    position: relative;
    overflow: visible;
  }

  /*
    A SWIPEABLE RAIL, not a static trio: the row previously showed three phones and
    a printed "+N more", so the rest of the set was unreachable and the pictures
    were not clickable at all.

    EVERY slide is the same size and ratio as the device. The previous grid made the
    lead 1.5x its neighbours — fine as a still trio, wrong in a rail where the
    visitor moves through ONE sequence and a screen 1.5x the others claims
    importance it does not have.
  */
  .ph__row {
    display: flex;
    align-items: flex-end;
    gap: clamp(0.7rem, 1.8vw, 1.4rem);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    /* Room for the drop-shadow — a scroll container clips its own overflow, and a
       shadow cut in a straight line reads as the box this change removed. */
    padding: 0.75rem 0.25rem 1.25rem;
    scroll-padding-inline: 0.25rem;
  }

  .ph__row::-webkit-scrollbar {
    display: none;
  }

  .ph__row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .ph__row[data-dragging] {
    scroll-snap-type: none;
    cursor: grabbing;
  }

  .ph__item {
    flex: 0 0 auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    width: clamp(7.5rem, 19vw, 11.5rem);
    aspect-ratio: var(--phone-ar, 0.488);
    scroll-snap-align: start;
    /*
      ABOVE THE ROW'S STRETCHED LINK (`z-index: 2`), which otherwise swallowed
      clicks on the pictures: measured with `elementFromPoint` over a device, the
      topmost element was `A.pr__link`, so the lightbox could never open. A picture
      is its own affordance, so it wins inside its own box; the CTA sits at the
      same level.
    */
    position: relative;
    z-index: 3;
  }

  .ph__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    /* Depth follows the ALPHA silhouette — the bezel, not a rectangle around it. */
    filter: var(--photo-filter) drop-shadow(0 2px 4px rgba(0, 0, 0, 0.34))
      drop-shadow(0 14px 30px rgba(0, 0, 0, 0.3));
    transition: transform var(--t-slow) var(--ease);
  }

  :global([data-theme='light']) .ph__item img {
    filter: var(--photo-filter) drop-shadow(0 2px 4px rgba(62, 46, 30, 0.18))
      drop-shadow(0 14px 28px rgba(62, 46, 30, 0.16));
  }

  .ph__item:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .ph__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-full);
    background-color: var(--surface);
    color: var(--fg);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      border-color var(--t-base) var(--ease),
      color var(--t-base) var(--ease),
      background-color var(--t-base) var(--ease),
      opacity var(--t-base) var(--ease);
  }

  /* `display: grid` would beat the `hidden` attribute; the state is owned by the
     script. */
  .ph__arrow[hidden] {
    display: none;
  }

  .ph__arrow:hover {
    border-color: var(--accent);
    color: var(--accent);
    background-color: var(--accent-soft);
  }

  .ph__arrow--prev {
    left: -1.1rem;
  }

  .ph__arrow--next {
    right: -1.1rem;
  }

  .ph__arrow[disabled] {
    opacity: 0.35;
    cursor: default;
    border-color: var(--border-faint);
    color: var(--fg-faint);
    background-color: var(--surface-2);
  }

  /* The counter replaces the old printed "+N more", a count of images the visitor
     had no way to reach. */
  .ph__more {
    margin-top: 0.4rem;
    text-align: center;
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .ph__more[hidden] {
    display: none;
  }

  /* The hover rule sits under the whole group, not under one phone. */
  .pr--phones .pr__rule {
    bottom: -1rem;
  }

  /* A single phone keeps the lead's column, so one device is never stretched
     across the whole media column. */
  .ph__row:not(:has(.ph__item:not(.ph__item--lead))) {
    grid-template-columns: minmax(0, 0.62fr);
    justify-content: start;
  }

  @media (max-width: 640px) {
    /* The rail keeps scrolling on a narrow screen — its whole point — but the
       slides shrink so more than one is visible, telling the visitor there is more. */
    .ph__item {
      width: clamp(7rem, 42vw, 9rem);
    }

    /* The arrows drop below the rail rather than covering the device. */
    .ph__arrow {
      position: static;
      transform: none;
      width: 2.6rem;
      height: 2.6rem;
    }

    .ph__viewport {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 0.6rem;
    }

    .ph__row {
      grid-column: 1 / -1;
      grid-row: 1;
      justify-content: center;
    }

    .ph__arrow--prev {
      grid-column: 1;
      grid-row: 2;
      justify-self: end;
    }

    .ph__arrow--next {
      grid-column: 3;
      grid-row: 2;
      justify-self: start;
    }
  }

  /* ---------------- text ---------------- */
  .pr__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .pr__meta {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    width: 100%;
  }

  .pr__num {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: 1;
    color: var(--accent);
  }

  .pr__cat {
    color: var(--fg-faint);
  }

  .pr__year {
    margin-inline-start: auto;
    color: var(--fg-faint);
  }

  .pr__title {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--fg-strong);
    transition: color var(--t-base) var(--ease);
  }

  .pr:hover .pr__title,
  .pr:has(.pr__link:focus-visible) .pr__title {
    color: var(--accent);
  }

  .pr__link {
    text-decoration: none;
    color: inherit;
  }

  /*
    THE STRETCHED LINK WAS BROKEN, AND THE MEASUREMENT SAYS WHY.

    `::after` was `position: absolute; inset: 0` on `.pr__link`, while `.pr__link`
    itself carried `position: relative`. That makes the pseudo cover the LINK's own
    box — measured 129x42px inside a 1152x530px row — so none of the card was
    clickable except the title. `elementFromPoint` over the image returned `IMG`.

    The fix is to drop the inline `position`, so the nearest positioned ancestor
    becomes `.pr` (`position: relative`) and `inset: 0` means the whole row.
    `z-index: 2` keeps it above the images; the rail's arrows and the CTA sit at 3.
  */
  .pr__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: var(--r-xs);
  }

  .pr__link:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .pr__sub {
    margin-top: 0.4rem;
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.03em;
  }

  .pr__tag {
    margin-top: 0.85rem;
    max-width: 48ch;
    color: var(--fg-muted);
  }

  .pr__role {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .pr__role-k {
    color: var(--fg-faint);
  }

  .pr__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.45rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .pr__tool {
    padding: 0.24rem 0.6rem;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-full);
    background-color: color-mix(in srgb, var(--surface-3) 55%, transparent);
    color: var(--fg-subtle);
    text-transform: none;
    letter-spacing: 0.03em;
    transition:
      border-color var(--t-fast) var(--ease),
      color var(--t-fast) var(--ease);
  }

  .pr__tool:first-child {
    border-color: var(--accent-line);
    color: var(--accent);
  }

  .pr:hover .pr__tool {
    border-color: var(--border-strong);
  }

  .pr:hover .pr__tool:first-child {
    border-color: var(--accent);
  }

  .pr__tool--more {
    border-style: dashed;
    color: var(--fg-faint);
  }

  .pr__cta {
    /* Above the stretched link's `z-index: 2`, so the CTA receives its own click
       and keyboard focus instead of being covered by the row's navigation layer. */
    position: relative;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-strong);
    text-decoration: none;
    transition: color var(--t-fast) var(--ease);
  }

  .pr__cta:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .pr:hover .pr__cta {
    color: var(--accent);
  }

  .pr__arrow {
    transition: transform var(--t-base) var(--ease);
  }

  .pr:hover .pr__arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .pr__frame img,
    .pr__thumb img,
    .pr__rule,
    .pr__arrow {
      transition: none;
    }

    .pr:hover .pr__frame img,
    .pr:hover .pr__thumb img,
    .pr:hover .pr__arrow {
      transform: none;
    }
  }
</style>

<script>
  /**
   * Row rail controls — progressive enhancement over the scroll-snap rail.
   *
   * The rail is a native horizontal scroller, so swipe, trackpad and keyboard
   * scrolling work before this script exists. It adds the arrows, the counter,
   * end-state disabling and mouse drag.
   */
  const rails = document.querySelectorAll<HTMLElement>('[data-row-rail]');

  if (rails.length) {
    rails.forEach((rail) => {
      const root = rail.closest('.ph__viewport');
      const wrap = rail.closest('.ph');
      const slides = Array.from(rail.children) as HTMLElement[];
      if (!root || !wrap || slides.length < 2) return;

      const prev = wrap.querySelector<HTMLButtonElement>('[data-row-prev]');
      const next = wrap.querySelector<HTMLButtonElement>('[data-row-next]');
      const counterWrap = wrap.querySelector<HTMLElement>('[data-row-count]');
      const counterIndex = wrap.querySelector<HTMLElement>('[data-row-index]');

      /** One step is the measured distance between two slides — includes the gap. */
      const step = () => slides[1].offsetLeft - slides[0].offsetLeft;

      const go = (dir: 1 | -1) => {
        rail.scrollBy({ left: step() * dir, behavior: 'smooth' });
      };

      let frame = 0;

      const sync = () => {
        frame = 0;
        const max = rail.scrollWidth - rail.clientWidth;
        const s = step();
        const index = s > 0 ? Math.round(rail.scrollLeft / s) : 0;
        const clamped = Math.min(Math.max(index, 0), slides.length - 1);

        /*
          Whether the rail actually has somewhere to go. Recomputed on resize,
          because a narrower window turns a fitting rail into a scrolling one.
        */
        const overflows = max > 4;
        if (prev) prev.hidden = !overflows;
        if (next) next.hidden = !overflows;
        if (counterWrap) counterWrap.hidden = !overflows;

        if (prev) prev.disabled = rail.scrollLeft <= 1;
        if (next) next.disabled = rail.scrollLeft >= max - 1;
        if (counterIndex) counterIndex.textContent = String(clamped + 1);
      };

      const schedule = () => {
        if (!frame) frame = requestAnimationFrame(sync);
      };

      rail.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);

      prev?.addEventListener('click', () => go(-1));
      next?.addEventListener('click', () => go(1));

      /*
        MOUSE DRAG — native scroll containers do not drag with a mouse. Touch is
        left to the browser on purpose: hijacking it costs the platform's momentum
        and rubber-banding. The 6px threshold keeps a plain CLICK working.
      */
      let dragging = false;
      let startX = 0;
      let startLeft = 0;
      let moved = 0;

      rail.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'mouse' || event.button !== 0) return;
        dragging = true;
        moved = 0;
        startX = event.clientX;
        startLeft = rail.scrollLeft;
      });

      rail.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const dx = event.clientX - startX;
        moved = Math.max(moved, Math.abs(dx));

        if (moved > 6) {
          if (!rail.hasAttribute('data-dragging')) {
            rail.setAttribute('data-dragging', '');
            rail.setPointerCapture(event.pointerId);
          }
          event.preventDefault();
          rail.scrollLeft = startLeft - dx;
        }
      });

      const endDrag = (event: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        rail.removeAttribute('data-dragging');
        if (rail.hasPointerCapture?.(event.pointerId)) {
          rail.releasePointerCapture(event.pointerId);
        }

        if (moved > 6) {
          const s = step();
          rail.scrollTo({ left: Math.round(rail.scrollLeft / s) * s, behavior: 'smooth' });

        }
      };

      /*
        RESET `moved` ON THE NEXT GESTURE, not after the current one.

        `moved` swallows the click that ends a drag, and the click handler below
        clears it — but a drag that ends OUTSIDE the rail (pointerup on the page, or
        a cancelled gesture) fires no click, so `moved` stayed above the threshold
        and the NEXT genuine click was swallowed. Listening on the wrapper `.ph`
        rather than the rail matters: the arrows live outside the rail.
      */
      wrap.addEventListener('pointerdown', () => {
        moved = 0;
      });

      rail.addEventListener('pointerup', endDrag);
      rail.addEventListener('pointercancel', endDrag);

      /* A drag must not also open the lightbox underneath it. */
      rail.addEventListener(
        'click',
        (event) => {
          if (moved > 6) {
            event.preventDefault();
            event.stopPropagation();
            moved = 0;
          }
        },
        true,
      );

      rail.addEventListener('dragstart', (event) => event.preventDefault());

      sync();
    });
  }
</script>
