---
/**
 * PROJECT ROW — the editorial entry used on /projects.
 *
 * WHY NOT THE CARD
 * The card is built for a grid of equals: one frame, one block of text beneath.
 * At full page width that frame rendered 1152px wide, which is a very large
 * image for a list of eight — the page became a stack of billboards, and the
 * user asked for something more editorial and less oversized.
 *
 * A row changes the reading model. The image keeps a sensible share of the
 * width, the text sits BESIDE it, and the two alternate sides down the page so
 * the eye zig-zags rather than running straight down one column. That is what
 * makes a long list readable: rhythm, not repetition.
 *
 * THE SUPPORTING STRIP
 * A project with extra documentation shows its hero plus up to two smaller
 * frames beneath it. That is the "featured image, then supporting images"
 * composition, and it means a visitor can see the breadth of a project without
 * opening it — while still keeping the page far shorter than one large image per
 * project would.
 *
 * ONE SHAPE, ONE RATIO — for everything that is NOT a phone mockup.
 *
 * The frame is 16:10 and documents are letterboxed inside it, so a journal page
 * and a dashboard sit in the same box without either being cropped. That rule
 * still holds for screenshots and documents.
 *
 * IT DOES NOT HOLD FOR PHONE SCREENS, and forcing it there was the mistake.
 *
 * The user's report: "jangan kotak kotak begini. buat tampilannya menarik,
 * langsung bentuk hp nya saja" — do not box these, just show the phone. They were
 * right, and the numbers say why. A 0.488-ratio phone inside a 16:10 frame fills
 * only 30% of the box's width; measured in the row, the phone rendered 233px
 * wide inside a 487px frame, so roughly 65% of the frame was empty matte. The box
 * was doing nothing except making a phone look like a small picture of a phone.
 *
 * So a project whose ENTIRE image set is portrait screens (which is every device
 * render in this portfolio — they are exported as cut-outs with their own bezel
 * and shadow) renders WITHOUT a frame: the device stands directly on the page at
 * its own proportions, at a size that is actually readable. Mixed or
 * landscape/document sets keep the frame exactly as before.
 *
 * The test is per PROJECT, not per image: a row that framed some images and let
 * others float would be less consistent, not more.
 */
import type { ProjectEntry, MediaAsset } from '@/types/content';
import { PROJECT_CATEGORY_LABELS } from '@/types/content';
import { getImageDims } from '@/data/image-dims';

interface Props {
  project: ProjectEntry;
  /** 1-based master-list index, so numbering is stable across pages. */
  index: number;
  /** Which side the image sits on. Alternated by the caller. */
  side?: 'left' | 'right';
}

const { project, index, side = 'left' } = Astro.props;

const num = String(index).padStart(2, '0');
const href = `/projects/${project.id}`;
const primary = project.categories[0];

/** Every image, hero first, de-duplicated — the hero is never repeated. */
const shots: MediaAsset[] = [
  project.visual,
  ...(project.gallery ?? []).filter((g) => g.src !== project.visual.src),
];

const hero = shots[0];
const supporting = shots.slice(1, 3);
const moreCount = Math.max(0, shots.length - 3);

/**
 * Is this project a set of PHONE SCREENS?
 *
 * True only when every image it owns is portrait, which in practice means every
 * one is a device render. Documents (`fit: 'contain'`) are excluded explicitly:
 * a journal page is also portrait, but it is a page to be read on a matte, not a
 * device to stand on the page.
 */
const isPortrait = (m: MediaAsset) => {
  const ar = m.width && m.height ? m.width / m.height : 1.5;
  return ar < 0.75 && m.fit !== 'contain';
};
const phones = shots.length > 0 && shots.every(isPortrait);

/**
 * The device ratio, read off the real image so the group's boxes match it.
 *
 * Kept per-project rather than hardcoded in the stylesheet: the ratio belongs to
 * the export, and a re-export at a different shape would otherwise be letterboxed
 * inside boxes that still assumed the old one.
 */
const phoneAr =
  hero.width && hero.height ? (hero.width / hero.height).toFixed(4) : '0.488';

const dims =
  getImageDims(hero.src) ??
  (hero.width && hero.height ? ([hero.width, hero.height] as [number, number]) : null);
---

<article class:list={['pr', `pr--${side}`, phones && 'pr--phones']}>
  <div class="pr__inner">
    <!-- ---------------- visual ---------------- -->
    <div class="pr__media">
      {
        phones ? (
          /*
            PHONES STAND ON THE PAGE — no frame, no matte, no box.

            See the note at the top of this file: a 0.488-ratio device inside a
            16:10 frame used about a third of the box's width, so two thirds of
            every "phone" row was empty plate. The device renders are cut-outs
            with their own bezel and shadow, so the frame was adding nothing.
          */
          <div class="ph" style={`--phone-ar: ${phoneAr};`}>
            <div class="ph__row">
              <figure class="ph__item ph__item--lead">
                <img
                  src={hero.src}
                  alt={hero.alt}
                  width={dims?.[0] ?? hero.width}
                  height={dims?.[1] ?? hero.height}
                  loading="lazy"
                  decoding="async"
                />
              </figure>

              {supporting.map((img) => {
                const d =
                  getImageDims(img.src) ??
                  (img.width && img.height
                    ? ([img.width, img.height] as [number, number])
                    : null);
                return (
                  <figure class="ph__item">
                    <img
                      src={img.src}
                      alt={img.alt}
                      width={d?.[0] ?? img.width}
                      height={d?.[1] ?? img.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                );
              })}
            </div>

            {moreCount > 0 && (
              <p class="ph__more mono">
                +{moreCount} more
                <span class="sr-only"> in this project's gallery</span>
              </p>
            )}

            <span class="pr__rule" aria-hidden="true" />
          </div>
        ) : (
          <>
            <figure class="pr__frame">
              <img
                src={hero.src}
                alt={hero.alt}
                width={dims?.[0] ?? hero.width}
                height={dims?.[1] ?? hero.height}
                loading="lazy"
                decoding="async"
              />
              <span class="pr__rule" aria-hidden="true" />
            </figure>

            {supporting.length > 0 && (
              <div class="pr__strip">
                {supporting.map((img) => {
                  const d =
                    getImageDims(img.src) ??
                    (img.width && img.height
                      ? ([img.width, img.height] as [number, number])
                      : null);
                  return (
                    <figure class="pr__thumb">
                      <img
                        src={img.src}
                        alt={img.alt}
                        width={d?.[0] ?? img.width}
                        height={d?.[1] ?? img.height}
                        loading="lazy"
                        decoding="async"
                      />
                    </figure>
                  );
                })}

                {moreCount > 0 && (
                  <p class="pr__more mono">
                    +{moreCount} more
                    <span class="sr-only"> in this project's gallery</span>
                  </p>
                )}
              </div>
            )}
          </>
        )
      }
    </div>

    <!-- ---------------- text ---------------- -->
    <div class="pr__body">
      <p class="pr__meta">
        <span class="pr__num" aria-hidden="true">{num}</span>
        <span class="pr__cat mono">{PROJECT_CATEGORY_LABELS[primary]}</span>
        {project.year && <span class="pr__year mono">{project.year}</span>}
      </p>

      <h3 class="pr__title">
        <a href={href} class="pr__link">{project.title}</a>
      </h3>

      {project.subtitle && <p class="pr__sub mono">{project.subtitle}</p>}

      <p class="pr__tag">{project.tagline}</p>

      {project.role && (
        <p class="pr__role">
          <span class="pr__role-k mono">Role</span>
          {project.role}
        </p>
      )}

      {project.tools.length > 0 && (
        <ul class="pr__tools" aria-label={`Tools (${project.tools.length})`}>
          {project.tools.slice(0, 6).map((t) => (
            <li class="pr__tool mono">{t}</li>
          ))}
          {project.tools.length > 6 && (
            <li class="pr__tool pr__tool--more mono" aria-hidden="true">
              +{project.tools.length - 6}
            </li>
          )}
        </ul>
      )}

      <span class="pr__cta">
        <span>View project</span>
        <span class="pr__arrow" aria-hidden="true">→</span>
      </span>
    </div>
  </div>
</article>

<style>
  .pr {
    position: relative;
  }

  .pr__inner {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 900px) {
    /*
      The image takes the larger share but never the whole width — that is the
      fix for "gambar terlalu besar". 1.25fr against 1fr puts it at roughly 55%
      of the row, which is a comfortable size for a screenshot and leaves the text
      a real column rather than a caption.
    */
    .pr__inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: clamp(1.75rem, 4vw, 3.5rem);
    }

    /* Alternate the sides so the list zig-zags instead of running down one edge. */
    .pr--right .pr__media {
      order: 2;
    }
  }

  /* ---------------- media ---------------- */
  .pr__media {
    min-width: 0;
  }

  .pr__frame {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: var(--hairline) solid var(--photo-edge);
    border-radius: var(--r-xs);
    background-color: var(--photo-mat);
    aspect-ratio: 16 / 10;
  }

  /* Documents are letterboxed, not cropped — their meaning is at the edges. */
  .pr__frame img,
  .pr__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    padding: 0.7rem;
    filter: var(--photo-filter);
    transition: transform var(--t-slow) var(--ease);
  }

  .pr:hover .pr__frame img {
    transform: scale(1.015);
  }

  /* The accent rule that wipes in on hover — the site's shared gesture. */
  .pr__rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background-color: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-slow) var(--ease);
  }

  .pr:hover .pr__rule,
  .pr:has(.pr__link:focus-visible) .pr__rule {
    transform: scaleX(1);
  }

  /* ---------------- supporting strip ---------------- */
  .pr__strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
    margin-top: 0.7rem;
    align-items: center;
  }

  .pr__thumb {
    margin: 0;
    overflow: hidden;
    border: var(--hairline) solid var(--photo-edge);
    border-radius: var(--r-xs);
    background-color: var(--photo-mat);
    /* A shorter frame than the hero, so the strip reads as supporting material
       rather than a second row of equal images. */
    aspect-ratio: 16 / 9;
  }

  .pr:hover .pr__thumb img {
    transform: scale(1.03);
  }

  .pr__more {
    grid-column: 2;
    align-self: center;
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.03em;
  }

  /* ---------------- phone screens: no frame ---------------- */
  /*
    THE DEVICE IS THE PICTURE.

    These renders are cut-outs — transparent margin, their own bezel, screen and
    baked-in shadow — so the only thing a wrapper can add is a box around a phone
    that already looks like a phone. The frame is gone entirely: no border, no
    matte, no aspect-ratio box, no hidden overflow.

    GRID WITH EXPLICIT PROPORTIONS, not flex with per-item heights.

    The first attempt gave the lead and the supporting pair separate `max-height`
    clamps. That ties the sizes to the VIEWPORT (`vh`) rather than to the space the
    image column actually has, and the two drifted: measured at 1440px the lead
    rendered 183x374 — smaller than the plain framed screenshot on the next row —
    while a short window shrank it further still.

    A grid whose COLUMN RATIOS mirror the size relationship removes the
    guesswork: the lead's column is 1.5x the supporting columns, so the lead is
    1.5x their width and therefore 1.5x their height. Every phone scales from the
    column width, so the group fills the media column at any viewport instead of
    floating small in the middle of it.

    `--phone-ar` comes from the frontmatter, read off the real image. It is not
    hardcoded because the set's ratio is a property of the export, not of this
    stylesheet — a re-export at a different shape must not letterbox silently.
  */
  .ph {
    position: relative;
  }

  .ph__row {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    align-items: end;
    gap: clamp(0.7rem, 1.8vw, 1.4rem);
    min-width: 0;
  }

  .ph__item {
    margin: 0;
    min-width: 0;
    aspect-ratio: var(--phone-ar, 0.488);
    /* A ceiling for very wide windows, where 1.5fr of a broad column would
       otherwise render a phone taller than the viewport. */
    max-height: 36rem;
  }

  .ph__item img {
    display: block;
    width: 100%;
    height: 100%;
    /* `contain` with a bottom anchor: if the ceiling caps the height, the device
       letterboxes horizontally rather than stretching, and it stays ON the row's
       baseline instead of floating up from it. */
    object-fit: contain;
    object-position: center bottom;
    /* Depth follows the ALPHA silhouette — the bezel, not a rectangle around it. */
    filter: var(--photo-filter) drop-shadow(0 2px 4px rgba(0, 0, 0, 0.34))
      drop-shadow(0 14px 30px rgba(0, 0, 0, 0.3));
    transition: transform var(--t-slow) var(--ease);
  }

  :global([data-theme='light']) .ph__item img {
    filter: var(--photo-filter) drop-shadow(0 2px 4px rgba(62, 46, 30, 0.18))
      drop-shadow(0 14px 28px rgba(62, 46, 30, 0.16));
  }

  .pr:hover .ph__item--lead img {
    transform: translateY(-4px);
  }

  .ph__more {
    margin-top: 1rem;
    text-align: center;
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.03em;
  }

  /* The hover rule sits under the whole group, not under one phone. */
  .pr--phones .pr__rule {
    bottom: -1rem;
  }

  /* A single phone (no supporting images) keeps the lead's column, so one device
     is never stretched across the whole media column. */
  .ph__row:not(:has(.ph__item:not(.ph__item--lead))) {
    grid-template-columns: minmax(0, 0.62fr);
    justify-content: start;
  }

  @media (max-width: 640px) {
    /* Three phones will not fit a narrow column; the group becomes one column of
       equal phones, which keeps every device the same readable size. */
    .ph__row,
    .ph__row:not(:has(.ph__item:not(.ph__item--lead))) {
      grid-template-columns: minmax(0, 1fr);
      justify-content: center;
    }

    .ph__item {
      max-height: none;
      max-width: 15rem;
      margin-inline: auto;
    }
  }

  /* ---------------- text ---------------- */
  .pr__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .pr__meta {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    width: 100%;
  }

  .pr__num {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: 1;
    color: var(--accent);
  }

  .pr__cat {
    color: var(--fg-faint);
  }

  .pr__year {
    margin-inline-start: auto;
    color: var(--fg-faint);
  }

  .pr__title {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--fg-strong);
    transition: color var(--t-base) var(--ease);
  }

  .pr:hover .pr__title,
  .pr:has(.pr__link:focus-visible) .pr__title {
    color: var(--accent);
  }

  .pr__link {
    position: relative;
    text-decoration: none;
    color: inherit;
  }

  /* A stretched link covers the whole row, so clicking anywhere navigates. */
  .pr__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: var(--r-xs);
  }

  .pr__link:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .pr__sub {
    margin-top: 0.4rem;
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.03em;
  }

  .pr__tag {
    margin-top: 0.85rem;
    max-width: 48ch;
    color: var(--fg-muted);
  }

  .pr__role {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .pr__role-k {
    color: var(--fg-faint);
  }

  .pr__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.45rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .pr__tool {
    padding: 0.24rem 0.6rem;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-full);
    background-color: color-mix(in srgb, var(--surface-3) 55%, transparent);
    color: var(--fg-subtle);
    text-transform: none;
    letter-spacing: 0.03em;
    transition:
      border-color var(--t-fast) var(--ease),
      color var(--t-fast) var(--ease);
  }

  .pr__tool:first-child {
    border-color: var(--accent-line);
    color: var(--accent);
  }

  .pr:hover .pr__tool {
    border-color: var(--border-strong);
  }

  .pr:hover .pr__tool:first-child {
    border-color: var(--accent);
  }

  .pr__tool--more {
    border-style: dashed;
    color: var(--fg-faint);
  }

  .pr__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-strong);
    transition: color var(--t-fast) var(--ease);
  }

  .pr:hover .pr__cta {
    color: var(--accent);
  }

  .pr__arrow {
    transition: transform var(--t-base) var(--ease);
  }

  .pr:hover .pr__arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .pr__frame img,
    .pr__thumb img,
    .pr__rule,
    .pr__arrow {
      transition: none;
    }

    .pr:hover .pr__frame img,
    .pr:hover .pr__thumb img,
    .pr:hover .pr__arrow {
      transform: none;
    }
  }
</style>
