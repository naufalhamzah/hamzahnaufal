---
/**
 * SECTION HEAD — the shared masthead for a homepage preview section: an indexed
 * eyebrow, a title, and a link through to the full page.
 *
 * The `index` is decorative ("01", "02"…) and gives the homepage its editorial
 * numbering rhythm.
 */

interface Props {
  index: string;
  eyebrow: string;
  title: string;
  /** Optional one-line description under the title. */
  lede?: string;
  /** Where the "see all" link goes. */
  href?: string;
  /** Label for that link. */
  linkLabel?: string;
  /** Optional mono note beside the link, e.g. "8 projects". */
  note?: string;
  /** Renders the title larger — used for the most important sections. */
  emphasis?: boolean;
}

const {
  index,
  eyebrow,
  title,
  lede,
  href,
  linkLabel = 'See all',
  note,
  emphasis = false,
} = Astro.props;
---

<header class:list={['sh', emphasis && 'sh--emphasis']}>
  <div class="sh__main">
    <p class="sh__eyebrow label">
      <span class="sh__idx" aria-hidden="true">{index}</span>
      {eyebrow}
    </p>
    <h2 class="sh__title">{title}</h2>
    {lede && <p class="sh__lede">{lede}</p>}
  </div>

  {
    href && (
      <div class="sh__act">
        {/*
          A bordered button, not a text link: the homepage is a preview and the
          full set lives on its own page, so the hand-off must read as clickable
          at a glance.
        */}
        <a href={href} class="sh__more">
          <span class="sh__more-label">{linkLabel}</span>
          {note && <span class="sh__more-note mono">{note}</span>}
          <span class="sh__more-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    )
  }
</header>

<style>
  .sh {
    display: grid;
    gap: 1.25rem;
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
    border-bottom: var(--hairline) solid var(--border);
  }

  @media (min-width: 800px) {
    .sh {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 2rem;
    }
  }

  .sh__eyebrow {
    margin-bottom: 0.8rem;
  }

  .sh__idx {
    color: var(--fg-faint);
    margin-inline-end: 0.6rem;
  }

  .sh__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.022em;
    color: var(--fg-strong);
  }

  /* The two most important previews get a larger title — hierarchy without a
     layout change. */
  .sh--emphasis .sh__title {
    font-size: var(--text-4xl);
  }

  .sh__lede {
    margin-top: 0.8rem;
    max-width: 56ch;
    font-size: var(--text-base);
    color: var(--fg-muted);
  }

  .sh__act {
    flex: none;
  }

  .sh__more {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.1rem;
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-xs);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-strong);
    white-space: nowrap;
    transition:
      border-color var(--t-base) var(--ease),
      background-color var(--t-base) var(--ease),
      color var(--t-base) var(--ease);
  }

  .sh__more:hover {
    border-color: var(--accent);
    background-color: var(--accent-soft);
    color: var(--accent);
  }

  .sh__more-note {
    padding-inline-start: 0.55rem;
    border-inline-start: var(--hairline) solid var(--border-faint);
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .sh__more:hover .sh__more-note {
    color: var(--accent);
  }

  .sh__more-arrow {
    font-size: 0.95rem;
    transition: transform var(--t-base) var(--ease);
  }

  .sh__more:hover .sh__more-arrow {
    transform: translateX(4px);
  }

  /* Full-width on narrow screens so the button is a comfortable tap target. */
  @media (max-width: 799px) {
    .sh__more {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
