---
/**
 * COLLAGE — an asymmetric image composition that adapts to how many images it
 * is given. A plain grid cannot: this switches composition from the item count
 * and the natural aspect ratio of each image.
 *
 * LAYOUTS (chosen automatically from the item count):
 *   1 image   full-bleed single frame
 *   2 images  large left + tall right (or two halves if one is portrait)
 *   3 images  large feature + two stacked beside it
 *   4+ images  feature + a 2-up column, then a balanced row for the rest
 *
 * Every image keeps its NATURAL aspect ratio via object-fit: cover inside a
 * fixed frame; the first item is treated as the hero.
 */
import type { MediaAsset } from '@/types/content';
import { asset } from '@/utils/url';

interface Props {
  images: MediaAsset[];
  /** Optional caption rendered under the whole collage. */
  caption?: string;
  /** Tighter gaps for use inside a card. */
  dense?: boolean;
  /**
   * Present narrow screenshots as device mockups (see ShotSlider): on UI/UX
   * case studies a phone capture should read as a mobile product.
   */
  mockup?: boolean;
}

const { images, caption, dense = false, mockup = false } = Astro.props;

/** A cell is a device mockup only when the image is genuinely portrait. */
const asMockup = (m: MediaAsset) => {
  if (!mockup) return false;
  const ar = m.width && m.height ? m.width / m.height : 1.5;
  /* Same rule as ShotSlider: a portrait DOCUMENT is not a phone render. */
  return ar < 0.75 && m.fit !== 'contain';
};

const n = images.length;

/**
 * Pick the composition from the count — AND from the shapes.
 *
 * The count alone produced a bad result for a set of four LANDSCAPE dashboard
 * screenshots: they fell into lead-plus-stack, whose tall lead frame (row-span 2,
 * ratio auto) crops a 16:9 dashboard via `cover` — the figures it exists to show
 * were half gone. A set whose images all share a landscape orientation gets a
 * UNIFORM grid instead: equal cells, all at the images' own ratio, none tall.
 */
const isLandscape = (m: MediaAsset) => {
  const ar = m.width && m.height ? m.width / m.height : 1.5;
  return ar >= 1.2;
};
/** Portrait, and therefore a phone screen rather than a document or a photo. */
const isPortrait = (m: MediaAsset) => {
  const ar = m.width && m.height ? m.width / m.height : 1.5;
  return ar < 0.75;
};
const allLandscape = images.every((m) => isLandscape(m) || m.fit === 'contain');
const allPortrait = images.every((m) => isPortrait(m) && m.fit !== 'contain');

/*
  A set of PORTRAIT phone screens is its own composition, and the count-based
  layouts actively damage it.

  Measured on a three-screen app gallery under `trio`: the two non-lead cells
  rendered their device shells at 101x234px — the bezel is most of that and the
  interface inside is unreadable.

  Phone screens want a ROW OF PHONES: equal columns, each cell at the phone's own
  ratio. Same principle as the landscape `uniform` case, applied to the other
  orientation.
*/
const portraitRow = allPortrait && n >= 3;

const layout =
  n <= 1
    ? 'single'
    : n === 2
      ? 'duo'
      : portraitRow
        ? 'screens'
        : n === 3
          ? 'trio'
        : allLandscape
          ? 'uniform'
          : 'many';
/** Everything after the first three goes into the trailing row. */
const rest = layout === 'many' ? images.slice(3) : [];

/**
 * For a duo, the frame ratio comes from the images themselves — a fixed ratio is
 * a crop, and the crop removed the group photograph's banner. Clamped, because an
 * extreme pair (tall portrait beside a wide panorama) would otherwise produce a
 * frame so far from either that `cover` crops them heavily anyway. Documents
 * (`fit: 'contain'`) are excluded — they are letterboxed, so frame shape does not
 * matter.
 */
/**
 * For a uniform grid the frame ratio is the images' own, clamped only to guard
 * against a stray non-landscape file. Typed through a local rather than `!`
 * non-null assertions: `astro check` fails to parse a frontmatter containing them
 * and then silently reads the whole `<style>` block as TypeScript, reporting ~200
 * bogus errors ("Cannot find name 'grid'").
 */
const uniformRatio = (() => {
  const first = images.find((m) => m.width && m.height);
  if (!first || !first.width || !first.height) return '16 / 9';
  const ar = first.width / first.height;
  /*
    Portrait sets use this too — a row of phones shares one ratio exactly as a set
    of dashboards does — so the clamp spans both orientations.
  */
  return String(Math.min(Math.max(ar, 0.4), 2.2).toFixed(3));
})();

/**
 * The ratio for a DEVICE cell, from the device image itself.
 *
 * Set on every layout, not just `screens`/`uniform`: a device can appear in any
 * composition (Kedai Nyam mixes two desktop screens with two phones under `trio`),
 * and a device cell falling back to the generic `--uniform-ratio` default would be
 * letterboxed inside a box of the wrong shape.
 */
const deviceRatio = (() => {
  const dev = images.find((m) => {
    const ar = m.width && m.height ? m.width / m.height : 1.5;
    return ar < 0.75 && m.fit !== 'contain';
  });
  if (!dev || !dev.width || !dev.height) return uniformRatio;
  return (dev.width / dev.height).toFixed(4);
})();

const duoRatio = (() => {
  if (layout !== 'duo') return '4 / 3';
  const ars = images
    .slice(0, 2)
    .filter((m) => m.fit !== 'contain')
    .map((m) => (m.width && m.height ? m.width / m.height : 4 / 3));
  if (ars.length < 2) return '4 / 3';
  const avg = ars.reduce((a, b) => a + b, 0) / ars.length;
  return String(Math.min(Math.max(avg, 1.1), 1.9).toFixed(3));
})();
---

{
  n > 0 && (
    <figure
      class:list={['collage', `collage--${layout}`, dense && 'collage--dense']}
      style={`--device-ratio: ${deviceRatio};${
        layout === 'duo'
          ? ` --duo-ratio: ${duoRatio};`
          : layout === 'uniform' || layout === 'screens'
            ? ` --uniform-ratio: ${uniformRatio};`
            : ''
      }`}
    >
      {
        layout === 'screens' ? (
          /*
            A SWIPEABLE RAIL — the gallery is interactive, not a static wall. A
            wrapped grid of six phones asks the visitor to scan; a rail asks them
            to move through what is an ordered sequence.

            Scroll-snap does the work natively, so touch swipe, trackpad and
            keyboard scrolling all function before any script runs.
          */
          <div class="collage__viewport">
            <div
              class="collage__rail"
              data-gallery-rail
              role="group"
              aria-label={`${images.length} screens — swipe or use the arrows`}
              tabindex="0"
            >
              {images.map((img) => (
                <button
                  type="button"
                  class:list={['collage__cell', 'collage__cell--slide']}
                  data-lightbox-src={asset(img.src)}
                  data-lightbox-alt={img.alt}
                  data-lightbox-caption={img.caption ?? img.alt}
                  aria-label={`View larger: ${img.alt}`}
                >
                  <span class="collage__device">
                    <img
                      src={asset(img.src)}
                      alt={img.alt}
                      width={img.width}
                      height={img.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  {img.caption && <span class="collage__cap">{img.caption}</span>}
                </button>
              ))}
            </div>

            <button
              type="button"
              class="collage__arrow collage__arrow--prev"
              data-gallery-prev
              aria-label="Previous screen"
              hidden
            >
              <span aria-hidden="true">‹</span>
            </button>
            <button
              type="button"
              class="collage__arrow collage__arrow--next"
              data-gallery-next
              aria-label="Next screen"
              hidden
            >
              <span aria-hidden="true">›</span>
            </button>

            <span class="collage__count mono" data-gallery-count aria-hidden="true" hidden>
              1 / {images.length}
            </span>
          </div>
        ) : (
          <div class="collage__grid">
            {images.slice(0, layout === 'many' ? 3 : n).map((img, i) => (
              <button
                type="button"
                class:list={[
                  'collage__cell',
                  i === 0 && 'collage__cell--lead',
                  img.fit === 'contain' && 'collage__cell--contain',
                ]}
                data-lightbox-src={asset(img.src)}
                data-lightbox-alt={img.alt}
                data-lightbox-caption={img.caption ?? img.alt}
                aria-label={`View larger: ${img.alt}`}
              >
                {asMockup(img) ? (
                  <span class="collage__device">
                    <img
                      src={asset(img.src)}
                      alt={img.alt}
                      width={img.width}
                      height={img.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                ) : (
                  <img
                    src={asset(img.src)}
                    alt={img.alt}
                    width={img.width}
                    height={img.height}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                {img.caption && <span class="collage__cap">{img.caption}</span>}
              </button>
            ))}
          </div>
        )
      }

      {rest.length > 0 && (
        <div class="collage__rest" data-count={rest.length}>
          {rest.map((img) => (
            <button
              type="button"
              class:list={[
                'collage__cell',
                'collage__cell--small',
                img.fit === 'contain' && 'collage__cell--contain',
              ]}
              data-lightbox-src={asset(img.src)}
              data-lightbox-alt={img.alt}
              data-lightbox-caption={img.caption ?? img.alt}
              aria-label={`View larger: ${img.alt}`}
            >
              <img
                src={asset(img.src)}
                alt={img.alt}
                width={img.width}
                height={img.height}
                loading="lazy"
                decoding="async"
              />
            </button>
          ))}
        </div>
      )}

      {caption && <figcaption class="collage__note mono">{caption}</figcaption>}
    </figure>
  )
}

<style>
  .collage {
    margin: 0;
  }

  .collage__grid {
    display: grid;
    gap: var(--collage-gap, clamp(0.5rem, 1.2vw, 0.9rem));
  }

  .collage--dense {
    --collage-gap: 0.5rem;
  }

  .collage__cell {
    position: relative;
    display: block;
    overflow: hidden;
    padding: 0;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-xs);
    background-color: var(--surface-2);
    cursor: zoom-in;
  }

  .collage__cell img {
    display: block;
    width: 100%;
    height: 100%;
    /* Anchor the crop to the TOP: a centred crop of a standing group cuts the
       heads off and keeps the floor. */
    object-fit: cover;
    object-position: center top;
    transition: transform var(--t-slow) var(--ease);
  }

  .collage__cell:hover img {
    transform: scale(1.03);
  }

  /* Documents are letterboxed, not cropped: `cover` loses the masthead and title
     block, so the page stops being evidence of what it illustrates. */
  .collage__cell--contain img {
    object-fit: contain;
    object-position: center;
    padding: 0.6rem;
  }

  .collage__cell--contain:hover img {
    transform: none;
  }

  /* device mockup
     THE RENDER IS THE PHONE — this wrapper adds NO hardware of its own. Every
     capture that ships here is a full device render with its own bezel and shadow,
     so a drawn shell would be a SECOND rectangle around an existing one. What
     remains is a transparent layout box: it reserves space, sizes from the device's
     own ratio and centres the render. Depth comes from a `drop-shadow` on the image,
     which follows the alpha silhouette rather than a rectangle. */
  .collage__device {
    display: block;
    position: relative;
    height: calc(100% - 1.4rem);
    aspect-ratio: 9 / 19.5;
    max-width: 100%;
    margin: 0 auto;
    padding: 0;
    border: 0;
    border-radius: 0;
    background-color: transparent;
    overflow: visible;
  }

  /* NO DRAWN NOTCH — a `::before` pill was proven a defect by A/B: forcing the
     rule off changed 76701 pixels (peak delta 52) in a band across the top. The
     captures already carry their own dynamic island, so the drawn pill sat above
     it, reading as two holes in one phone. A shell is only correct for a BARE
     screen capture; none is in this set. */

  .collage__device img {
    width: 100%;
    height: 100%;
    /* `contain` shows the device whole; the render supplies its own corners. */
    border-radius: 0;
    object-fit: contain;
    object-position: center bottom;
    padding: 0;
    /* Depth follows the ALPHA silhouette — the bezel, not a rectangle around it. */
    filter: var(--photo-filter) drop-shadow(0 2px 4px rgba(0, 0, 0, 0.34))
      drop-shadow(0 14px 30px rgba(0, 0, 0, 0.3));
  }

  :global([data-theme='light']) .collage__device img {
    filter: var(--photo-filter) drop-shadow(0 2px 4px rgba(62, 46, 30, 0.18))
      drop-shadow(0 14px 28px rgba(62, 46, 30, 0.16));
  }

  .collage__device img,
  .collage__cell:hover .collage__device img {
    transform: none;
  }

  .collage__cell:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* ANY cell holding a device render loses its box — a rule about the CONTENT,
     not the layout, or mixed sets keep the defect: on Kedai Nyam the phones had
     the box removed while the neighbouring desktop screenshots kept their frames.
     A render is a cut-out with its own bezel and shadow; a photograph or document
     is rectangular by nature, and the plate is what makes letterboxing read as
     deliberate. */
  .collage__cell:has(.collage__device) {
    border: 0;
    background-color: transparent;
    overflow: visible;
  }

  .collage__cap {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: 0.45rem 0.6rem;
    background: linear-gradient(
      180deg,
      rgba(11, 9, 8, 0) 0%,
      rgba(11, 9, 8, 0.82) 100%
    );
    color: #f7f3ec;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.03em;
    text-align: left;
  }

  /*
    THE DEVICE FILLS ITS CELL INSTEAD OF OVERFLOWING IT — the "tumpuk tumpukkan"
    defect. A device with `height: auto` and `aspect-ratio: 0.488` but no width
    took the cell's 438px width and derived height 897px inside a 438x301 cell,
    and `overflow: visible` painted the excess over the cell below.

    The fix sizes the device from its CELL, not the cell's width: a flex column
    gives the caption its natural height, the device takes the remainder and
    derives its WIDTH from the ratio.
  */
  .collage__cell:has(.collage__device) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
  }

  .collage__cell:has(.collage__device) .collage__device {
    /* `min-height: 0` stops the flex item's automatic minimum size from forcing
       its full intrinsic height back. */
    flex: 1 1 auto;
    min-height: 0;
    height: auto;
    width: auto;
    max-width: 100%;
    aspect-ratio: var(--device-ratio, 9 / 19.5);
  }

  /*
    A caption on a device cell sits BELOW the device: an overlay would land across
    the device's home bar and bottom navigation. The aspect box therefore moves to
    the DEVICE, not the cell — a cell with both an `aspect-ratio` and an in-flow
    caption lets the ratio win and clips the caption.

    Scoped with `:has()` to device cells only; a photograph or document keeps its
    overlay caption, which is correct on a matte.
  */
  .collage__cell:has(.collage__device) {
    aspect-ratio: auto;
  }

  .collage__cell:has(.collage__device) .collage__cap {
    position: static;
    inset: auto;
    padding: 0.6rem 0 0;
    background: none;
    color: var(--fg-faint);
    text-align: center;
  }

  .collage__cell:has(.collage__device) .collage__device {
    aspect-ratio: var(--device-ratio, 9 / 19.5);
    height: auto;
  }

  /* 1 image */
  .collage--single .collage__grid {
    grid-template-columns: 1fr;
  }

  /* 2 images: THE FRAME FOLLOWS THE PHOTOS, not a fixed 4:3. Forcing 4:3 sliced
     the top and bottom off the About page's wide group shot — it lost the banner
     it was taken under. `--duo-ratio` is set by the component from the images'
     own proportions; 4:3 is only the fallback for callers that supply none. */
  .collage--duo .collage__grid {
    grid-template-columns: 1.35fr 1fr;
  }

  .collage--duo .collage__cell {
    aspect-ratio: var(--duo-ratio, 4 / 3);
  }

  /* 3 images: lead + 2 stacked */
  .collage--trio .collage__grid {
    grid-template-columns: 1.6fr 1fr;
    grid-template-rows: repeat(2, minmax(0, 1fr));
  }

  .collage--trio .collage__cell--lead {
    grid-row: span 2;
  }

  .collage--trio .collage__cell {
    min-height: 0;
  }

  .collage--trio .collage__cell:not(.collage__cell--lead) {
    aspect-ratio: 16 / 11;
  }

  .collage--trio .collage__cell--lead {
    aspect-ratio: auto;
  }

  /* 4+ landscape: a uniform 2-column grid — every cell the same size at the
     image's own 16:9. With a set of dashboards there is no "hero": each is a full
     screen of information and shrinking any of them loses figures. Two up rather
     than four: at 1160px of measure a 2-column cell is ~570px wide, which renders
     a dashboard's axis labels legibly; four-up would put each at ~275px. */
  .collage--uniform .collage__grid {
    grid-template-columns: 1fr;
  }

  @media (min-width: 760px) {
    .collage--uniform .collage__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .collage--uniform .collage__cell {
    aspect-ratio: var(--uniform-ratio, 16 / 9);
  }

  /* 3+ portrait: a swipeable rail of phone screens — the counterpart to `uniform`
     for the other orientation, for the same reason: the count-based layouts damage
     this content (measured under `trio`, the two non-lead cells rendered their
     shells at 101x234px and the interface inside was unreadable). A RAIL, not a
     wrapped grid, because a set of app screens is an ordered sequence; scroll-snap
     lands each swipe on a screen. */
  .collage__viewport {
    position: relative;
    /* The arrows sit outside the rail, so the viewport must not clip them; the
       rail itself does the clipping. */
    overflow: visible;
  }

  .collage__rail {
    display: flex;
    gap: clamp(0.75rem, 1.8vw, 1.5rem);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    /* Vertical padding keeps a device's drop-shadow from being clipped by the
       scroll container's edge — a shadow cut in a straight line reads as a box. */
    padding: 0.75rem clamp(0.25rem, 1vw, 0.5rem) 1.25rem;
    /* Snap the FIRST and LAST screen flush to the viewport's edges. */
    scroll-padding-inline: clamp(0.25rem, 1vw, 0.5rem);
  }

  .collage__rail::-webkit-scrollbar {
    display: none;
  }

  .collage__rail:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* While a mouse drag is in progress the snap must stand aside, or the rail
     fights the pointer. */
  .collage__rail[data-dragging] {
    scroll-snap-type: none;
    cursor: grabbing;
  }

  /* Sized so a full-width gallery shows about FOUR screens and the rest are
     reached by swiping. Measured with a smaller value: six slides fitted into
     1432px of a 1152px viewport, so the rail scrolled just 280px and every screen
     was already on show. At 17rem the same six screens need ~1727px, which makes
     the swipe meaningful while keeping each device at its current height. */
  .collage__cell--slide {
    flex: 0 0 auto;
    width: clamp(10rem, 30vw, 17rem);
    aspect-ratio: var(--device-ratio, 9 / 19.5);
    scroll-snap-align: start;
    height: auto;
  }

  /* A rail whose contents already fit shows no arrows: at desktop width Guzelev's
     three screens fit the viewport, so controls would be decoration. The script
     hides them; this is the same state expressed before it runs. */
  .collage__rail:not([data-overflow]) ~ .collage__arrow {
    display: none;
  }

  /* ---------------- rail arrows + counter ---------------- */
  .collage__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-full);
    background-color: var(--surface);
    color: var(--fg);
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      border-color var(--t-base) var(--ease),
      color var(--t-base) var(--ease),
      background-color var(--t-base) var(--ease),
      opacity var(--t-base) var(--ease);
  }

  /* `display: grid` above would beat the `hidden` attribute, so the state is
     honoured explicitly — an arrow that looks live but does nothing is worse than
     none. */
  .collage__arrow[hidden] {
    display: none;
  }

  .collage__arrow:hover {
    border-color: var(--accent);
    color: var(--accent);
    background-color: var(--accent-soft);
  }

  .collage__arrow--prev {
    left: -1.2rem;
  }

  .collage__arrow--next {
    right: -1.2rem;
  }

  /* Disabled at either end rather than looping — a set of screens has a first and
     a last, and pretending otherwise hides the shape of the sequence. */
  .collage__arrow[disabled] {
    opacity: 0.35;
    cursor: default;
    border-color: var(--border-faint);
    color: var(--fg-faint);
    background-color: var(--surface-2);
  }

  .collage__count {
    position: absolute;
    right: 0;
    bottom: 0;
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.04em;
  }

  /* `hidden` must beat the positioning above; the state is owned by the script. */
  .collage__count[hidden] {
    display: none;
  }

  /* The arrows need somewhere to sit at narrower widths. */
  @media (max-width: 900px) {
    .collage__arrow--prev {
      left: 0;
    }

    .collage__arrow--next {
      right: 0;
    }
  }

  @media (max-width: 620px) {
    /* Three screens side by side will not fit a narrow viewport; the arrows drop
       to the counter's row so they never cover the interface. */
    .collage__arrow {
      position: static;
      transform: none;
      width: 2.6rem;
      height: 2.6rem;
    }

    .collage__viewport {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 0.6rem;
    }

    .collage__rail {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .collage__arrow--prev {
      grid-column: 1;
      grid-row: 2;
      justify-self: start;
    }

    .collage__arrow--next {
      grid-column: 3;
      grid-row: 2;
      justify-self: end;
    }

    .collage__count {
      position: static;
      grid-column: 2;
      grid-row: 2;
      justify-self: center;
      align-self: center;
    }
  }

  /* 4+ mixed: lead + 2 stacked, then a row. The trailing row is where this used
     to fall apart: `auto-fit` with a 190px minimum packed three cells of roughly
     229x143 — unusable for a dashboard whose point is its figures (measured: the
     lead 1090px wide vs the small ones 229px, a 4.8x difference in one gallery).
     The rule is now a floor — cells at least ~340px wide — so a row that cannot
     fit three wraps to two or one instead of shrinking. */
  .collage--many .collage__grid {
    grid-template-columns: 1.7fr 1fr;
    grid-template-rows: repeat(2, minmax(0, 1fr));
  }

  .collage--many .collage__cell--lead {
    grid-row: span 2;
  }

  .collage--many .collage__cell:not(.collage__cell--lead) {
    aspect-ratio: 16 / 10;
  }

  .collage__rest {
    display: grid;
    gap: var(--collage-gap, clamp(0.5rem, 1.2vw, 0.9rem));
    margin-top: var(--collage-gap, clamp(0.5rem, 1.2vw, 0.9rem));
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .collage__rest {
      grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    }
  }

  .collage__cell--small {
    aspect-ratio: 3 / 2;
  }

  /* A document in a small cell is letterboxed and gets a little more inset so its
     page edge does not sit flush against the frame's. */
  .collage__cell--small.collage__cell--contain img {
    padding: 0.8rem;
  }

  .collage__note {
    margin-top: 0.7rem;
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  /* mobile: collapse to a single column */
  @media (max-width: 640px) {
    .collage--duo .collage__grid,
    .collage--trio .collage__grid,
    .collage--many .collage__grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .collage--trio .collage__cell--lead,
    .collage--many .collage__cell--lead {
      grid-row: auto;
    }

    /* Portrait lead images get an honest frame on narrow screens rather than
       being cropped into a letterbox. */
    .collage--trio .collage__cell,
    .collage--many .collage__cell {
      aspect-ratio: 4 / 3;
    }
  }
</style>

<script>
  /**
   * Gallery rail controls — progressive enhancement over the scroll-snap rail.
   *
   * The rail is a native horizontal scroller, so touch swipe, trackpad, shift-wheel
   * and keyboard arrow keys ALL work before this script exists. What it adds: the
   * two arrows, the counter, the end-state disabling, and mouse drag.
   */
  const viewports = document.querySelectorAll<HTMLElement>('[data-gallery-rail]');

  if (viewports.length) {
    viewports.forEach((rail) => {
      const root = rail.closest('.collage__viewport');
      const slides = Array.from(rail.children) as HTMLElement[];
      if (!root || slides.length < 2) return;

      const prev = root.querySelector<HTMLButtonElement>('[data-gallery-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-gallery-next]');
      const counter = root.querySelector<HTMLElement>('[data-gallery-count]');

      /**
       * One step is the distance between the first two slides' left edges, measured
       * rather than computed from `clientWidth`: the slides have a gap, so stepping
       * by the container width would drift out of alignment. This number contains
       * the gap.
       */
      const step = () =>
        slides.length > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : rail.clientWidth;

      const go = (dir: 1 | -1) => {
        rail.scrollBy({ left: step() * dir, behavior: 'smooth' });
      };

      let frame = 0;

      const sync = () => {
        frame = 0;
        const max = rail.scrollWidth - rail.clientWidth;
        const s = step();
        const index = s > 0 ? Math.round(rail.scrollLeft / s) : 0;
        const clamped = Math.min(Math.max(index, 0), slides.length - 1);

        /*
          Whether the rail ACTUALLY has somewhere to go, recomputed on resize because
          a narrower window can turn a fitting rail into a scrolling one. Arrows for
          a rail that already fits would be controls for a task that does not exist.
        */
        const overflows = max > 4;
        if (overflows) rail.setAttribute('data-overflow', '');
        else rail.removeAttribute('data-overflow');

        if (counter) counter.hidden = !overflows;
        if (prev) prev.disabled = rail.scrollLeft <= 1;
        if (next) next.disabled = rail.scrollLeft >= max - 1;
        if (counter) counter.textContent = `${clamped + 1} / ${slides.length}`;
      };

      const schedule = () => {
        if (!frame) frame = requestAnimationFrame(sync);
      };

      rail.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);

      prev?.addEventListener('click', () => go(-1));
      next?.addEventListener('click', () => go(1));

      /*
        MOUSE DRAG — native scroll containers do not drag with a mouse. Touch is left
        to the browser on purpose: hijacking it would cost the platform's momentum and
        rubber-banding.

        The 6px threshold keeps a plain CLICK working: without it, the smallest
        movement while pressing an image would register as a drag and swallow the
        lightbox click.
      */
      let dragging = false;
      let startX = 0;
      let startLeft = 0;
      let moved = 0;

      rail.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'mouse' || event.button !== 0) return;
        dragging = true;
        moved = 0;
        startX = event.clientX;
        startLeft = rail.scrollLeft;
      });

      rail.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const dx = event.clientX - startX;
        moved = Math.max(moved, Math.abs(dx));

        if (moved > 6) {
          if (!rail.hasAttribute('data-dragging')) {
            rail.setAttribute('data-dragging', '');
            rail.setPointerCapture(event.pointerId);
          }
          event.preventDefault();
          rail.scrollLeft = startLeft - dx;
        }
      });

      const endDrag = (event: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        rail.removeAttribute('data-dragging');
        if (rail.hasPointerCapture?.(event.pointerId)) {
          rail.releasePointerCapture(event.pointerId);
        }

        // Snap by hand — `data-dragging` disabled snap for the duration.
        if (moved > 6) {
          const s = step();
          rail.scrollTo({ left: Math.round(rail.scrollLeft / s) * s, behavior: 'smooth' });
        }
      };

      rail.addEventListener('pointerup', endDrag);
      rail.addEventListener('pointercancel', endDrag);

      /* A drag must not also open the lightbox underneath it. */
      rail.addEventListener(
        'click',
        (event) => {
          if (moved > 6) {
            event.preventDefault();
            event.stopPropagation();
            moved = 0;
          }
        },
        true,
      );

      /* An image drag ghost would fight the pointer drag above. */
      rail.addEventListener('dragstart', (event) => event.preventDefault());

      /* Reveal the controls now that they work. */
      if (prev) prev.hidden = false;
      if (next) next.hidden = false;
      rail.setAttribute('data-ready', '');
      sync();
    });
  }
</script>
