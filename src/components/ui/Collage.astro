---
/**
 * COLLAGE — an asymmetric image composition that adapts to how many images it
 * is given.
 *
 * WHY THIS EXISTS
 * The brief repeatedly asks that images be COMBINED rather than stacked:
 * "if there are 2–4 related images, combine them", "don't stack images
 * vertically", "use a layout that still works if the number of images changes
 * later". A plain grid cannot do that, so this component switches composition
 * based on the count and the natural aspect ratio of each image.
 *
 * LAYOUTS (chosen automatically from the item count):
 *   1 image   full-bleed single frame
 *   2 images  large left + tall right (or two halves if one is portrait)
 *   3 images  large feature + two stacked beside it
 *   4+ images  feature + a 2-up column, then a balanced row for the rest
 *
 * Every image keeps its NATURAL aspect ratio via object-fit: cover inside a
 * fixed frame, so nothing is squashed; the first item is treated as the hero.
 */
import type { MediaAsset } from '@/types/content';

interface Props {
  images: MediaAsset[];
  /** Optional caption rendered under the whole collage. */
  caption?: string;
  /** Tighter gaps for use inside a card. */
  dense?: boolean;
  /**
   * Present narrow screenshots as device mockups (see ShotSlider). Used on the
   * UI/UX case studies, where a phone capture should read as a mobile product
   * rather than as a picture of a phone.
   */
  mockup?: boolean;
}

const { images, caption, dense = false, mockup = false } = Astro.props;

/** A cell is a device mockup only when the image is genuinely portrait. */
const asMockup = (m: MediaAsset) => {
  if (!mockup) return false;
  const ar = m.width && m.height ? m.width / m.height : 1.5;
  return ar < 0.75;
};

const n = images.length;

/**
 * Pick the composition from the count — AND from the shapes.
 *
 * The count alone was the old rule, and it produced a bad result for one common
 * case: a set of four LANDSCAPE screenshots fell into the lead-plus-stack
 * composition, which gives the lead a tall frame (row-span 2, ratio auto). A 16:9
 * dashboard in a 1.32 frame gets its sides cropped by `cover` — the user's
 * "G PENGADAAN ... TAHUN 2025" was the left edge of a dashboard that had been
 * sliced off, and the figures it exists to show were half gone.
 *
 * So a set whose images all share a landscape orientation gets a UNIFORM grid
 * instead: equal cells, all at the images' own ratio, none of them tall. The
 * composition then varies the LAYOUT without fighting the CONTENT.
 */
const isLandscape = (m: MediaAsset) => {
  const ar = m.width && m.height ? m.width / m.height : 1.5;
  return ar >= 1.2;
};
/** Portrait, and therefore a phone screen rather than a document or a photo. */
const isPortrait = (m: MediaAsset) => {
  const ar = m.width && m.height ? m.width / m.height : 1.5;
  return ar < 0.75;
};
const allLandscape = images.every((m) => isLandscape(m) || m.fit === 'contain');
const allPortrait = images.every((m) => isPortrait(m) && m.fit !== 'contain');

/*
  A set of PORTRAIT phone screens is its own composition, and the count-based
  layouts actively damage it.

  Measured on a three-screen app gallery under `trio`: the two non-lead cells
  rendered their device shells at 101x234px. At that size the shell's own bezel is
  most of the cell and the interface inside is unreadable — the pictures stop
  doing the one job they have. The tall `lead` cell is no better: a 0.49 ratio
  image inside an auto-height span is letterboxed into a narrow strip.

  Phone screens want a ROW OF PHONES. Equal columns, each cell at the phone's own
  ratio, sized so the shell is tall enough to read. This is the same principle as
  the landscape `uniform` case above — the composition follows the CONTENT's
  shape — applied to the other orientation.
*/
const portraitRow = allPortrait && n >= 3;

const layout =
  n <= 1
    ? 'single'
    : n === 2
      ? 'duo'
      : portraitRow
        ? 'screens'
        : n === 3
          ? 'trio'
        : allLandscape
          ? 'uniform'
          : 'many';
/** Everything after the first three goes into the trailing row. */
const rest = layout === 'many' ? images.slice(3) : [];

/**
 * For a duo, the frame ratio comes from the images themselves.
 *
 * A fixed ratio here is a crop, and a crop on a group photograph removes the
 * banner or the faces at the top — the two things that make the picture worth
 * showing. Averaging the pair's own proportions keeps both nearly whole while
 * still giving the two cells a common shape, which is all the composition needs.
 *
 * Clamped, because an extreme pair (a tall portrait beside a wide panorama)
 * would otherwise produce a frame so far from either that `cover` crops them
 * heavily anyway. Documents are excluded — they are letterboxed, so their frame
 * shape does not matter.
 */
/**
 * For a uniform grid the frame ratio is the images' own — they share one, so any
 * of them decides it. Clamped only to guard against a stray non-landscape file.
 *
 * Typed through a local rather than with `!` non-null assertions: `astro check`
 * fails to parse a frontmatter containing them, and when the parse fails the
 * compiler does not stop — it silently falls through and reads the whole `<style>`
 * block as TypeScript, reporting ~200 bogus errors ("Cannot find name 'grid'").
 * The types are narrowed by the guard above instead, which is just as safe and
 * keeps the diagnostic channel meaningful.
 */
const uniformRatio = (() => {
  const first = images.find((m) => m.width && m.height);
  if (!first || !first.width || !first.height) return '16 / 9';
  const ar = first.width / first.height;
  /*
    Portrait sets use this too — a row of phone screens shares one ratio exactly
    as a set of dashboards does — so the clamp spans both orientations rather than
    assuming landscape. The numbers are the images' own, so the clamp only ever
    guards against a stray file, never reshapes a real one.
  */
  return String(Math.min(Math.max(ar, 0.4), 2.2).toFixed(3));
})();

/**
 * The ratio for a DEVICE cell, from the device image itself.
 *
 * Set on every layout, not just `screens`/`uniform`, because a device can appear
 * in any composition — Kedai Nyam mixes two desktop screens with two phones under
 * `trio`. A device cell that fell back to the generic `--uniform-ratio` default
 * would be letterboxed inside a box of the wrong shape.
 */
const deviceRatio = (() => {
  const dev = images.find((m) => {
    const ar = m.width && m.height ? m.width / m.height : 1.5;
    return ar < 0.75 && m.fit !== 'contain';
  });
  if (!dev || !dev.width || !dev.height) return uniformRatio;
  return (dev.width / dev.height).toFixed(4);
})();

const duoRatio = (() => {
  if (layout !== 'duo') return '4 / 3';
  const ars = images
    .slice(0, 2)
    .filter((m) => m.fit !== 'contain')
    .map((m) => (m.width && m.height ? m.width / m.height : 4 / 3));
  if (ars.length < 2) return '4 / 3';
  const avg = ars.reduce((a, b) => a + b, 0) / ars.length;
  return String(Math.min(Math.max(avg, 1.1), 1.9).toFixed(3));
})();
---

{
  n > 0 && (
    <figure
      class:list={['collage', `collage--${layout}`, dense && 'collage--dense']}
      style={`--device-ratio: ${deviceRatio};${
        layout === 'duo'
          ? ` --duo-ratio: ${duoRatio};`
          : layout === 'uniform' || layout === 'screens'
            ? ` --uniform-ratio: ${uniformRatio};`
            : ''
      }`}
    >
      {
        layout === 'screens' ? (
          /*
            A SWIPEABLE RAIL — the gallery is interactive, not a static wall.

            The user's ask: "gambar project bisa dibuat agar bisa diswipe untuk
            lihat gambar lainnya. buat interaktif". A wrapped grid of six phones
            asks the visitor to scan; a rail asks them to move through the flow,
            which is what a set of app screens IS — an ordered sequence.

            Scroll-snap does the work natively, so touch swipe, trackpad and
            keyboard scrolling all function before any script runs. The script adds
            the arrows, the counter and mouse drag.
          */
          <div class="collage__viewport">
            <div
              class="collage__rail"
              data-gallery-rail
              role="group"
              aria-label={`${images.length} screens — swipe or use the arrows`}
              tabindex="0"
            >
              {images.map((img) => (
                <button
                  type="button"
                  class:list={['collage__cell', 'collage__cell--slide']}
                  data-lightbox-src={img.src}
                  data-lightbox-alt={img.alt}
                  data-lightbox-caption={img.caption ?? img.alt}
                  aria-label={`View larger: ${img.alt}`}
                >
                  <span class="collage__device">
                    <img
                      src={img.src}
                      alt={img.alt}
                      width={img.width}
                      height={img.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  {img.caption && <span class="collage__cap">{img.caption}</span>}
                </button>
              ))}
            </div>

            <button
              type="button"
              class="collage__arrow collage__arrow--prev"
              data-gallery-prev
              aria-label="Previous screen"
              hidden
            >
              <span aria-hidden="true">‹</span>
            </button>
            <button
              type="button"
              class="collage__arrow collage__arrow--next"
              data-gallery-next
              aria-label="Next screen"
              hidden
            >
              <span aria-hidden="true">›</span>
            </button>

            <span class="collage__count mono" data-gallery-count aria-hidden="true" hidden>
              1 / {images.length}
            </span>
          </div>
        ) : (
          <div class="collage__grid">
            {images.slice(0, layout === 'many' ? 3 : n).map((img, i) => (
              <button
                type="button"
                class:list={[
                  'collage__cell',
                  i === 0 && 'collage__cell--lead',
                  img.fit === 'contain' && 'collage__cell--contain',
                ]}
                data-lightbox-src={img.src}
                data-lightbox-alt={img.alt}
                data-lightbox-caption={img.caption ?? img.alt}
                aria-label={`View larger: ${img.alt}`}
              >
                {asMockup(img) ? (
                  <span class="collage__device">
                    <img
                      src={img.src}
                      alt={img.alt}
                      width={img.width}
                      height={img.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                ) : (
                  <img
                    src={img.src}
                    alt={img.alt}
                    width={img.width}
                    height={img.height}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                {img.caption && <span class="collage__cap">{img.caption}</span>}
              </button>
            ))}
          </div>
        )
      }

      {rest.length > 0 && (
        <div class="collage__rest" data-count={rest.length}>
          {rest.map((img) => (
            <button
              type="button"
              class:list={[
                'collage__cell',
                'collage__cell--small',
                img.fit === 'contain' && 'collage__cell--contain',
              ]}
              data-lightbox-src={img.src}
              data-lightbox-alt={img.alt}
              data-lightbox-caption={img.caption ?? img.alt}
              aria-label={`View larger: ${img.alt}`}
            >
              <img
                src={img.src}
                alt={img.alt}
                width={img.width}
                height={img.height}
                loading="lazy"
                decoding="async"
              />
            </button>
          ))}
        </div>
      )}

      {caption && <figcaption class="collage__note mono">{caption}</figcaption>}
    </figure>
  )
}

<style>
  .collage {
    margin: 0;
  }

  .collage__grid {
    display: grid;
    gap: var(--collage-gap, clamp(0.5rem, 1.2vw, 0.9rem));
  }

  .collage--dense {
    --collage-gap: 0.5rem;
  }

  .collage__cell {
    position: relative;
    display: block;
    overflow: hidden;
    padding: 0;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-xs);
    background-color: var(--surface-2);
    cursor: zoom-in;
  }

  .collage__cell img {
    display: block;
    width: 100%;
    height: 100%;
    /*
      cover keeps the frames tidy without distorting the photo, but the anchor
      matters: these are mostly photographs of people, and a centred crop of a
      standing group cuts the heads off and keeps the floor. Anchoring the crop
      to the TOP keeps faces in frame at every frame ratio.
    */
    object-fit: cover;
    object-position: center top;
    transition: transform var(--t-slow) var(--ease);
  }

  .collage__cell:hover img {
    transform: scale(1.03);
  }

  /*
    Documents (journal covers, article pages) are LETTERBOXED, not cropped.

    A cover forced to fill a 4:3 or 16:10 frame loses its masthead and the top of
    its title block — it stops being evidence of the publication it illustrates.
    `contain` keeps the whole page on a matte, which reads as a deliberate plate
    rather than a mis-sized image.
  */
  .collage__cell--contain img {
    object-fit: contain;
    object-position: center;
    padding: 0.6rem;
  }

  .collage__cell--contain:hover img {
    transform: none;
  }

  /* ---------------- device mockup ----------------
    THE RENDER IS THE PHONE — this wrapper adds NO hardware of its own.

    It used to draw a shell: a 1.5px border, a 1.2rem radius, a filled `--device-body`
    plate and a box-shadow. Every capture that ships here is a full device render
    exported from Figma with its own bezel, corner radius and shadow, so that
    shell was a SECOND rectangle around a phone that already had one — visible on
    every device cell in every gallery, including the mixed sets.

    What remains is a transparent layout box: it reserves space, sizes from the
    device's own ratio, and centres the render in its cell. All visible depth
    comes from a `drop-shadow` on the IMAGE, which follows the alpha silhouette
    rather than a rectangle.
    ---------------------------------------------------------------------- */
  .collage__device {
    display: block;
    position: relative;
    height: calc(100% - 1.4rem);
    aspect-ratio: 9 / 19.5;
    max-width: 100%;
    margin: 0 auto;
    padding: 0;
    border: 0;
    border-radius: 0;
    background-color: transparent;
    overflow: visible;
  }

  /*
    NO DRAWN NOTCH — proven a defect by A/B.

    A `::before` used to paint a dark pill across the top of the shell. It was
    written for captures that show a bare screen, and the captures that actually
    ship here are full device renders that ALREADY carry a dynamic island.

    Measured by forcing the rule off and diffing the two renders: 76701 pixels
    changed, peak delta 52, in a band across the top of the screen. The two pills
    did not overlap — they sat one above the other, reading as two holes in one
    phone. That was visible in every device cell on the site, and no amount of
    tuning would have fixed it: the file already contains its own hardware.

    A mockup shell is correct when the source is a SCREEN. Applied to a DEVICE
    PHOTOGRAPH it can only ever add artefacts, so the pill is gone rather than
    made conditional — there is no capture in this set that needs it.
  */

  .collage__device img {
    width: 100%;
    height: 100%;
    /* The render supplies its own rounded corners, so `cover` would crop them
       into square ones. `contain` shows the device whole. */
    border-radius: 0;
    object-fit: contain;
    object-position: center bottom;
    padding: 0;
    /* Depth follows the ALPHA silhouette — the bezel, not a rectangle around it. */
    filter: var(--photo-filter) drop-shadow(0 2px 4px rgba(0, 0, 0, 0.34))
      drop-shadow(0 14px 30px rgba(0, 0, 0, 0.3));
  }

  :global([data-theme='light']) .collage__device img {
    filter: var(--photo-filter) drop-shadow(0 2px 4px rgba(62, 46, 30, 0.18))
      drop-shadow(0 14px 28px rgba(62, 46, 30, 0.16));
  }

  .collage__device img,
  .collage__cell:hover .collage__device img {
    transform: none;
  }

  .collage__cell:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /*
    ANY CELL HOLDING A DEVICE RENDER LOSES ITS BOX — not just the `screens` layout.

    This has to be a rule about the CONTENT, not about the layout, or mixed sets
    keep the defect: on Kedai Nyam (two desktop screens plus two phones) the
    phones sat on a beige plate inside a 1px border while the neighbouring desktop
    screenshots kept their frames, so the same gallery showed two different
    treatments of the same kind of object.

    The reasoning is uniform: a device render is a cut-out with its own bezel,
    radius and shadow, so a cell around it can only add a second rectangle. A
    photograph or a document is different — those are rectangular by nature, and
    the plate is what makes letterboxing read as deliberate.
  */
  .collage__cell:has(.collage__device) {
    border: 0;
    background-color: transparent;
    overflow: visible;
  }

  .collage__cap {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: 0.45rem 0.6rem;
    background: linear-gradient(
      180deg,
      rgba(11, 9, 8, 0) 0%,
      rgba(11, 9, 8, 0.82) 100%
    );
    color: #f7f3ec;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.03em;
    text-align: left;
  }

  /*
    A captioned DEVICE cell needs extra room at the foot.

    The caption is an overlay, and it was landing across the lower third of the
    phone shell — the screenshot's own interface and the caption were competing
    for the same pixels. The shell is shortened by the caption's height so the
    two never overlap, which matters more here than on a photo because the bottom
    of a phone screen is where the navigation bar lives.
  */
  .collage__cell:has(.collage__device) .collage__device {
    height: calc(100% - 3.2rem);
  }

  /*
    A caption on a device cell sits BELOW the device, not over it.

    With the box gone there is no plate for the caption to sit on, and an overlay
    would land straight across the device's home bar and bottom navigation — the
    part of a phone screen a reader most needs to see.

    THE ASPECT BOX MOVES TO THE DEVICE, not the cell. A cell carrying both an
    `aspect-ratio` and an in-flow caption would have to fit both, and the ratio
    wins — the caption gets clipped. So the cell becomes a plain column whose
    DEVICE holds the ratio, and the caption simply follows it.

    Scoped with `:has()` to device cells only: a photograph or a document keeps its
    overlay caption, which is correct there because the caption sits on the matte
    or the image itself rather than on an interface.
  */
  .collage__cell:has(.collage__device) {
    aspect-ratio: auto;
  }

  .collage__cell:has(.collage__device) .collage__cap {
    position: static;
    inset: auto;
    padding: 0.6rem 0 0;
    background: none;
    color: var(--fg-faint);
    text-align: center;
  }

  .collage__cell:has(.collage__device) .collage__device {
    aspect-ratio: var(--device-ratio, 9 / 19.5);
    height: auto;
  }

  /* ---------------- 1 image ---------------- */
  .collage--single .collage__grid {
    grid-template-columns: 1fr;
  }

  /* ---------------- 2 images: 2:1 split ---------------- */
  /*
    THE FRAME FOLLOWS THE PHOTOS, not a fixed 4:3.

    Both cells used to be forced to 4:3, which is fine for a landscape
    photograph and wrong for everything else. The About page's pair is a
    wide group shot and a narrower candid, and 4:3 sliced the top and bottom off
    both — the group shot lost the banner it was taken under, so the picture
    stopped showing the thing it was there to show.

    `--duo-ratio` is set by the component from the images' own proportions, so the
    composition adapts instead of cropping. The default stays 4:3 for callers that
    do not supply one.
  */
  .collage--duo .collage__grid {
    grid-template-columns: 1.35fr 1fr;
  }

  .collage--duo .collage__cell {
    aspect-ratio: var(--duo-ratio, 4 / 3);
  }

  /* ---------------- 3 images: lead + 2 stacked ---------------- */
  .collage--trio .collage__grid {
    grid-template-columns: 1.6fr 1fr;
    grid-template-rows: repeat(2, minmax(0, 1fr));
  }

  .collage--trio .collage__cell--lead {
    grid-row: span 2;
  }

  .collage--trio .collage__cell {
    min-height: 0;
  }

  .collage--trio .collage__cell:not(.collage__cell--lead) {
    aspect-ratio: 16 / 11;
  }

  .collage--trio .collage__cell--lead {
    aspect-ratio: auto;
  }

  /* ---------------- 4+ landscape: a uniform 2-column grid ----------------
     Every cell the same size, every cell at the image's own 16:9. No lead, no
     stack, no crop — because with a set of dashboards there is no "hero": each
     one is a full screen of information and shrinking any of them loses figures.

     Two up rather than three or four: at 1160px of measure a 2-column cell is
     ~570px wide, which renders a dashboard's axis labels legibly. Four-up would
     put each at ~275px, back where this started.
     -------------------------------------------------------------------- */
  .collage--uniform .collage__grid {
    grid-template-columns: 1fr;
  }

  @media (min-width: 760px) {
    .collage--uniform .collage__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .collage--uniform .collage__cell {
    aspect-ratio: var(--uniform-ratio, 16 / 9);
  }

  /* ---------------- 3+ portrait: a swipeable rail of phone screens ----------------
     The counterpart to `uniform` for the other orientation, and it exists for the
     same reason: the count-based layouts damage this content.

     Measured on a three-screen app gallery under `trio`, the two non-lead cells
     rendered their shells at 101x234px — the bezel takes most of that and the
     interface inside is unreadable.

     A RAIL, NOT A WRAPPED GRID. A set of app screens is an ordered sequence, so
     the composition that matches it is a horizontal one the visitor moves through.
     Scroll-snap makes each swipe land exactly on a screen, which is the difference
     between a gallery and a box you can drag.
     -------------------------------------------------------------------- */
  .collage__viewport {
    position: relative;
    /*
      The arrows sit outside the rail's box on wide screens, so the viewport must
      not clip them. The rail itself does the clipping.
    */
    overflow: visible;
  }

  .collage__rail {
    display: flex;
    gap: clamp(0.75rem, 1.8vw, 1.5rem);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    /*
      A little vertical padding so a device's drop-shadow is not clipped by the
      scroll container's own edge — a shadow cropped in a straight line reads as a
      box, which is exactly what this change removed.
    */
    padding: 0.75rem clamp(0.25rem, 1vw, 0.5rem) 1.25rem;
    /* Snap the FIRST and LAST screen flush to the viewport's edges. */
    scroll-padding-inline: clamp(0.25rem, 1vw, 0.5rem);
  }

  .collage__rail::-webkit-scrollbar {
    display: none;
  }

  .collage__rail:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* While a mouse drag is in progress the snap must stand aside, or the rail
     fights the pointer. */
  .collage__rail[data-dragging] {
    scroll-snap-type: none;
    cursor: grabbing;
  }

  .collage__cell--slide {
    /*
      Sized so a full-width gallery shows about FOUR screens and the rest are
      reached by swiping.

      Measured with a smaller value: six slides fitted into 1432px of a 1152px
      viewport, so the whole rail scrolled just 280px and every screen was already
      on show — a rail that never needs to move is not a gallery, and the arrows had
      almost nothing to do. At 17rem the same six screens need ~1727px, which makes
      the swipe meaningful while keeping each device at its current height.
    */
    flex: 0 0 auto;
    width: clamp(10rem, 30vw, 17rem);
    aspect-ratio: var(--device-ratio, 9 / 19.5);
    scroll-snap-align: start;
    height: auto;
  }

  /*
    A rail whose contents already fit shows no arrows.

    Guzelev has three screens: at desktop width they fit inside the viewport, so
    there is nothing to scroll to and controls would be decoration. The script
    hides them in that case; this is the same state expressed before it runs.
  */
  .collage__rail:not([data-overflow]) ~ .collage__arrow {
    display: none;
  }

  /* ---------------- rail arrows + counter ---------------- */
  .collage__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-full);
    background-color: var(--surface);
    color: var(--fg);
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      border-color var(--t-base) var(--ease),
      color var(--t-base) var(--ease),
      background-color var(--t-base) var(--ease),
      opacity var(--t-base) var(--ease);
  }

  /*
    `display: grid` above would beat the `hidden` attribute, so the state is
    honoured explicitly. The arrows ship hidden and the script reveals them —
    without it there is no arrow at all, because an arrow that looks live but does
    nothing is worse than no arrow.
  */
  .collage__arrow[hidden] {
    display: none;
  }

  .collage__arrow:hover {
    border-color: var(--accent);
    color: var(--accent);
    background-color: var(--accent-soft);
  }

  .collage__arrow--prev {
    left: -1.2rem;
  }

  .collage__arrow--next {
    right: -1.2rem;
  }

  /* Disabled at either end rather than looping — a set of screens has a first and
     a last, and pretending otherwise hides the shape of the sequence. */
  .collage__arrow[disabled] {
    opacity: 0.35;
    cursor: default;
    border-color: var(--border-faint);
    color: var(--fg-faint);
    background-color: var(--surface-2);
  }

  .collage__count {
    position: absolute;
    right: 0;
    bottom: 0;
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.04em;
  }

  /* `hidden` must beat the positioning above; the state is owned by the script. */
  .collage__count[hidden] {
    display: none;
  }

  /* The arrows need somewhere to sit — a phone leaves more room around the rail
     than a wrapped grid did, but not at every width. */
  @media (max-width: 900px) {
    .collage__arrow--prev {
      left: 0;
    }

    .collage__arrow--next {
      right: 0;
    }
  }

  @media (max-width: 620px) {
    /* Three screens side by side will not fit a narrow viewport; the rail scrolls,
       which is the point, but the arrows are dropped to the counter's row so they
       never cover the interface. */
    .collage__arrow {
      position: static;
      transform: none;
      width: 2.6rem;
      height: 2.6rem;
    }

    .collage__viewport {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 0.6rem;
    }

    .collage__rail {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .collage__arrow--prev {
      grid-column: 1;
      grid-row: 2;
      justify-self: start;
    }

    .collage__arrow--next {
      grid-column: 3;
      grid-row: 2;
      justify-self: end;
    }

    .collage__count {
      position: static;
      grid-column: 2;
      grid-row: 2;
      justify-self: center;
      align-self: center;
    }
  }

  /* ---------------- 4+ mixed: lead + 2 stacked, then a row ----------------
     The trailing row is where this used to fall apart. `auto-fit` with a 190px
     minimum packs as many columns as the width allows, so with three leftovers it
     produced three cells of roughly 229x143 — which is unusable for a dashboard
     screenshot whose whole point is its figures. Measured on the five-image
     procurement project: the lead rendered 1090px wide and the small ones 229px,
     a 4.8x difference within one gallery.

     A dashboard is a DOCUMENT: it carries information at every scale, so a
     thumbnail of it communicates nothing. The rule is now a floor — cells are at
     least ~340px wide, and a row that cannot fit three at that size wraps to two
     or one instead of shrinking further. Fewer, larger frames beat a dense grid
     nobody can read.
     --------------------------------------------------------------------- */
  .collage--many .collage__grid {
    grid-template-columns: 1.7fr 1fr;
    grid-template-rows: repeat(2, minmax(0, 1fr));
  }

  .collage--many .collage__cell--lead {
    grid-row: span 2;
  }

  .collage--many .collage__cell:not(.collage__cell--lead) {
    aspect-ratio: 16 / 10;
  }

  .collage__rest {
    display: grid;
    gap: var(--collage-gap, clamp(0.5rem, 1.2vw, 0.9rem));
    margin-top: var(--collage-gap, clamp(0.5rem, 1.2vw, 0.9rem));
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .collage__rest {
      grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    }
  }

  .collage__cell--small {
    aspect-ratio: 3 / 2;
  }

  /*
    A document in a small cell is letterboxed rather than cropped, and gets a
    little more inset so its own page edge does not sit flush against the frame's.
  */
  .collage__cell--small.collage__cell--contain img {
    padding: 0.8rem;
  }

  .collage__note {
    margin-top: 0.7rem;
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  /* ---------------- mobile: collapse to a single column ---------------- */
  @media (max-width: 640px) {
    .collage--duo .collage__grid,
    .collage--trio .collage__grid,
    .collage--many .collage__grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .collage--trio .collage__cell--lead,
    .collage--many .collage__cell--lead {
      grid-row: auto;
    }

    /* Portrait lead images get an honest frame on narrow screens rather than
       being cropped into a letterbox. */
    .collage--trio .collage__cell,
    .collage--many .collage__cell {
      aspect-ratio: 4 / 3;
    }
  }
</style>

<script>
  /**
   * Gallery rail controls — progressive enhancement over the scroll-snap rail.
   *
   * The rail is a native horizontal scroller, so touch swipe, trackpad, shift-wheel
   * and keyboard arrow keys ALL work before this script exists. What it adds: the
   * two arrows, the counter, the end-state disabling, and mouse drag.
   *
   * No script means no arrows — which is why the arrows ship `hidden` in the
   * markup and are revealed here. An arrow that looks live but does nothing is
   * worse than no arrow.
   */
  const viewports = document.querySelectorAll<HTMLElement>('[data-gallery-rail]');

  if (viewports.length) {
    viewports.forEach((rail) => {
      const root = rail.closest('.collage__viewport');
      const slides = Array.from(rail.children) as HTMLElement[];
      if (!root || slides.length < 2) return;

      const prev = root.querySelector<HTMLButtonElement>('[data-gallery-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-gallery-next]');
      const counter = root.querySelector<HTMLElement>('[data-gallery-count]');

      /**
       * One step is the distance between the first two slides' left edges.
       *
       * Measured rather than computed from `clientWidth`: the slides have a gap
       * between them, so stepping by the container width would drift further out
       * of alignment with every press. This number already contains the gap.
       */
      const step = () =>
        slides.length > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : rail.clientWidth;

      const go = (dir: 1 | -1) => {
        rail.scrollBy({ left: step() * dir, behavior: 'smooth' });
      };

      let frame = 0;

      const sync = () => {
        frame = 0;
        const max = rail.scrollWidth - rail.clientWidth;
        const s = step();
        const index = s > 0 ? Math.round(rail.scrollLeft / s) : 0;
        const clamped = Math.min(Math.max(index, 0), slides.length - 1);

        /*
          Whether the rail ACTUALLY has somewhere to go.

          With three screens the rail fits its viewport, so there is nothing to
          scroll to — arrows would be controls for a task that does not exist. The
          flag is recomputed on resize, because a narrower window can turn a fitting
          rail into a scrolling one.
        */
        const overflows = max > 4;
        if (overflows) rail.setAttribute('data-overflow', '');
        else rail.removeAttribute('data-overflow');

        if (counter) counter.hidden = !overflows;
        if (prev) prev.disabled = rail.scrollLeft <= 1;
        if (next) next.disabled = rail.scrollLeft >= max - 1;
        if (counter) counter.textContent = `${clamped + 1} / ${slides.length}`;
      };

      const schedule = () => {
        if (!frame) frame = requestAnimationFrame(sync);
      };

      rail.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);

      prev?.addEventListener('click', () => go(-1));
      next?.addEventListener('click', () => go(1));

      /*
        MOUSE DRAG — a native scroll container does not drag with a mouse, which is
        how a desktop visitor expects a gallery to behave. Touch is left to the
        browser on purpose: hijacking it would cost the momentum and rubber-banding
        the platform gives for free.

        The 6px threshold is what keeps a plain CLICK working. Without it, the
        smallest movement while pressing an image would register as a drag and
        swallow the lightbox click.
      */
      let dragging = false;
      let startX = 0;
      let startLeft = 0;
      let moved = 0;

      rail.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'mouse' || event.button !== 0) return;
        dragging = true;
        moved = 0;
        startX = event.clientX;
        startLeft = rail.scrollLeft;
      });

      rail.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const dx = event.clientX - startX;
        moved = Math.max(moved, Math.abs(dx));

        if (moved > 6) {
          if (!rail.hasAttribute('data-dragging')) {
            rail.setAttribute('data-dragging', '');
            rail.setPointerCapture(event.pointerId);
          }
          event.preventDefault();
          rail.scrollLeft = startLeft - dx;
        }
      });

      const endDrag = (event: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        rail.removeAttribute('data-dragging');
        if (rail.hasPointerCapture?.(event.pointerId)) {
          rail.releasePointerCapture(event.pointerId);
        }

        // Snap by hand — `data-dragging` disabled snap for the duration.
        if (moved > 6) {
          const s = step();
          rail.scrollTo({ left: Math.round(rail.scrollLeft / s) * s, behavior: 'smooth' });
        }
      };

      rail.addEventListener('pointerup', endDrag);
      rail.addEventListener('pointercancel', endDrag);

      /* A drag must not also open the lightbox underneath it. */
      rail.addEventListener(
        'click',
        (event) => {
          if (moved > 6) {
            event.preventDefault();
            event.stopPropagation();
            moved = 0;
          }
        },
        true,
      );

      /* An image drag ghost would fight the pointer drag above. */
      rail.addEventListener('dragstart', (event) => event.preventDefault());

      /* Reveal the controls now that they work. */
      if (prev) prev.hidden = false;
      if (next) next.hidden = false;
      rail.setAttribute('data-ready', '');
      sync();
    });
  }
</script>
