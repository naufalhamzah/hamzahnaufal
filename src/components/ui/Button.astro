---
/**
 * Button / link CTA. Renders an <a> when given `href`, otherwise a <button>.
 *
 * Variants:
 *   primary — filled accent, for the single main action in a view
 *   ghost   — outlined, for secondary actions
 *   quiet   — text only, for tertiary actions
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'quiet';
  external?: boolean;
  /** Renders a subtle arrow after the label. */
  arrow?: boolean;
  /** Muted, non-interactive look used by the CV button while no file exists. */
  disabled?: boolean;
  class?: string;
  id?: string;
  type?: 'button' | 'submit';
  'data-testid'?: string;
}

const {
  href,
  variant = 'ghost',
  external = false,
  arrow = false,
  disabled = false,
  class: className,
  id,
  type = 'button',
} = Astro.props;

const classes = ['btn', `btn--${variant}`, { 'btn--disabled': disabled }, className];
---

{
  href && !disabled ? (
    <a
      href={href}
      id={id}
      class:list={classes}
      data-testid={Astro.props['data-testid']}
      rel={external ? 'noopener noreferrer' : undefined}
      target={external ? '_blank' : undefined}
    >
      <span><slot /></span>
      {arrow && <span class="btn__arrow" aria-hidden="true">→</span>}
    </a>
  ) : (
    <button
      type={type}
      id={id}
      class:list={classes}
      data-testid={Astro.props['data-testid']}
      disabled={disabled}
      aria-disabled={disabled ? 'true' : undefined}
      title={disabled ? 'Not available yet' : undefined}
    >
      <span><slot /></span>
      {arrow && <span class="btn__arrow" aria-hidden="true">→</span>}
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.62rem 1.1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out-soft),
      border-color var(--duration-fast) var(--ease-out-soft),
      color var(--duration-fast) var(--ease-out-soft),
      transform var(--duration-fast) var(--ease-out-soft);
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn--primary {
    background-color: var(--accent);
    color: var(--on-accent);
    border-color: var(--accent);
  }
  .btn--primary:hover {
    background-color: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .btn--ghost {
    border-color: var(--border-strong);
    color: var(--foreground);
    background-color: transparent;
  }
  .btn--ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
    background-color: var(--accent-soft);
  }

  .btn--quiet {
    padding-inline: 0.35rem;
    color: var(--muted-foreground);
  }
  .btn--quiet:hover {
    color: var(--accent);
  }

  .btn__arrow {
    transition: transform var(--duration-base) var(--ease-out-soft);
  }
  .btn:hover .btn__arrow {
    transform: translateX(3px);
  }

  /* Muted state for a CTA whose asset does not exist yet (e.g. the CV). */
  .btn--disabled {
    opacity: 0.55;
    cursor: not-allowed;
    border-style: dashed;
  }
  .btn--disabled:hover {
    transform: none;
  }
</style>
