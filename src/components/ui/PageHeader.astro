---
/**
 * PAGE HEADER — the masthead every detail page shares.
 *
 * This is what makes each page feel distinct from the homepage while still
 * being unmistakably the same site: the same eyebrow treatment, the same
 * oversized serif, the same hairline, but a different statement of purpose.
 *
 * Anatomy:  eyebrow (accent rule + label)  →  title  →  standfirst  →  meta rail
 * Every part except the eyebrow and title is optional.
 */
interface Props {
  /** Small uppercase label above the title. */
  eyebrow: string;
  /** The page title — set large in the display serif. */
  title: string;
  /** Optional lead paragraph under the title. */
  standfirst?: string;
  /** Optional short facts shown as a right-hand rail. */
  meta?: { label: string; value: string }[];
  /** Two-digit index shown before the eyebrow, e.g. "02". */
  index?: string;
}

const { eyebrow, title, standfirst, meta = [], index } = Astro.props;
---

<header class="ph">
  <div class="shell">
    <p class="ph__eyebrow label">
      {index && <span class="ph__idx" aria-hidden="true">{index}</span>}
      {eyebrow}
    </p>

    <div class:list={['ph__grid', meta.length > 0 && 'ph__grid--split']}>
      <div class="ph__lead">
        <h1 class="ph__title">{title}</h1>
        {standfirst && <p class="ph__stand">{standfirst}</p>}
      </div>

      {
        meta.length > 0 && (
          <dl class="ph__meta">
            {meta.map((m) => (
              <div class="ph__meta-row">
                <dt class="mono">{m.label}</dt>
                <dd>{m.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    <hr class="rule rule--strong ph__rule" />
  </div>
</header>

<style>
  .ph {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }

  .ph__eyebrow {
    margin-bottom: clamp(1.1rem, 2.5vw, 1.75rem);
  }

  .ph__idx {
    color: var(--fg-faint);
    margin-inline-end: 0.7rem;
  }

  .ph__grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 3rem);
    grid-template-columns: 1fr;
  }

  /* The title takes the larger share; meta sits in a narrow right rail,
     aligned to the title's baseline. */
  @media (min-width: 900px) {
    .ph__grid--split {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      align-items: end;
    }
  }

  .ph__title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 500;
    letter-spacing: -0.026em;
    color: var(--fg-strong);
    /* A long title would otherwise run the full width and lose its shape. */
    max-width: 20ch;
  }

  .ph__stand {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    max-width: 58ch;
    font-size: var(--text-lg);
    color: var(--fg-muted);
  }

  .ph__meta {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .ph__meta-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-top: var(--hairline) solid var(--border-faint);
  }

  .ph__meta-row:last-child {
    border-bottom: var(--hairline) solid var(--border-faint);
  }

  .ph__meta dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--fg);
    text-align: right;
  }

  .ph__rule {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
</style>
