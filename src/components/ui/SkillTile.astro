---
/**
 * SKILL TILE — one skill as a logo tile.
 *
 * The brief asked twice for marks that are large enough to recognise, so the
 * mark is 2.5rem inside a generous tile — not a 14px glyph beside text.
 *
 * THREE STATES, all handled here so the grid never shows a broken tile:
 *   brand    an official mark in its brand colour
 *   mono     an official mark whose brand colour is too dark to read on the
 *            dark canvas — drawn in `currentColor` instead (see skill-icons.ts)
 *   text     no mark exists for this skill, so it renders as a text tile only.
 *            It deliberately does NOT show a monogram: a lone letter reads as a
 *            logo and invites the question "whose logo is that?".
 *
 * NO PERCENTAGES. No proficiency level is documented anywhere in the source
 * material, so none is shown.
 */
import { getSkillIcon } from '@/data/skill-icons';

interface Props {
  name: string;
  icon: string | null;
  /** Compact horizontal variant for denser lists. */
  small?: boolean;
}

const { name, icon, small = false } = Astro.props;
const mark = getSkillIcon(icon);
---

<div
  class:list={['st', small && 'st--small', !mark && 'st--text']}
  data-icon={mark ? (mark.hex ? 'brand' : 'mono') : 'text'}
>
  {
    mark && (
      <span class="st__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" role="presentation">
          <path d={mark.path} fill={mark.hex ?? 'currentColor'} />
        </svg>
      </span>
    )
  }

  <span class="st__name">{name}</span>
</div>

<style>
  .st {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    height: 100%;
    padding: clamp(1rem, 2.2vw, 1.35rem) 0.6rem;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-xs);
    background-color: var(--surface);
    text-align: center;
    transition:
      border-color var(--t-base) var(--ease),
      background-color var(--t-base) var(--ease),
      transform var(--t-base) var(--ease);
  }

  .st:hover {
    border-color: var(--border-strong);
    background-color: var(--surface-2);
    transform: translateY(-2px);
  }

  /* ---- the mark: sized to be recognisable, which is the point ---- */
  .st__mark {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    /* Brand marks keep their colour; marks whose brand colour is unreadable on
       dark inherit this. */
    color: var(--fg);
  }

  .st__mark svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .st__name {
    font-size: var(--text-xs);
    line-height: 1.3;
    color: var(--fg-muted);
    text-wrap: balance;
  }

  /* ---- text-only: no mark, so the tile centres on its label ---- */
  .st--text {
    gap: 0;
    min-height: 6.5rem;
  }

  .st--text .st__name {
    font-size: var(--text-sm);
    color: var(--fg-subtle);
  }

  /* ---- compact ---- */
  .st--small {
    flex-direction: row;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.8rem;
    text-align: left;
    background-color: transparent;
    border-color: transparent;
  }

  .st--small .st__mark {
    width: 1.6rem;
    height: 1.6rem;
  }

  .st--small .st__name {
    font-size: var(--text-sm);
  }

  .st--small.st--text {
    min-height: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .st:hover {
      transform: none;
    }
  }
</style>
