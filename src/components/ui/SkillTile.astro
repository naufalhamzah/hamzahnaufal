---
/**
 * SKILL TILE — one skill as a logo tile.
 *
 * The brief was specific: "skills must use logos that are big enough — don't
 * make the icons too small." So the mark here is 2.4rem inside a 4rem optical
 * target, with the label beneath at a readable size. Previously icons were
 * inline chips at ~14px, which read as decoration.
 *
 * Sourcing follows `src/data/skill-icons.ts`: official brand marks where they
 * exist, an own-drawn geometric fallback otherwise. A skill with no icon
 * renders as a text tile — never a broken image.
 *
 * NO PERCENTAGES. No proficiency level is documented anywhere in the source
 * material, so none is shown.
 */
import { getSkillIcon } from '@/data/skill-icons';

interface Props {
  name: string;
  icon: string | null;
  /** Compact variant used inside denser lists. */
  small?: boolean;
}

const { name, icon, small = false } = Astro.props;
const mark = getSkillIcon(icon);
---

<div class:list={['st', small && 'st--small', !mark && 'st--text']}>
  <span class="st__mark" aria-hidden="true">
    {
      mark ? (
        <svg viewBox="0 0 24 24" width="100%" height="100%" role="presentation">
          <path d={mark.path} fill={mark.hex ?? 'currentColor'} />
        </svg>
      ) : (
        /* Text-only skill: a monogram of its initial keeps the grid aligned. */
        <span class="st__mono">{name.charAt(0).toUpperCase()}</span>
      )
    }
  </span>

  <span class="st__name">{name}</span>
</div>

<style>
  .st {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0.6rem;
    height: 100%;
    padding: clamp(0.85rem, 2vw, 1.15rem) 0.6rem;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-xs);
    background-color: color-mix(in srgb, var(--surface) 70%, transparent);
    text-align: center;
    transition:
      border-color var(--t-base) var(--ease),
      background-color var(--t-base) var(--ease),
      transform var(--t-base) var(--ease);
  }

  .st:hover {
    border-color: var(--border-strong);
    background-color: var(--surface-2);
    transform: translateY(-2px);
  }

  /* ---- the mark: 2.4rem is the point of this component ---- */
  .st__mark {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    flex: none;
    color: var(--fg);
    transition: color var(--t-base) var(--ease);
  }

  .st:hover .st__mark {
    color: var(--fg-strong);
  }

  .st__mark svg {
    display: block;
  }

  /* Text-only skills: no brand colour, so it inherits the foreground. */
  .st__mono {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-style: italic;
    color: var(--accent);
    line-height: 1;
  }

  .st__name {
    font-size: var(--text-xs);
    line-height: 1.3;
    color: var(--fg-muted);
    /* Long tool names wrap rather than shrink the mark. */
    text-wrap: balance;
  }

  .st--text .st__name {
    color: var(--fg-subtle);
  }

  /* ---- compact ---- */
  .st--small {
    flex-direction: row;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    text-align: left;
  }

  .st--small .st__mark {
    width: 1.5rem;
    height: 1.5rem;
  }

  .st--small .st__name {
    font-size: var(--text-sm);
  }
</style>
