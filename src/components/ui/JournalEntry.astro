---
/**
 * JOURNAL ENTRY — one dated record, rendered flexibly.
 *
 * THE IMAGE SLOT IS THE POINT OF THIS COMPONENT: the layout is chosen from the
 * count of images that actually exists, so an entry may carry zero photographs
 * today and gain two next week.
 *
 *   0 images   text only — no empty frame, no "no image" box
 *   1 image    full width, at its own aspect ratio (no crop)
 *   2 images   side by side
 *   3+ images  a row that wraps, every tile the same shape
 */
import type { JournalEntry, MediaAsset } from '@/types/content';
import { asset } from '@/utils/url';
import { getImageDims } from '@/data/image-dims';

interface Props {
  entry: JournalEntry;
}

const { entry } = Astro.props;

const media: MediaAsset[] = entry.media ?? [];
const count = media.length;

/**
 * Render inline `**emphasis**` from the source text.
 *
 * Splitting on the marker rather than running a full markdown pass keeps this
 * honest: only the one construct the source uses is interpreted, so nothing else
 * in the text can be silently rewritten. The text is escaped FIRST, so an entry
 * containing `<` renders as the character rather than as markup.
 */
function render(text: string): string {
  const escaped = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  return escaped.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
}

---

<article class="jr__entry" id={`entry-${entry.id}`} data-reveal>
  <header class="jr__head">
    <p class="jr__meta">
      <time class="jr__date mono" datetime={entry.date}>{entry.dateLabel}</time>
    </p>
    <h3 class="jr__title">{entry.title}</h3>
  </header>

  <div class="jr__body">
    {entry.body.map((p) => <p class="jr__p" set:html={render(p)} />)}
  </div>

  {
    count > 0 && (
      <div class:list={['jr__media', `jr__media--${count === 1 ? 'one' : count === 2 ? 'two' : 'many'}`]}>
        {media.map((m) => {
          const dims =
            getImageDims(m.src) ??
            (m.width && m.height ? ([m.width, m.height] as [number, number]) : null);
          return (
            <figure class="jr__figure">
              <button
                type="button"
                class="jr__shot"
                data-lightbox-src={asset(m.src)}
                data-lightbox-alt={m.alt}
                data-lightbox-caption={m.caption ?? m.alt}
                aria-label={`View larger: ${m.alt}`}
              >
                <img
                  src={asset(m.src)}
                  alt={m.alt}
                  width={dims?.[0] ?? m.width}
                  height={dims?.[1] ?? m.height}
                  loading="lazy"
                  decoding="async"
                />
              </button>
              {m.caption && <figcaption class="jr__cap mono">{m.caption}</figcaption>}
            </figure>
          );
        })}
      </div>
    )
  }
</article>

<style>
  /* One column of prose: an entry is read top to bottom, so splitting it into a
     text column plus a rail would fragment a narrative. */
  .jr__entry {
    padding-block: clamp(2.25rem, 4.5vw, 3.25rem);
    border-top: var(--hairline) solid var(--border);
  }

  .jr__head {
    max-width: 68ch;
    margin-bottom: clamp(1rem, 2vw, 1.4rem);
  }

  .jr__meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 0.6rem;
  }

  /* A short accent rule before the date — the shared editorial marker used by
     the page headers. */
  .jr__meta::before {
    content: '';
    width: 1.6rem;
    height: 2px;
    background-color: var(--accent);
    flex: 0 0 auto;
  }

  .jr__date {
    color: var(--fg-subtle);
    letter-spacing: 0.04em;
    font-size: var(--text-2xs);
  }

  .jr__title {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 1.1rem + 1.4vw, 2rem);
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: -0.015em;
    color: var(--fg-strong);
    text-wrap: balance;
  }

  /* Body text is read rather than scanned: the muted (not faint) foreground at
     reading size with generous leading. */
  .jr__p {
    max-width: 68ch;
    font-size: var(--text-lg);
    line-height: 1.72;
    color: var(--fg-muted);
  }

  .jr__p + .jr__p {
    margin-top: 1.15rem;
  }

  /* Emphasis carries the source's own emphasis; it is not decoration. */
  .jr__p :global(strong) {
    font-weight: 600;
    color: var(--fg);
  }

  .jr__media {
    display: grid;
    gap: clamp(0.6rem, 1.4vw, 0.9rem);
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  /* One image gets the full measure and its OWN ratio — a lone screenshot or
     photograph should not be cropped to a shape the grid imposed. */
  .jr__media--one {
    grid-template-columns: 1fr;
  }

  .jr__media--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* Three or more: wrap into rows of equal tiles. `auto-fit` means the count
     decides the arrangement, so four images and seven both work without a rule
     per case. */
  .jr__media--many {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
  }

  .jr__figure {
    margin: 0;
    min-width: 0;
  }

  .jr__shot {
    display: block;
    width: 100%;
    padding: 0;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-xs);
    background-color: var(--photo-mat);
    overflow: hidden;
    cursor: zoom-in;
  }

  .jr__shot img {
    display: block;
    width: 100%;
    height: auto;
    /* Native ratio, never cropped: these are the person's own photographs of a
       moment, and a crop decides which part of it mattered. */
    object-fit: contain;
    transition: transform var(--t-slow) var(--ease);
  }

  .jr__shot:hover img {
    transform: scale(1.02);
  }

  .jr__shot:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .jr__cap {
    display: block;
    margin-top: 0.5rem;
    color: var(--fg-faint);
    font-size: var(--text-2xs);
    line-height: 1.5;
  }

</style>
