---
/**
 * PROJECT CARD — one project, in one of three editorial sizes.
 *
 * The brief objected that the previous cards were "too plain" and that every
 * project looked equally important. So this card has variants that differ in
 * KIND, not just size:
 *
 *   hero    a wide 2-column spread: big visual left, indexed text right
 *   wide    visual on top, generous text below, index + category row
 *   tall    a narrow portrait card for UI/UX shots
 *
 * Shared anatomy (all variants): index number, category, title, description,
 * tools, and a CTA — plus a hover that lifts the frame rather than the card.
 */
import type { ProjectEntry } from '@/types/content';
import { PROJECT_CATEGORY_LABELS } from '@/types/content';
import { getImageDims } from '@/data/image-dims';

interface Props {
  project: ProjectEntry;
  /** 1-based position, rendered as the "01" index. */
  index: number;
  variant?: 'hero' | 'wide' | 'tall';
}

const { project, index, variant: variantProp } = Astro.props;

const num = String(index).padStart(2, '0');
const primary = project.categories[0];
const href = `/projects/${project.id}`;

/** Real pixel dimensions for the reserved space and intrinsic attributes. */
const dims =
  getImageDims(project.visual.src) ??
  (project.visual.width && project.visual.height
    ? ([project.visual.width, project.visual.height] as [number, number])
    : null);

/**
 * Variant, derived from the IMAGE rather than the project's category.
 *
 * Choosing it from the category sent a landscape desktop screenshot into a 9:16
 * frame purely because the project was classified as UI/UX, which cut its
 * content in half. Aspect ratio is the honest signal, so it decides. A caller
 * can still override — the homepage's lead spread passes `hero`.
 *
 * THREE bands, not two:
 *   ar < 0.6     a phone screenshot (~0.49)   → tall, 9:16
 *   0.6 – 1.05   a document page   (~0.71-1.0) → the DOCUMENT frame, 4:5
 *   ar > 1.05    a dashboard or desktop shot  → wide, 16:10
 *
 * The boundary sits at 0.6 rather than 0.8 because a phone screenshot (~0.49)
 * and a journal page (~0.71) are genuinely different shapes, and the earlier 0.8
 * cut put BOTH into the 9:16 frame. A page in a 9:16 frame is far taller than the
 * page itself, so it letterboxed into a narrow strip floating in empty matte.
 */
function frameFor(src: string): { variant: 'wide' | 'tall'; ratio: string } {
  const d = getImageDims(src);
  const ar = d ? d[0] / d[1] : 1.5;
  if (ar < 0.6) return { variant: 'tall', ratio: '9 / 16' };
  if (ar <= 1.05) return { variant: 'wide', ratio: '4 / 5' };
  return { variant: 'wide', ratio: '16 / 10' };
}

const derived = frameFor(project.visual.src);
const variant = variantProp ?? derived.variant;
/** `hero` is a wide composition by definition, so it takes the landscape ratio. */
const ratio = variant === 'tall' ? '9 / 16' : derived.ratio;

/**
 * Frame ratio, resolved in CSS.
 *
 * The frame used to take each image's OWN ratio, which made every card in a row
 * a different height — a 1.78 dashboard beside a 0.49 phone screenshot beside a
 * 0.71 journal cover never lined up, and the row read as unconsidered. One ratio
 * per variant is what makes the grid align; the image then FITS that frame.
 */
const ratioStyle = `--frame-ratio: ${ratio};`;

/**
 * How the image fills the frame.
 *
 * `contain` letterboxes a document rather than cropping it: a journal cover
 * forced into `cover` loses its masthead, so the picture stops being evidence of
 * the publication it is meant to show.
 */
const fit = project.visual.fit ?? 'cover';
---

<article class:list={['pc', `pc--${variant}`]} style={ratioStyle}>
  <a href={href} class="pc__link" aria-label={`${project.title} — view project`}>
    <!-- ---------------- visual ---------------- -->
    <div class:list={['pc__frame', fit === 'contain' && 'pc__frame--contain']}>
      <img
        src={project.visual.src}
        alt={project.visual.alt}
        width={dims?.[0] ?? project.visual.width}
        height={dims?.[1] ?? project.visual.height}
        loading="lazy"
        decoding="async"
      />
      <span class="pc__scan" aria-hidden="true"></span>
    </div>

    <!-- ---------------- text ---------------- -->
    <div class="pc__body">
      <p class="pc__meta">
        <span class="pc__num" aria-hidden="true">{num}</span>
        <span class="pc__cat mono">{PROJECT_CATEGORY_LABELS[primary]}</span>
        {project.year && <span class="pc__year mono">{project.year}</span>}
      </p>

      <h3 class="pc__title">{project.title}</h3>

      <p class="pc__tag">{project.tagline}</p>

      {
        project.tools.length > 0 && (
          <ul class="pc__tools" aria-label="Tools">
            {project.tools.slice(0, 4).map((t) => (
              <li class="pc__tool mono">{t}</li>
            ))}
          </ul>
        )
      }

      <span class="pc__cta">
        <span>View project</span>
        <span class="pc__arrow" aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</article>

<style>
  /* ==========================================================================
     BASE
     ========================================================================== */
  .pc {
    margin: 0;
  }

  /*
    Cards in a row are equal height and each card's text block is a flex column,
    so the CTA can be pinned to the bottom. Without that, a card whose title runs
    to two lines leaves its link sitting at a different height from its
    neighbour's — which is what makes an otherwise-aligned grid look untidy.
  */
  .pc__link {
    display: grid;
    gap: clamp(1rem, 2vw, 1.6rem);
    height: 100%;
    align-content: start;
    text-decoration: none;
  }

  /* ---------------- visual frame ---------------- */
  .pc__frame {
    position: relative;
    overflow: hidden;
    border: var(--hairline) solid var(--photo-edge);
    border-radius: var(--r-xs);
    /*
      The matte behind the image: visible when a document is letterboxed, and it
      also stops a transparent PNG from showing the page background through it.
    */
    background-color: var(--photo-mat);
    /* One ratio per variant, from the frontmatter — this is what aligns the row. */
    aspect-ratio: var(--frame-ratio, 16 / 10);
  }

  .pc__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--photo-filter);
    transition: transform var(--t-slow) var(--ease);
  }

  /*
    Documents are letterboxed, not cropped.

    A journal cover or a paper's first page carries its meaning at the edges — the
    masthead, the volume number, the first column of a table. Filling the frame
    (`cover`) cut those off, so the image stopped being evidence of the
    publication it claimed to show. `contain` keeps the whole page, and the matte
    makes the letterboxing read as a deliberate plate.
  */
  .pc__frame--contain img {
    object-fit: contain;
    padding: 0.9rem;
  }

  /* A burgundy rule that wipes across the frame on hover — the "subtle hover"
     the brief asks for, without moving the whole card. */
  .pc__scan {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background-color: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-slow) var(--ease);
  }

  .pc__link:hover .pc__scan,
  .pc__link:focus-visible .pc__scan {
    transform: scaleX(1);
  }

  .pc__link:hover .pc__frame img {
    transform: scale(1.035);
  }

  /* ---------------- text ---------------- */
  .pc__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
  }

  .pc__meta {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    width: 100%;
  }

  .pc__num {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--accent);
    line-height: 1;
  }

  .pc__cat {
    color: var(--fg-faint);
  }

  .pc__year {
    margin-inline-start: auto;
    color: var(--fg-faint);
  }

  .pc__title {
    margin-top: 0.55rem;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.018em;
    color: var(--fg-strong);
    transition: color var(--t-base) var(--ease);
  }

  .pc__link:hover .pc__title,
  .pc__link:focus-visible .pc__title {
    color: var(--accent);
  }

  .pc__tag {
    margin-top: 0.6rem;
    max-width: 52ch;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .pc__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .pc__tool {
    padding: 0.24rem 0.55rem;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-full);
    color: var(--fg-subtle);
    text-transform: none;
    letter-spacing: 0.03em;
  }

  /* Pins the CTA to the bottom of the card so a row's links line up. */
  .pc__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.15rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-strong);
    transition: color var(--t-fast) var(--ease);
  }

  .pc__link:hover .pc__cta {
    color: var(--accent);
  }

  .pc__arrow {
    transition: transform var(--t-base) var(--ease);
  }

  .pc__link:hover .pc__arrow {
    transform: translateX(4px);
  }

  /* ==========================================================================
     VARIANT: hero — a wide 2-column spread
     ========================================================================== */
  @media (min-width: 860px) {
    .pc--hero .pc__link {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(1.5rem, 3.5vw, 3rem);
    }
  }

  /* ==========================================================================
     VARIANT: wide — stacked, room for a longer description
     ========================================================================== */
  .pc--wide .pc__title {
    font-size: var(--text-xl);
  }

  /* ==========================================================================
     VARIANT: tall — for portrait phone screens
     ========================================================================== */
  .pc--tall .pc__frame {
    /*
      9:16, not 3:4. These are phone-app screenshots whose native ratio is
      ~0.49 (already close to 9:16). Forcing 3:4 cut about a third of the
      height, which removed the navigation bar and the lower content of every
      screen — the frames looked cropped rather than composed. 9:16 is only a
      small trim from native and reads as a deliberate phone frame.

      max-height still caps the column so a tall shot cannot dominate the grid.
    */
    aspect-ratio: 9 / 16;
    max-height: 30rem;
  }

  .pc--tall .pc__title {
    font-size: var(--text-lg);
  }

  .pc--tall .pc__tag {
    font-size: var(--text-sm);
  }
</style>
