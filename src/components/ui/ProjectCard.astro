---
import { asset, withBase } from '@/utils/url';
/**
 * PROJECT CARD — one project.
 *
 * ONE SHAPE, EVERY CARD: every card uses the 16:10 frame whatever its images are.
 * Earlier revisions derived the frame from each image, producing THREE ratios in
 * one list (1.60, 0.56, 0.80) so rows never aligned. A multi-image project's
 * cover becomes a SLIDER, so extra documentation is reachable without a different
 * shape.
 *
 * NO WRAPPING <a>: a slider needs <button> elements and a <button> inside an <a>
 * is invalid HTML. The card is a container, the TITLE carries a real link
 * stretched over the card by a pseudo-element, and the slider's arrows sit above
 * that layer with their own stacking context.
 *
 * Documents are letterboxed in the frame rather than cropped — their meaning
 * lives at the edges.
 */
import type { ProjectEntry, MediaAsset } from '@/types/content';
import { PROJECT_CATEGORY_LABELS } from '@/types/content';
import { getImageDims } from '@/data/image-dims';
import ShotSlider from './ShotSlider.astro';

interface Props {
  project: ProjectEntry;
  /** 1-based position, rendered as the "01" index. */
  index: number;
  /** Kept for the homepage spread; the grid no longer varies the frame. */
  variant?: 'hero' | 'wide' | 'tall';
}

const { project, index, variant = 'wide' } = Astro.props;

const num = String(index).padStart(2, '0');
const primary = project.categories[0];
const href = withBase(`/projects/${project.id}`);

/** Real pixel dimensions for the reserved space and intrinsic attributes. */
const dims =
  getImageDims(project.visual.src) ??
  (project.visual.width && project.visual.height
    ? ([project.visual.width, project.visual.height] as [number, number])
    : null);

const FRAME_RATIO = '16 / 10';

/**
 * Every image this project owns, hero first, deduplicated. The gallery previously
 * repeated the hero as its first entry, so the slider opened on the same picture
 * twice.
 */
const shots: MediaAsset[] = [
  project.visual,
  ...(project.gallery ?? []).filter((g) => g.src !== project.visual.src),
];
const many = shots.length > 1;

/**
 * Is this project a set of PHONE SCREENS?
 *
 * Same rule as `ProjectRow.astro`, for the same measured reason: a 0.488-ratio
 * device in a 16:10 frame used about a quarter of the box's width — measured on a
 * related-project card, frame 552x345 with the phone rendering 128x295 (77% of
 * the frame was empty matte around a phone that already has its own bezel).
 *
 * Documents (`fit: 'contain'`) are excluded: a journal page is portrait too, but
 * a page is read on a matte, not a device standing on the page.
 */
const isPortrait = (m: MediaAsset) => {
  const ar = m.width && m.height ? m.width / m.height : 1.5;
  return ar < 0.75 && m.fit !== 'contain';
};
const phones = shots.length > 0 && shots.every(isPortrait);

/** The device ratio, read off the real image so the box matches it. */
const phoneAr =
  project.visual.width && project.visual.height
    ? (project.visual.width / project.visual.height).toFixed(4)
    : '0.488';

---

<article
  class:list={['pc', `pc--${variant}`, phones && 'pc--phones']}
  style={`--frame-ratio: ${FRAME_RATIO}; --phone-ar: ${phoneAr};`}
>
  <div class="pc__inner">
    <div
      class:list={[
        'pc__frame',
        !phones && project.visual.fit === 'contain' && 'pc__frame--contain',
      ]}
    >
      {
        phones ? (
          <div class="pc__ph">
            {many ? (
              <ShotSlider
                images={shots}
                ratio={phoneAr}
                lightbox={false}
                fit="cover"
                mockup
              />
            ) : (
              <img
                src={asset(project.visual.src)}
                alt={project.visual.alt}
                width={dims?.[0] ?? project.visual.width}
                height={dims?.[1] ?? project.visual.height}
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
        ) : many ? (
          /*
            No `fit` override: each image answers for itself. Forcing `contain` on
            every slide letterboxed photographs as well as documents — see the note
            on `.pc__frame img`.
          */
          <ShotSlider
            images={shots}
            ratio={FRAME_RATIO}
            lightbox={false}
            pairNarrow
            mockup
          />
        ) : (
          <img
            src={asset(project.visual.src)}
            alt={project.visual.alt}
            width={dims?.[0] ?? project.visual.width}
            height={dims?.[1] ?? project.visual.height}
            loading="lazy"
            decoding="async"
          />
        )
      }
      <span class="pc__scan" aria-hidden="true"></span>
    </div>

    <!-- text -->
    <div class="pc__body">
      <p class="pc__meta">
        <span class="pc__num" aria-hidden="true">{num}</span>
        <span class="pc__cat mono">{PROJECT_CATEGORY_LABELS[primary]}</span>
        {project.year && <span class="pc__year mono">{project.year}</span>}
      </p>

      <h3 class="pc__title">
        <a href={href} class="pc__link">{project.title}</a>
      </h3>

      <p class="pc__tag">{project.tagline}</p>

      {
        project.tools.length > 0 && (
          <ul class="pc__tools" aria-label={`Tools (${project.tools.length})`}>
            {project.tools.slice(0, 5).map((t) => (
              <li class="pc__tool mono">{t}</li>
            ))}
            {project.tools.length > 5 && (
              <li class="pc__tool pc__tool--more mono" aria-hidden="true">
                +{project.tools.length - 5}
              </li>
            )}
          </ul>
        )
      }

      {/* A real link — see the note in `ProjectRow.astro`: a `<span>` that looks
          pressable is unreachable by keyboard and does nothing on click. */}
      <a href={href} class="pc__cta">
        <span>View project</span>
        <span class="pc__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>

<style>
  .pc {
    position: relative;
    margin: 0;
    height: 100%;
  }

  .pc__inner {
    display: grid;
    gap: clamp(1rem, 2vw, 1.6rem);
    height: 100%;
    align-content: start;
  }

  .pc__frame {
    position: relative;
    overflow: hidden;
    border: var(--hairline) solid var(--photo-edge);
    border-radius: var(--r-xs);
    background-color: var(--photo-mat);
    aspect-ratio: var(--frame-ratio, 16 / 10);
  }

  .pc__frame :global(.sl__viewport) {
    height: 100%;
    border-radius: 0;
  }

  /* phone screens: no frame
     The device render is a cut-out with its own bezel and shadow, so the card
     shows it directly. Measured before this change: a related-project card drew a
     552x345 frame around a 128x295 phone — 77% of the box was empty matte. The box
     that remains is TRANSPARENT and BORDERLESS: no visible edges, but it still
     reserves layout space and gives the slider somewhere to live.

     CAPPED TO THE DASHBOARD CARD'S HEIGHT: a phone at the frame's full width would
     stand 492px tall beside a 345px dashboard card, ending two equal cards at
     different heights. The cap stops binding on a narrow screen, where the device
     takes the width it has. */
  .pc--phones .pc__frame {
    aspect-ratio: auto;
    border: 0;
    background-color: transparent;
    overflow: visible;
  }

  .pc__ph {
    width: 100%;
    /* Roughly the 16:10 frame's height at this card's width, so a phone card and
       a dashboard card sit at a similar level — while keeping the interface inside
       the device readable. */
    max-width: 12.5rem;
    margin-inline: auto;
    aspect-ratio: var(--phone-ar, 0.488);
  }

  @media (max-width: 700px) {
    .pc__ph {
      /* One card per row below this width, so there is nothing to line up with. */
      max-width: 14rem;
    }
  }

  .pc__ph img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    /* Depth follows the ALPHA silhouette — the bezel, not a rectangle around it. */
    filter: var(--photo-filter) drop-shadow(0 2px 4px rgba(0, 0, 0, 0.34))
      drop-shadow(0 14px 30px rgba(0, 0, 0, 0.3));
  }

  :global([data-theme='light']) .pc__ph img {
    filter: var(--photo-filter) drop-shadow(0 2px 4px rgba(62, 46, 30, 0.18))
      drop-shadow(0 14px 28px rgba(62, 46, 30, 0.16));
  }

  /* The sliding rail already sizes its own track from `ratio`; inside a phone
     card that ratio is the device's, so the rail must fill the box without
     re-imposing a matte. */
  .pc--phones :global(.sl__viewport) {
    background-color: transparent;
    border: 0;
  }

  .pc__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--photo-filter);
    transition: transform var(--t-slow) var(--ease);
  }

  /*
    A single-image document is letterboxed, not cropped: a journal cover or a
    paper's first page carries its meaning at the edges (the masthead, the volume
    number), which `cover` cuts off.
  */
  .pc__frame--contain img {
    object-fit: contain;
    padding: 0.9rem;
  }

  .pc__scan {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    z-index: 3;
    background-color: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-slow) var(--ease);
  }

  .pc:hover .pc__scan,
  .pc:has(.pc__link:focus-visible) .pc__scan {
    transform: scaleX(1);
  }

  /* Zoom only applies to a plain image; a slider's slides must not shift under
     the pointer while it is being swiped. */
  .pc:hover .pc__frame > img {
    transform: scale(1.035);
  }

  /* ---------------- the stretched link ---------------- */
  /*
    z-index: 2 puts the anchor above the image but BELOW the slider controls
    (z-index: 3), so the arrows and the rail keep their own clicks while the rest
    of the card navigates.
  */
  .pc__link {
    text-decoration: none;
    color: inherit;
  }

  /*
    STRETCHED LINK — the same fix as in `ProjectRow.astro`, and the same bug.
    With `position: relative` on `.pc__link`, the `::after` covered only the link's
    own box (measured 79x31px inside a 552x631px card), so almost none of the card
    navigated. Dropping the inline `position` lets the nearest positioned ancestor
    (`.pc`) contain it, so `inset: 0` means the whole card.
  */
  .pc__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: var(--r-xs);
  }

  .pc__link:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .pc__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
  }

  .pc__meta {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    width: 100%;
  }

  .pc__num {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--accent);
    line-height: 1;
  }

  .pc__cat {
    color: var(--fg-faint);
  }

  .pc__year {
    margin-inline-start: auto;
    color: var(--fg-faint);
  }

  .pc__title {
    margin-top: 0.55rem;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.018em;
    color: var(--fg-strong);
    transition: color var(--t-base) var(--ease);
  }

  .pc:hover .pc__title,
  .pc:has(.pc__link:focus-visible) .pc__title {
    color: var(--accent);
  }

  .pc__tag {
    margin-top: 0.6rem;
    max-width: 52ch;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  /* Tools as small labelled chips: the first takes the accent, so a row of tools
     is not identical grey pills. */
  .pc__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.45rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .pc__tool {
    padding: 0.24rem 0.6rem;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-full);
    background-color: color-mix(in srgb, var(--surface-3) 55%, transparent);
    color: var(--fg-subtle);
    text-transform: none;
    letter-spacing: 0.03em;
    transition:
      border-color var(--t-fast) var(--ease),
      color var(--t-fast) var(--ease);
  }

  .pc__tool:first-child {
    border-color: var(--accent-line);
    color: var(--accent);
  }

  .pc:hover .pc__tool {
    border-color: var(--border-strong);
  }

  .pc:hover .pc__tool:first-child {
    border-color: var(--accent);
  }

  /* The overflow chip reads as a count, not as a tool. */
  .pc__tool--more {
    border-style: dashed;
    color: var(--fg-faint);
  }

  /* Pins the CTA to the bottom of the card so a row's links line up. */
  .pc__cta {
    /* Above the stretched link (`z-index: 2`) so the CTA receives its own click and
       keyboard focus. */
    position: relative;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.15rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-strong);
    text-decoration: none;
    transition: color var(--t-fast) var(--ease);
  }

  .pc__cta:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .pc:hover .pc__cta {
    color: var(--accent);
  }

  .pc__arrow {
    transition: transform var(--t-base) var(--ease);
  }

  .pc:hover .pc__arrow {
    transform: translateX(4px);
  }

  /* VARIANT: hero — a wide 2-column spread (homepage only) */
  @media (min-width: 860px) {
    .pc--hero .pc__inner {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(1.5rem, 3.5vw, 3rem);
    }

    .pc--hero .pc__cta {
      margin-top: 0;
    }
  }

  /* VARIANT: tall (the grid itself uses one ratio) */
  .pc--tall .pc__frame {
    aspect-ratio: 9 / 16;
    max-height: 30rem;
  }
</style>
