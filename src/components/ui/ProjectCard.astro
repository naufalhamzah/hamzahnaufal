---
/**
 * PROJECT CARD — one project, in one of three editorial sizes.
 *
 * The brief objected that the previous cards were "too plain" and that every
 * project looked equally important. So this card has variants that differ in
 * KIND, not just size:
 *
 *   hero    a wide 2-column spread: big visual left, indexed text right
 *   wide    visual on top, generous text below, index + category row
 *   tall    a narrow portrait card for UI/UX shots
 *
 * Shared anatomy (all variants): index number, category, title, description,
 * tools, and a CTA — plus a hover that lifts the frame rather than the card.
 */
import type { ProjectEntry } from '@/types/content';
import { PROJECT_CATEGORY_LABELS } from '@/types/content';
import { getImageDims } from '@/data/image-dims';

interface Props {
  project: ProjectEntry;
  /** 1-based position, rendered as the "01" index. */
  index: number;
  variant?: 'hero' | 'wide' | 'tall';
}

const { project, index, variant = 'wide' } = Astro.props;

const num = String(index).padStart(2, '0');
const primary = project.categories[0];
const href = `/projects/${project.id}`;

/**
 * Real pixel dimensions, so the frame reserves space and nothing shifts.
 * Prefers the generated map, falling back to whatever the data file declares.
 */
const dims =
  getImageDims(project.visual.src) ??
  (project.visual.width && project.visual.height
    ? ([project.visual.width, project.visual.height] as [number, number])
    : null);
const ratioStyle = `--ar: ${dims ? (dims[1] / dims[0]).toFixed(4) : 0.6667}`;
---

<article class:list={['pc', `pc--${variant}`]} style={ratioStyle}>
  <a href={href} class="pc__link" aria-label={`${project.title} — view project`}>
    <!-- ---------------- visual ---------------- -->
    <div class="pc__frame">
      <img
        src={project.visual.src}
        alt={project.visual.alt}
        width={dims?.[0] ?? project.visual.width}
        height={dims?.[1] ?? project.visual.height}
        loading="lazy"
        decoding="async"
      />
      <span class="pc__scan" aria-hidden="true"></span>
    </div>

    <!-- ---------------- text ---------------- -->
    <div class="pc__body">
      <p class="pc__meta">
        <span class="pc__num" aria-hidden="true">{num}</span>
        <span class="pc__cat mono">{PROJECT_CATEGORY_LABELS[primary]}</span>
        {project.year && <span class="pc__year mono">{project.year}</span>}
      </p>

      <h3 class="pc__title">{project.title}</h3>

      <p class="pc__tag">{project.tagline}</p>

      {
        project.tools.length > 0 && (
          <ul class="pc__tools" aria-label="Tools">
            {project.tools.slice(0, 4).map((t) => (
              <li class="pc__tool mono">{t}</li>
            ))}
          </ul>
        )
      }

      <span class="pc__cta">
        <span>View project</span>
        <span class="pc__arrow" aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</article>

<style>
  /* ==========================================================================
     BASE
     ========================================================================== */
  .pc {
    margin: 0;
  }

  .pc__link {
    display: grid;
    gap: clamp(1rem, 2vw, 1.6rem);
    text-decoration: none;
  }

  /* ---------------- visual frame ---------------- */
  .pc__frame {
    position: relative;
    overflow: hidden;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-xs);
    background-color: var(--surface-2);
    /* aspect-ratio comes from the real image, so the reserved space matches
       and there is no layout shift on load */
    aspect-ratio: 1 / var(--ar, 0.6667);
  }

  .pc__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-slow) var(--ease);
  }

  /* A burgundy rule that wipes across the frame on hover — the "subtle hover"
     the brief asks for, without moving the whole card. */
  .pc__scan {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background-color: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-slow) var(--ease);
  }

  .pc__link:hover .pc__scan,
  .pc__link:focus-visible .pc__scan {
    transform: scaleX(1);
  }

  .pc__link:hover .pc__frame img {
    transform: scale(1.035);
  }

  /* ---------------- text ---------------- */
  .pc__meta {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }

  .pc__num {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--accent);
    line-height: 1;
  }

  .pc__cat {
    color: var(--fg-faint);
  }

  .pc__year {
    margin-inline-start: auto;
    color: var(--fg-faint);
  }

  .pc__title {
    margin-top: 0.55rem;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.018em;
    color: var(--fg-strong);
    transition: color var(--t-base) var(--ease);
  }

  .pc__link:hover .pc__title,
  .pc__link:focus-visible .pc__title {
    color: var(--accent);
  }

  .pc__tag {
    margin-top: 0.6rem;
    max-width: 52ch;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .pc__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .pc__tool {
    padding: 0.24rem 0.55rem;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-full);
    color: var(--fg-subtle);
    text-transform: none;
    letter-spacing: 0.03em;
  }

  .pc__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.15rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-strong);
    transition: color var(--t-fast) var(--ease);
  }

  .pc__link:hover .pc__cta {
    color: var(--accent);
  }

  .pc__arrow {
    transition: transform var(--t-base) var(--ease);
  }

  .pc__link:hover .pc__arrow {
    transform: translateX(4px);
  }

  /* ==========================================================================
     VARIANT: hero — a wide 2-column spread
     ========================================================================== */
  @media (min-width: 860px) {
    .pc--hero .pc__link {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(1.5rem, 3.5vw, 3rem);
    }
  }

  /* ==========================================================================
     VARIANT: wide — stacked, room for a longer description
     ========================================================================== */
  .pc--wide .pc__title {
    font-size: var(--text-xl);
  }

  /* ==========================================================================
     VARIANT: tall — for portrait phone screens
     ========================================================================== */
  .pc--tall .pc__frame {
    /* Cap the height so a 9:16 phone shot does not become 900px tall. */
    aspect-ratio: 3 / 4;
    max-height: 30rem;
  }

  .pc--tall .pc__title {
    font-size: var(--text-lg);
  }

  .pc--tall .pc__tag {
    font-size: var(--text-sm);
  }
</style>
