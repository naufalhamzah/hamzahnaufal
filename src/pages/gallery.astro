---
/**
 * GALLERY / MOMENTS — the full set of personal and activity photographs.
 *
 * SPLIT BY COLLECTION (the SETTING a photograph comes from — campus vs
 * workplace), not an undifferentiated wall. Every photo currently held is campus;
 * the internship collection is declared in the data layer and renders
 * automatically once workplace photos are added.
 *
 * WHY NOT FILED UNDER AN EMPLOYER: the photographs are not organised by activity,
 * so attributing any to AirNav, PLN or Beauty Innovation Laboratories would be an
 * assumption. Only images whose employer is unambiguous from the image itself sit
 * inside an Experience entry.
 *
 * LAYOUT: masonry columns, not equal tiles, so portrait and landscape photos each
 * keep their natural shape.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import { galleryEntries, galleryByCollection } from '@/data/gallery';
import { profile } from '@/data/profile';
import { asset } from '@/utils/url';

/**
 * State the split itself — how many photographs are in each collection INCLUDING
 * the empty one. Showing the zero is the honest move: the internship collection
 * is declared and waiting for material, and a page that says so is more
 * trustworthy than one that quietly hides the gap.
 */
const campusCount = galleryEntries.filter((g) => g.collection === 'campus').length;
const internshipCount = galleryEntries.length - campusCount;

const meta = [
  { label: 'Photographs', value: String(galleryEntries.length) },
  { label: 'Campus & organisations', value: String(campusCount) },
  {
    label: 'Internships & workplace',
    value: internshipCount === 0 ? 'Awaiting material' : String(internshipCount),
  },
];
---

<BaseLayout
  title={`Gallery — ${profile.name}`}
  description="Selected moments from committees, field programmes and campus activities — a collection of personal and activity photographs."
>
  <PageHeader
    index="08"
    eyebrow="Gallery"
    title="Selected moments"
    standfirst="Committee work, field programmes and campus activity. These are collected by setting rather than filed under a particular job, because most photographs do not identify which role they belong to on their own."
    meta={meta}
  />

  <section class="gl" aria-label="Photographs">
    <div class="shell">
      {
        galleryByCollection.map((collection) => (
          <section
            class="gl__group"
            aria-labelledby={`gl-${collection.id}`}
          >
            <header class="gl__head">
              <div class="gl__head-main">
                <h2 id={`gl-${collection.id}`} class="gl__title">
                  {collection.label}
                </h2>
                <p class="gl__blurb">{collection.blurb}</p>
              </div>
              <p class="mono gl__count">
                {collection.items.length}{' '}
                {collection.items.length === 1 ? 'photo' : 'photos'}
              </p>
            </header>

            {/* CSS columns give masonry with no JS and no fixed aspect ratios;
                the number of photos can change freely. */}
            <div class="gl__masonry" data-lightbox-group>
              {collection.items.map((g, i) => (
                <button
                  type="button"
                  class:list={['gl__item', i === 0 && 'gl__item--feature']}
                  data-lightbox-src={asset(g.visual.src)}
                  data-lightbox-alt={g.visual.alt}
                  data-lightbox-caption={g.caption}
                  aria-label={`View larger: ${g.visual.alt}`}
                >
                  <img
                    src={asset(g.visual.src)}
                    alt={g.visual.alt}
                    width={g.visual.width}
                    height={g.visual.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="gl__cap">{g.caption}</span>
                </button>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .gl {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) var(--space-section);
  }

  .gl__group + .gl__group {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: clamp(3rem, 6vw, 4.5rem);
    border-top: var(--hairline) solid var(--border);
  }

  /* A masthead, not a label row: display title, description beneath, count held
     to the right as the only mono element, so it reads as a caption not a rival. */
  .gl__head {
    display: grid;
    gap: 0.75rem 2rem;
    grid-template-columns: 1fr;
    align-items: end;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
    padding-bottom: clamp(1rem, 2vw, 1.5rem);
    border-bottom: var(--hairline) solid var(--border-faint);
  }

  @media (min-width: 760px) {
    .gl__head {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .gl__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--fg-strong);
  }

  .gl__blurb {
    margin-top: 0.5rem;
    max-width: 62ch;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .gl__count {
    color: var(--fg-faint);
    white-space: nowrap;
  }

  /* ---- masonry via CSS columns ---- */
  .gl__masonry {
    columns: 1;
    column-gap: clamp(0.6rem, 1.5vw, 1rem);
  }

  @media (min-width: 620px) {
    .gl__masonry {
      columns: 2;
    }
  }

  @media (min-width: 1020px) {
    .gl__masonry {
      columns: 3;
    }
  }

  .gl__item {
    position: relative;
    display: block;
    width: 100%;
    margin: 0 0 clamp(0.6rem, 1.5vw, 1rem);
    padding: 0;
    overflow: hidden;
    /* No border: the photograph IS the object — a hairline drew a box on the
       picture. The scrim-caption and hover scale signal clickability. */
    border-radius: var(--r-xs);
    background-color: var(--photo-mat);
    cursor: zoom-in;
    /* Stops a column break splitting the frame in Chromium. */
    break-inside: avoid;
  }

  .gl__item img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform var(--t-slow) var(--ease);
  }

  .gl__item:hover img {
    transform: scale(1.03);
  }

  /* Caption sits on a dark scrim so it stays legible over any photograph,
     in either theme. */
  .gl__cap {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0.55rem 0.65rem;
    background: linear-gradient(
      180deg,
      rgba(11, 9, 8, 0) 0%,
      rgba(11, 9, 8, 0.85) 100%
    );
    color: #f7f3ec;
    font-size: 0.72rem;
    line-height: 1.35;
    text-align: left;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity var(--t-base) var(--ease),
      transform var(--t-base) var(--ease);
  }

  .gl__item:hover .gl__cap,
  .gl__item:focus-visible .gl__cap {
    opacity: 1;
    transform: none;
  }

  /* No hover on touch, so captions stay visible. */
  @media (hover: none) {
    .gl__cap {
      opacity: 1;
      transform: none;
    }
  }
</style>
