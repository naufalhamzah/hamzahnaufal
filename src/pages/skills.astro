---
/**
 * SKILLS — the complete tool and method showcase.
 *
 * The brief's requirements, and how each is met:
 *   · "logos large enough"         → SkillTile renders a 2.4rem mark
 *   · "grouped by area"            → one section per SkillGroup from the data
 *   · "only what is in the portfolio" → the list comes from src/data/skills.ts
 *   · "no percentage skill bars"   → no proficiency is shown anywhere, because
 *                                    neither source document states one
 *
 * Group ordering lives in the data file, so a new group needs no page change.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import SkillTile from '@/components/ui/SkillTile.astro';
import { skillGroups, totalSkills } from '@/data/skills';
import { profile } from '@/data/profile';

const meta = [
  { label: 'Categories', value: String(skillGroups.length) },
  { label: 'Entries', value: String(totalSkills) },
  { label: 'With a logo', value: String(skillGroups.flatMap((g) => g.items).filter((i) => i.icon).length) },
  { label: 'Note', value: 'No proficiency levels are shown' },
];
---

<BaseLayout
  title={`Skills — ${profile.name}`}
  description="Tools and methods Hamzah Naufal Zuhdi works with — data analytics and visualisation, programming and databases, machine learning, business process, design, and collaboration tooling."
>
  <PageHeader
    index="04"
    eyebrow="Skills"
    title="Tools and methods"
    standfirst="Grouped by area rather than ranked. Nothing here carries a proficiency percentage, because the source documents do not state one — this is a list of what has actually been worked with."
    meta={meta}
  />

  <!-- ===================== groups ===================== -->
  <section class="sk" aria-label="Skill groups">
    <div class="shell">
      {
        skillGroups.map((group, gi) => (
          <section class="sk__group" aria-labelledby={`sk-${group.id}`}>
            <header class="sk__head">
              <h2 id={`sk-${group.id}`} class="sk__title">
                <span class="sk__num mono" aria-hidden="true">
                  {String(gi + 1).padStart(2, '0')}
                </span>
                <span>{group.title}</span>
              </h2>
              {group.description && <p class="sk__desc">{group.description}</p>}
              <p class="sk__count mono">{group.items.length} entries</p>
            </header>

            <ul class="sk__grid">
              {group.items.map((item) => (
                <li>
                  <SkillTile name={item.name} icon={item.icon} />
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  <!-- ===================== note on the logo set ===================== -->
  <section class="sk-note">
    <div class="shell">
      <p class="sk-note__text">
        <span class="sk-note__tag mono">About the marks</span>
        Software and platform marks are the official logos, used where the brand
        publishes one for redistribution. The rest — methods and practices rather
        than products — carry a drawn category glyph, since no logo exists to use.
        Every entry now has a mark; none renders as a bare text tile.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .sk {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) var(--space-section);
  }

  .sk__group {
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: var(--hairline) solid var(--border);
  }

  .sk__group:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .sk__group + .sk__group {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  /*
    The group header is a two-line block: title and count on the first line,
    description beneath. The earlier version was a two-column grid, which put the
    count in the FIRST row's second cell — so it floated up beside the title while
    the description wrapped below, and the count ended up visually orphaned
    between them. An explicit two-row layout states the intent instead.
  */
  .sk__head {
    display: grid;
    gap: 0.4rem 1.5rem;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'title count'
      'desc  desc';
    align-items: baseline;
    margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .sk__title {
    grid-area: title;
  }

  .sk__desc {
    grid-area: desc;
  }

  .sk__count {
    grid-area: count;
    text-align: right;
  }

  .sk__title {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.018em;
    color: var(--fg-strong);
  }

  .sk__num {
    color: var(--accent);
    font-size: var(--text-2xs);
  }

  .sk__desc {
    max-width: 60ch;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .sk__count {
    color: var(--fg-faint);
  }

  .sk__grid {
    display: grid;
    gap: clamp(0.6rem, 1.4vw, 1rem);
    margin: 0;
    padding: 0;
    list-style: none;
    /* auto-fill keeps tiles a consistent size at any width, so adding a skill
       never breaks the layout */
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
  }

  /* ---------------- note ---------------- */
  .sk-note {
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: var(--hairline) solid var(--border);
  }

  .sk-note__text {
    max-width: 70ch;
    font-size: var(--text-sm);
    color: var(--fg-faint);
  }

  .sk-note__tag {
    display: inline-block;
    margin-inline-end: 0.6rem;
    color: var(--accent);
  }
</style>
