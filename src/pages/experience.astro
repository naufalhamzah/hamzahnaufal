---
/**
 * EXPERIENCE — the complete professional and organisational record.
 *
 * Two brief constraints: AirNav appears as EXPERIENCE, not the site's identity;
 * and its photographs are used but arranged as an editorial collage, not stacked
 * vertically.
 *
 * Each role renders as meta column → description → optional COLLAGE of its
 * unambiguous images. Only roles whose images are provably theirs have photos.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import ShotSlider from '@/components/ui/ShotSlider.astro';
import Collage from '@/components/ui/Collage.astro';
import { experienceSorted, currentExperience } from '@/data/experience';
import { organizationsSorted, organizationGroups } from '@/data/organizations';
import { profile } from '@/data/profile';
import { asset } from '@/utils/url';

const roles = experienceSorted;
const orgGroups = organizationGroups.map((g) => ({
  name: g,
  roles: organizationsSorted.filter((o) => o.group === g),
}));

/** Derived figures — never hardcoded, so they follow the data. */
const meta = [
  { label: 'Professional roles', value: String(roles.length) },
  { label: 'Currently', value: currentExperience.map((e) => e.company).join(', ') },
  { label: 'Organisational roles', value: String(organizationsSorted.length) },
  { label: 'Based in', value: profile.location },
];
---

<BaseLayout
  title={`Experience — ${profile.name}`}
  description="Professional experience of Hamzah Naufal Zuhdi — including Information Technology Administration Staff Intern at AirNav Indonesia, data and marketing work at Beauty Innovation Laboratories, and IT support at PT PLN (Persero)."
>
  <PageHeader
    index="03"
    eyebrow="Experience"
    title="Where I have worked"
    standfirst="Professional roles, then the student-body and committee record alongside them. Dates follow the LinkedIn profile export where the two source documents disagree."
    meta={meta}
  />

  <!-- ===================== professional ===================== -->
  <section class="xp" aria-labelledby="xp-pro">
    <div class="shell">
      <h2 id="xp-pro" class="label xp__h">Professional roles</h2>

      <ol class="xp__list">
        {
          roles.map((job, i) => (
            <li class:list={['xp__row', job.current && 'xp__row--current']}>
              <div class="xp__meta">
                <p class="xp__dates mono">{job.dateRange}</p>

                {job.logo ? (
                  <span class="xp__logo">
                    <img
                      /* Prefer the vector twin — curves, not stair-steps. */
                      src={asset(job.logo.srcVector ?? job.logo.src)}
                      alt={job.logo.alt}
                      width={job.logo.width ?? 200}
                      height={job.logo.height ?? 80}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                ) : (
                  <span class="xp__logo xp__logo--empty mono" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                )}

                {job.location && <p class="xp__loc mono">{job.location}</p>}
              </div>

              <div class="xp__body">
                <h3 class="xp__role">
                  {job.role}
                  {job.current && <span class="xp__badge mono">Current</span>}
                </h3>

                <p class="xp__company">
                  {job.company}
                  {job.companyFull && job.companyFull !== job.company && (
                    <span class="xp__full mono">{job.companyFull}</span>
                  )}
                </p>

                <p class="xp__summary">{job.summary}</p>

                {job.highlights.length > 0 && (
                  <ul class="xp__points">
                    {job.highlights.map((h) => <li>{h}</li>)}
                  </ul>
                )}

                {job.tools && job.tools.length > 0 && (
                  <ul class="xp__tools" aria-label="Tools">
                    {job.tools.map((t) => <li class="xp__tool mono">{t}</li>)}
                  </ul>
                )}

              </div>

              {/* ---- images: only where the role is unambiguous ---- */}
              {job.photos && job.photos.length > 0 && (
                <div class="xp__media">
                  <ShotSlider images={job.photos} />
                </div>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ===================== organisations ===================== -->
  <section class="xp-org" id="organizations" aria-labelledby="xp-orgs">
    <div class="shell">
      <div class="xp-org__head">
        <h2 id="xp-orgs" class="label">Organisations &amp; leadership</h2>
        <p class="mono xp-org__count">{organizationsSorted.length} roles</p>
      </div>

      <p class="xp-org__lede">
        Committee and student-body positions held alongside study. Grouped by the
        body they belong to, newest first.
      </p>

      {
        orgGroups.map(({ name, roles: groupRoles }) => (
          <div class="xp-org__group">
            <h3 class="xp-org__name mono">{name}</h3>

            <ol class="xp-org__list">
              {groupRoles.map((r) => (
                <li class:list={['xp-org__row', r.photos && r.photos.length > 0 && 'xp-org__row--media']}>
                  <p class="xp-org__when mono">{r.dateRange}</p>
                  <div class="xp-org__body">
                    <p class="xp-org__role">{r.role}</p>
                    {r.summary && <p class="xp-org__sum">{r.summary}</p>}
                    {r.tools && r.tools.length > 0 && (
                      <p class="xp-org__tools mono">{r.tools.join(' · ')}</p>
                    )}
                  </div>

                  {/* The role's photographs, where the data has them. Composed
                      from the count that exists, so a role with one photo and a
                      role with four both lay out without a rule per case. */}
                  {r.photos && r.photos.length > 0 && (
                    <div class="xp-org__media">
                      <Collage images={r.photos} dense />
                    </div>
                  )}
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .xp {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) var(--space-section);
  }

  .xp__h {
    padding-bottom: 1rem;
    border-bottom: var(--hairline) solid var(--border);
  }

  .xp__list {
    display: grid;
    margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
    padding: 0;
    list-style: none;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .xp__row {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    grid-template-columns: 1fr;
    padding-top: clamp(1.75rem, 3.5vw, 2.5rem);
    border-top: var(--hairline) solid var(--border-faint);
  }

  .xp__row:first-child {
    border-top: 0;
    padding-top: 0;
  }

  @media (min-width: 900px) {
    .xp__row {
      grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
      align-items: start;
    }

    /* Roles with images: .xp__media spans grid-column 2/-1 below, under the
       body text, rather than taking a separate third column. */
    .xp__row:has(.xp__media) {
      grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
    }
  }

  .xp__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .xp__dates {
    color: var(--fg-muted);
    text-transform: none;
    letter-spacing: 0.03em;
  }

  /*
    NO BORDERED PLATE — the brief objected to a "thick bordered box around a tiny
    company logo", so the mark sits directly on the page, sized by HEIGHT so that
    differently-shaped marks read at one optical weight: a square badge fills the
    height; a long wordmark is bound by the image's `max-width`.
  */
  .xp__logo {
    display: grid;
    place-items: center;
    width: 100%;
    /* NO `max-width` here, deliberately: capping the CONTAINER shrank the widest
       marks — a 5.88:1 JAIST wordmark measured 176×30px, smaller than the square
       badges it must match optically. The column width and the image's
       `max-height` are the real constraints. */
    min-height: 3.5rem;
  }

  /* `max-*` rather than `width/height: 100%`: a percentage height does not
     resolve inside a centred grid item, so a square logo would overflow into the
     text below. 4rem keeps the marks readable at a glance. */
  .xp__logo img {
    max-width: 100%;
    max-height: 4rem;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* Give the logos more width — 13rem was tight once the marks stopped being
     boxed; the extra room goes to the wordmarks that read too small. */
  @media (min-width: 900px) {
    .xp__row {
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    }
  }

  /* A role with no logo keeps the SAME box, so the meta column's rhythm is
     identical whether or not a mark exists. */
  .xp__logo--empty {
    color: var(--fg-faint);
    font-size: 1.35rem;
    font-family: var(--font-display);
    font-style: italic;
  }

  .xp__loc {
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .xp__role {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.018em;
    color: var(--fg-strong);
  }

  .xp__badge {
    padding: 0.18rem 0.5rem;
    border: var(--hairline) solid var(--accent-line);
    border-radius: var(--r-full);
    color: var(--accent);
    font-size: 0.6rem;
  }

  .xp__company {
    margin-top: 0.4rem;
    font-size: var(--text-base);
    color: var(--accent);
  }

  .xp__full {
    display: block;
    margin-top: 0.25rem;
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .xp__summary {
    margin-top: 1rem;
    max-width: 72ch;
    color: var(--fg-muted);
  }

  .xp__points {
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
    max-width: 72ch;
  }

  .xp__points li {
    position: relative;
    padding-inline-start: 1.35rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .xp__points li + li {
    margin-top: 0.55rem;
  }

  /* A small accent tick rather than a bullet. */
  .xp__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.6rem;
    height: 1px;
    background-color: var(--accent);
  }

  .xp__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .xp__tool {
    padding: 0.24rem 0.6rem;
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-full);
    color: var(--fg-subtle);
    text-transform: none;
    letter-spacing: 0.03em;
  }

  /* ---- media column ---- */
  .xp__media {
    /* Wide screens: the collage sits under the body text (grid-column 2/-1
       below) rather than beside it, keeping the description readable. */
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .xp__media {
      grid-column: 2 / -1;
      margin-top: 1.75rem;
      max-width: 56rem;
    }
  }

  .xp-org {
    padding-block: var(--space-section);
    border-top: var(--hairline) solid var(--border);
  }

  .xp-org__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-bottom: 1rem;
    border-bottom: var(--hairline) solid var(--border);
  }

  .xp-org__count {
    color: var(--fg-faint);
  }

  .xp-org__lede {
    margin-top: 1.25rem;
    max-width: 62ch;
    color: var(--fg-muted);
  }

  .xp-org__group {
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .xp-org__name {
    padding-bottom: 0.6rem;
    border-bottom: var(--hairline) solid var(--border-faint);
    color: var(--accent);
  }

  .xp-org__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xp-org__row {
    display: grid;
    gap: 0.25rem 1.5rem;
    grid-template-columns: 1fr;
    padding: 0.95rem 0;
    border-bottom: var(--hairline) solid var(--border-faint);
  }

  /*
    A role with photographs takes a third column, the collage BESIDE the role —
    the user's instruction ("kolasekan beberapa untuk ditaruh di samping
    pengalaman organisasi dan kepanitiaan"). A separate grid track, not a float,
    so the text keeps its measure. Roles without photos keep two columns.
  */
  @media (min-width: 760px) {
    .xp-org__row {
      grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
      align-items: baseline;
    }

    .xp-org__row--media {
      grid-template-columns: minmax(0, 13rem) minmax(0, 1fr) minmax(0, 18rem);
      align-items: start;
    }
  }

  .xp-org__media {
    margin-top: 0.4rem;
  }

  @media (min-width: 760px) {
    .xp-org__media {
      margin-top: 0;
    }
  }

  .xp-org__when {
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.03em;
  }

  .xp-org__role {
    font-size: var(--text-sm);
    color: var(--fg);
  }

  .xp-org__sum {
    margin-top: 0.3rem;
    max-width: 68ch;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .xp-org__tools {
    margin-top: 0.4rem;
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.02em;
  }
</style>
