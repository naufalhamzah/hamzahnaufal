---
/**
 * CERTIFICATIONS — a professional credential showcase.
 *
 * The brief rejects "image, image, image stacked vertically", so this renders as
 * a summary strip of derived counts, then labelled groups (courses &
 * credentials, programmes & committees, organisation roles) each an EDITORIAL
 * GRID of unequal cards, every card opening the shared lightbox.
 *
 * Counts come from the data, never hardcoded — a new certificate updates the
 * strip, the group count and the lightbox total automatically.
 *
 * Award piagam (Silver Medal, Finalist) live in Achievements, not duplicated here.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import {
  certificationsSorted,
  certificationTotal,
  credentialCount,
  certificationIssuers,
  CERTIFICATION_KIND_LABELS,
  CERTIFICATION_KIND_ORDER,
} from '@/data/certifications';
import { profile } from '@/data/profile';
import { asset, withBase } from '@/utils/url';

const byKind = CERTIFICATION_KIND_ORDER.map((kind) => ({
  kind,
  label: CERTIFICATION_KIND_LABELS[kind],
  items: certificationsSorted.filter((c) => c.kind === kind),
})).filter((g) => g.items.length > 0);

const meta = [
  { label: 'Certificates', value: String(certificationTotal) },
  { label: 'Course credentials', value: String(credentialCount) },
  { label: 'Issuers', value: String(certificationIssuers.length) },
];
---

<BaseLayout
  title={`Certifications — ${profile.name}`}
  description="Certifications and credentials of Hamzah Naufal Zuhdi — MySkill, Dicoding, Cisco Networking Academy and Oracle Academy, plus programme and organisation certificates."
>
  <PageHeader
    index="06"
    eyebrow="Certifications"
    title="Credentials and certificates"
    standfirst="Every certificate below is a real scan from the source material. Select any card to view it full size — the viewer supports arrow keys, zoom and browsing the whole set."
    meta={meta}
  />

  <!-- ===================== groups ===================== -->
  <section class="ce" aria-label="Certificates">
    <div class="shell">
      {
        byKind.map((group, gi) => (
          <section class="ce__group" aria-labelledby={`ce-${group.kind}`}>
            <header class="ce__head">
              <h2 id={`ce-${group.kind}`} class="ce__title">
                <span class="ce__num mono" aria-hidden="true">
                  {String(gi + 1).padStart(2, '0')}
                </span>
                <span>{group.label}</span>
              </h2>
              <p class="ce__count mono">{group.items.length}</p>
            </header>

            {/* One lightbox group per section, so arrow keys stay in a category
                instead of jumping across all 15. */}
            <ol class="ce__grid" data-lightbox-group>
              {group.items.map((c, i) => (
                <li class:list={['ce__cell', i === 0 && 'ce__cell--lead']}>
                  <button
                    type="button"
                    class="ce__card"
                    data-lightbox-src={asset(c.visual.src)}
                    data-lightbox-alt={c.visual.alt}
                    data-lightbox-title={`${c.issuer} — ${c.title}`}
                    data-lightbox-caption={[c.date, c.credentialId]
                      .filter(Boolean)
                      .join(' · ')}
                    aria-label={`View certificate: ${c.title} from ${c.issuer}`}
                  >
                    <span class="ce__frame">
                      <img
                        src={asset(c.visual.src)}
                        alt={c.visual.alt}
                        width={c.visual.width}
                        height={c.visual.height}
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="ce__zoom" aria-hidden="true">⤢</span>
                    </span>

                    <span class="ce__body">
                      <span class="ce__issuer mono">
                        {c.issuerLogo && (
                          <img
                            class="ce__issuer-logo"
                            src={asset(c.issuerLogo.src)}
                            alt=""
                            width={c.issuerLogo.width ?? 40}
                            height={c.issuerLogo.height ?? 40}
                            loading="lazy"
                            decoding="async"
                          />
                        )}
                        {c.issuer}
                      </span>

                      <span class="ce__name">{c.title}</span>

                      {c.path && <span class="ce__path">{c.path}</span>}

                      <span class="ce__foot mono">
                        {c.date && <span>{c.date}</span>}
                        {c.credentialId && (
                          <span class="ce__id" title={c.credentialId}>
                            {c.credentialId}
                          </span>
                        )}
                      </span>
                    </span>
                  </button>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </section>

  <!-- ===================== onward: achievements ===================== -->
  <section class="ce-go">
    <div class="shell">
      <a href={withBase('/achievements')} class="ce-go__link">
        <span class="ce-go__label mono">Also</span>
        <span class="ce-go__title">Awards and recognition</span>
        <span class="ce-go__note mono">Medal · competition finalist · programme funding</span>
        <span class="ce-go__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ==========================================================================
     certificate groups
     ========================================================================== */
  .ce {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) var(--space-section);
  }

  .ce__group + .ce__group {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: var(--hairline) solid var(--border);
  }

  .ce__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .ce__title {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.018em;
    color: var(--fg-strong);
  }

  .ce__num {
    color: var(--accent);
    font-size: var(--text-2xs);
  }

  .ce__count {
    color: var(--fg-faint);
  }

  /* ---- grid: unequal columns, so the group reads as a composed spread ---- */
  .ce__grid {
    display: grid;
    gap: clamp(0.75rem, 1.8vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .ce__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .ce__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* The first card in a group takes a wider column — an asymmetric start
       that stops the grid reading as a plain table of thumbnails. */
    .ce__cell--lead {
      grid-column: span 2;
    }

    .ce__grid:has(.ce__cell--lead) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .ce__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-xs);
    background-color: var(--surface);
    text-align: left;
    cursor: zoom-in;
    transition:
      border-color var(--t-base) var(--ease),
      background-color var(--t-base) var(--ease),
      transform var(--t-base) var(--ease);
  }

  .ce__card:hover {
    border-color: var(--accent);
    background-color: var(--surface-2);
    transform: translateY(-2px);
  }

  /* ---- the scan itself ---- */
  /*
    CONTAIN, NOT COVER — a certificate is a DOCUMENT, not a photograph.

    These scans run 1.29–1.78 in aspect ratio; a fixed 3:2 frame with
    `object-fit: cover` cropped every one — the wide MySkill certificates lost
    their top and bottom edges, the squarer Oracle and Hima ones lost their sides,
    on several cutting off the printed name and signature block. The scan is
    therefore FITTED inside the frame, and the matte (--photo-mat) makes the
    letterboxing read as a deliberate plate and gives scans of differing
    backgrounds (navy, white, cream, green) a consistent weight.

    A slight inset keeps the scan's own border off the frame edge.
  */
  .ce__frame {
    position: relative;
    display: block;
    overflow: hidden;
    background-color: var(--photo-mat);
    aspect-ratio: 16 / 11;
  }

  .ce__frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    padding: 0.7rem;
    transition: transform var(--t-slow) var(--ease);
  }

  .ce__card:hover .ce__frame img {
    transform: scale(1.03);
  }

  .ce__zoom {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: var(--r-xs);
    background-color: rgba(11, 9, 8, 0.72);
    color: #f7f3ec;
    font-size: 0.8rem;
    opacity: 0;
    transition: opacity var(--t-base) var(--ease);
  }

  .ce__card:hover .ce__zoom,
  .ce__card:focus-visible .ce__zoom {
    opacity: 1;
  }

  /* ---- text ---- */
  .ce__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
    padding: 0.9rem 1rem 1.05rem;
  }

  .ce__issuer {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent);
  }

  .ce__issuer-logo {
    width: 1.1rem;
    height: 1.1rem;
    object-fit: contain;
  }

  .ce__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.2;
    color: var(--fg-strong);
  }

  .ce__path {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
  }

  .ce__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.7rem;
    margin-top: auto;
    padding-top: 0.7rem;
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  /* Credential IDs are long; ellipsis keeps the card tidy, the title attribute
     preserves the full value. */
  .ce__id {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 18ch;
  }

  /* ---------------- onward link ---------------- */
  .ce-go {
    padding-block: var(--space-band) var(--space-section);
    border-top: var(--hairline) solid var(--border);
  }

  .ce-go__link {
    display: grid;
    gap: 0.2rem 1rem;
    grid-template-columns: 1fr auto;
    align-items: center;
    padding: clamp(1.1rem, 2.5vw, 1.5rem) clamp(1.15rem, 2.5vw, 1.5rem);
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-xs);
    transition:
      border-color var(--t-base) var(--ease),
      background-color var(--t-base) var(--ease);
  }

  .ce-go__link:hover {
    border-color: var(--accent);
    background-color: var(--accent-soft);
  }

  .ce-go__label {
    grid-column: 1 / -1;
    color: var(--fg-faint);
  }

  .ce-go__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--fg-strong);
  }

  .ce-go__note {
    grid-column: 1;
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .ce-go__arrow {
    grid-row: 2 / span 2;
    grid-column: 2;
    color: var(--accent);
    font-size: 1.15rem;
    transition: transform var(--t-base) var(--ease);
  }

  .ce-go__link:hover .ce-go__arrow {
    transform: translateX(4px);
  }
</style>
