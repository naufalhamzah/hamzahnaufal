---
/**
 * 404 — keeps the site's voice instead of a default browser error.
 * Offers the most likely destinations rather than a single "go home" button.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { navPages } from '@/utils/navigation';
import { profile } from '@/data/profile';
import { withBase } from '@/utils/url';
---

<BaseLayout
  title={`Page not found — ${profile.name}`}
  description="The page you were looking for does not exist."
>
  <section class="nf">
    <div class="shell">
      <p class="label nf__eyebrow">Error 404</p>

      <h1 class="nf__title">Page not found</h1>

      <p class="nf__lede">
        That address does not exist on this site. The links below cover everything
        available here.
      </p>

      <ul class="nf__list">
        <li>
          <a href={withBase('/')} class="nf__link">
            <span class="mono nf__num" aria-hidden="true">00</span>
            <span class="nf__label">Home</span>
            <span class="nf__note mono">Professional overview</span>
          </a>
        </li>
        {
          navPages.map((page, i) => (
            <li>
              <a href={page.href} class="nf__link">
                <span class="mono nf__num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="nf__label">{page.label}</span>
                {page.blurb && <span class="nf__note mono">{page.blurb}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .nf__eyebrow {
    margin-bottom: 1.25rem;
  }

  .nf__title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    color: var(--fg-strong);
  }

  .nf__lede {
    margin-top: 1.1rem;
    max-width: 52ch;
    font-size: var(--text-lg);
    color: var(--fg-muted);
  }

  .nf__list {
    display: grid;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
    border-top: var(--hairline) solid var(--border);
  }

  .nf__link {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.15rem 1rem;
    align-items: baseline;
    padding: 0.85rem 0;
    border-bottom: var(--hairline) solid var(--border-faint);
    transition: color var(--t-fast) var(--ease);
  }

  @media (min-width: 700px) {
    .nf__link {
      grid-template-columns: 2.5rem minmax(0, 12rem) 1fr;
    }
  }

  .nf__num {
    color: var(--fg-faint);
  }

  .nf__label {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--fg);
    transition: color var(--t-fast) var(--ease);
  }

  .nf__note {
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .nf__link:hover .nf__label,
  .nf__link:focus-visible .nf__label {
    color: var(--accent);
  }
</style>
