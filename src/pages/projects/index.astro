---
/**
 * PROJECTS — the complete project portfolio.
 *
 * Structure: a category filter over the full list (the site's ONE interactive
 * part, hence its only client-side island), and every project as an EDITORIAL
 * ROW — image one side, text the other, sides alternating down the page.
 *
 * The rows replaced a single-column card grid, where at full width every image
 * was 1152px wide and the page read as a stack of billboards. See
 * `ProjectRow.astro` for why the beside-it text column is the fix.
 *
 * No subjective ranking labels ("best", "top") — grouping is by CATEGORY, a fact
 * about the work, not a judgement of it.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import ProjectRow from '@/components/ui/ProjectRow.astro';
import ProjectFilter from '@/components/islands/ProjectFilter';
import {
  projectEntries,
  featuredProjects,
  projectsInterleaved,
} from '@/data/projects';
import { profile } from '@/data/profile';
import { PROJECT_CATEGORY_LABELS, PROJECT_CATEGORY_ORDER } from '@/types/content';


/**
 * The master grid order.
 *
 * `projectsInterleaved` rather than `projectsSorted`: plain recency ran two
 * data/systems projects back to back while the UI/UX case studies sat at the
 * bottom; the interleaved order alternates primary category so the opening row
 * shows the range of the work.
 *
 * `index` resolves against `projectEntries`, so each card's number is stable
 * regardless of grid order and never renumbers on filtering.
 */
const numbered = projectsInterleaved.map((p) => ({
  project: p,
  index: projectEntries.findIndex((e) => e.id === p.id) + 1,
}));

const others = numbered.filter((n) => !n.project.featured);
const featuredCount = featuredProjects.length;

/**
 * `others` is not rendered — the grid shows every project and the filter island
 * hides them. Kept as documentation of the featured/other split a future
 * "featured only" view would need.
 */
void others;

/**
 * Categories actually present in the data, in the canonical order. Derived, so
 * adding a project in a new category extends the filter automatically.
 */
const activeCategories = PROJECT_CATEGORY_ORDER.filter((c) =>
  projectEntries.some((p) => p.categories.includes(c)),
);

const meta = [
  { label: 'Projects', value: String(projectEntries.length) },
  { label: 'Categories', value: String(activeCategories.length) },
  { label: 'Selected', value: String(featuredCount) },
  { label: 'Disciplines', value: activeCategories.map((c) => PROJECT_CATEGORY_LABELS[c]).join(' · ') },
];
---

<BaseLayout
  title={`Projects — ${profile.name}`}
  description="Projects by Hamzah Naufal Zuhdi — an internal marketing data management system, a procurement monitoring dashboard, smart-farming research, and machine-learning publications."
>
  <PageHeader
    index="02"
    eyebrow="Projects"
    title="Selected work"
    standfirst="Systems and dashboards built end to end, plus published research applying machine learning to real evaluation problems. Every outcome below is one the source material actually documents."
    meta={meta}
  />

  <!-- ===================== filter + grid (the only island) ===================== -->
  <section class="pj" aria-labelledby="pj-all">
    <div class="shell">
      <div class="pj__head">
        <h2 id="pj-all" class="label">All projects</h2>
        <p class="mono pj__hint">
          Filter by discipline — counts update with the list
        </p>
      </div>

      <ProjectFilter
        client:load
        categories={activeCategories.map((c) => ({
          id: c,
          label: PROJECT_CATEGORY_LABELS[c],
          count: projectEntries.filter((p) => p.categories.includes(c)).length,
        }))}
        total={projectEntries.length}
      />

      <!-- Cards are server-rendered and always in the HTML; the island only
           toggles a data attribute to hide/show them, so the content stays
           crawlable and the page works without JavaScript. -->
      <div class="pj__grid" id="projects-grid">
        {
          numbered.map((n, i) => (
            <div
              class="pj__cell"
              data-categories={n.project.categories.join(' ')}
              data-index={i}
            >
              {/* Sides alternate so the page zig-zags instead of running down
                  one edge — the rhythm that makes a long list readable. */}
              <ProjectRow
                project={n.project}
                index={n.index}
                side={i % 2 === 1 ? 'right' : 'left'}
              />
            </div>
          ))
        }
      </div>

      <p class="pj__empty" id="projects-grid-empty" hidden>
        No projects in that category yet.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .pj__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-bottom: 1rem;
    border-bottom: var(--hairline) solid var(--border);
  }

  .pj__hint {
    color: var(--fg-faint);
  }

  /*
    ONE COLUMN, full width.

    The old two-column grid (first cell spanning both) gave cards different
    available widths, so the same 16:10 frame rendered at 1152px on one row and
    550px on the next and rows could hold cards of different heights — the
    unevenness the user reported. A single full-width column gives every card the
    same width and frame ratio, so the page reads as a sequence of case studies.
  */
  .pj__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
    grid-template-columns: 1fr;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  /* A hairline between rows — a gap alone is not enough separation at this width. */
  .pj__cell + .pj__cell {
    padding-top: clamp(3rem, 6vw, 5rem);
    border-top: var(--hairline) solid var(--border-faint);
  }
  .pj {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) var(--space-section);
  }

  /* Hidden by the filter island. */
  .pj__cell[hidden] {
    display: none;
  }

  .pj__empty {
    margin-top: 2rem;
    padding: 1.25rem;
    border: var(--hairline) dashed var(--border-strong);
    border-radius: var(--r-xs);
    color: var(--fg-muted);
    text-align: center;
  }
</style>
