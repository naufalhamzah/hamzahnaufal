---
/**
 * PROJECT DETAIL — the full case study.
 *
 * Deliberately more complete than anything on the homepage. Structure follows
 * the brief:
 *
 *   header → overview → context → approach → tools → gallery → outcomes →
 *   links → related projects
 *
 * WHAT IS NEVER INVENTED
 *   · no client names beyond what the documents state
 *   · no revenue, user counts, percentages or KPIs
 *   · `outcomes` comes straight from the data file and is only rendered when
 *     non-empty; a project with no documented outcome simply has no such
 *     section rather than a padded one
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Collage from '@/components/ui/Collage.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import { getProject, projectEntries, relatedProjects } from '@/data/projects';
import { getImageDims } from '@/data/image-dims';
import { PROJECT_CATEGORY_LABELS } from '@/types/content';

export function getStaticPaths() {
  return projectEntries.map((p) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const project = getProject(id ?? '');

if (!project) {
  return Astro.redirect('/404');
}

/** Hero visual dimensions, so the frame reserves correct space. */
const heroDims =
  getImageDims(project.visual.src) ??
  (project.visual.width && project.visual.height
    ? ([project.visual.width, project.visual.height] as [number, number])
    : null);

const heroStyle = `--ar: ${heroDims ? (heroDims[1] / heroDims[0]).toFixed(4) : 0.6667}`;

const related = relatedProjects(project.id, 2);
const relatedNumbered = related.map((r) => ({
  project: r,
  index: projectEntries.findIndex((e) => e.id === r.id) + 1,
}));

/**
 * Gallery images for this project.
 *
 * The hero visual is REMOVED here. Every project's gallery previously opened by
 * repeating the same file that is already displayed as the hero above it, so the
 * first tile in "Screens & gallery" was always an exact duplicate of the image
 * the visitor had just scrolled past — which is what made the screens look
 * repetitive and unconsidered rather than curated.
 *
 * The hero is the hero; the gallery is what else exists.
 */
const gallery = (project.gallery ?? []).filter(
  (img) => img.src !== project.visual.src,
);

const meta = [
  { label: 'Role', value: project.role },
  ...(project.dateRange ? [{ label: 'Period', value: project.dateRange }] : []),
  ...(project.organisation ? [{ label: 'Organisation', value: project.organisation }] : []),
  {
    label: 'Discipline',
    value: project.categories.map((c) => PROJECT_CATEGORY_LABELS[c]).join(' · '),
  },
];

const links = [
  ...(project.link ? [project.link] : []),
  ...(project.links ?? []),
];
---

<BaseLayout
  title={`${project.title} — ${project.role}`}
  description={project.tagline}
  ogImage={project.visual.src}
>
  <!-- ===================== header ===================== -->
  <header class="pd-head">
    <div class="shell">
      <nav class="pd-crumbs" aria-label="Breadcrumb">
        <a href="/" class="pd-crumb">Home</a>
        <span class="pd-crumb-sep" aria-hidden="true">/</span>
        <a href="/projects" class="pd-crumb">Projects</a>
        <span class="pd-crumb-sep" aria-hidden="true">/</span>
        <span class="pd-crumb pd-crumb--current" aria-current="page">{project.title}</span>
      </nav>

      <p class="pd-cat mono">
        {
          project.categories.map((c) => (
            <span class="pd-cat-item">{PROJECT_CATEGORY_LABELS[c]}</span>
          ))
        }
        {project.year && <span class="pd-cat-year">{project.year}</span>}
      </p>

      <h1 class="pd-title">{project.title}</h1>
      {project.subtitle && <p class="pd-sub">{project.subtitle}</p>}
      <p class="pd-tag">{project.tagline}</p>

      <dl class="pd-meta">
        {
          meta.map((m) => (
            <div class="pd-meta-row">
              <dt class="mono">{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </header>

  <!-- ===================== hero visual ===================== -->
  <section class="pd-hero" aria-label="Project visual">
    <div class="shell">
      <figure class="pd-figure" style={heroStyle}>
        <img
          src={project.visual.src}
          alt={project.visual.alt}
          width={heroDims?.[0] ?? project.visual.width}
          height={heroDims?.[1] ?? project.visual.height}
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- ===================== body ===================== -->
  <section class="pd-body" aria-label="Case study">
    <div class="shell pd-body__shell">
      <div class="pd-body__main">
        {
          project.context && (
            <div class="pd-block">
              <h2 class="pd-h label">Context</h2>
              <p class="pd-text pd-text--lead">{project.context}</p>
            </div>
          )
        }

        {
          project.approach && project.approach.length > 0 && (
            <div class="pd-block">
              <h2 class="pd-h label">What I did</h2>
              <ul class="pd-points">
                {project.approach.map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
            </div>
          )
        }

        {
          /* Only rendered when the documents actually state an outcome. */
          project.outcomes.length > 0 && (
            <div class="pd-block">
              <h2 class="pd-h label">Documented outcomes</h2>
              <ul class="pd-outcomes">
                {project.outcomes.map((o) => (
                  <li>{o}</li>
                ))}
              </ul>
            </div>
          )
        }

        {
          project.outcomes.length === 0 && (
            <div class="pd-block">
              <h2 class="pd-h label">Documented outcomes</h2>
              <p class="pd-none">
                No outcome figures are documented for this project, so none are
                shown. What the work consisted of is above.
              </p>
            </div>
          )
        }

        {
          project.todo && (
            <div class="pd-block">
              <p class="pd-todo mono">
                <span class="pd-todo-tag">Note</span>
                {project.todo}
              </p>
            </div>
          )
        }
      </div>

      <!-- ---- side rail ---- -->
      <aside class="pd-side" aria-label="Project details">
        <div class="pd-side-block">
          <h2 class="label pd-side-h">Tools</h2>
          <ul class="pd-tools">
            {project.tools.map((t) => <li class="pd-tool mono">{t}</li>)}
          </ul>
        </div>

        {
          (links.length > 0 || project.linkPending) && (
            <div class="pd-side-block">
              <h2 class="label pd-side-h">Links</h2>
              <ul class="pd-links">
                {links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class="pd-link"
                      rel={l.external ? 'noopener noreferrer' : undefined}
                      target={l.external ? '_blank' : undefined}
                    >
                      <span>{l.label}</span>
                      <span aria-hidden="true">{l.external ? '↗' : '→'}</span>
                    </a>
                  </li>
                ))}

                {/*
                  A link that is worth having but has no URL yet.

                  Styled as a BUTTON — the same shape and position a real link
                  will occupy — but rendered as a non-interactive element rather
                  than an anchor. `href="#"` would look live and go nowhere, which
                  reads as a broken site; this reads as a button that is waiting
                  for its address. The user asked for the button to exist now and
                  the URL to follow, so the slot is fully laid out and filling in
                  `link.href` is the only change needed to activate it.
                */}
                {project.linkPending && (
                  <li>
                    <span class="pd-link pd-link--pending" aria-disabled="true">
                      <span>{project.linkPending}</span>
                      <span class="pd-link-tag mono">Soon</span>
                    </span>
                  </li>
                )}
              </ul>
            </div>
          )
        }

        <div class="pd-side-block">
          <h2 class="label pd-side-h">Back</h2>
          <a href="/projects" class="pd-back">
            <span class="pd-back-arrow" aria-hidden="true">←</span>
            <span>All projects</span>
          </a>
        </div>
      </aside>
    </div>
  </section>

  <!-- ===================== gallery (full width) =====================
       Deliberately OUTSIDE the two-column body shell.

       It used to live inside the 1.6fr text column, which left the gallery about
       620px wide and shrank its smaller cells to 231x145 — unreadable for a
       dashboard, whose whole purpose is its figures. A gallery is display
       material, not prose: it belongs at the full measure of the page, where the
       images can be looked at rather than merely counted.
       ---------------------------------------------------------------- -->
  {
    gallery.length > 0 && (
      <section class="pd-gal" aria-labelledby="pd-gallery">
        <div class="shell">
          <div class="pd-gal__head">
            <h2 id="pd-gallery" class="label">Screens &amp; gallery</h2>
            <p class="pd-gal__count mono">
              {gallery.length} {gallery.length === 1 ? 'image' : 'images'}
            </p>
          </div>
          <Collage images={gallery} mockup />
        </div>
      </section>
    )
  }


  <!-- ===================== related ===================== -->
  {
    relatedNumbered.length > 0 && (
      <section class="pd-related" aria-labelledby="pd-rel">
        <div class="shell">
          <h2 id="pd-rel" class="label pd-related-h">Related projects</h2>
          <div class="pd-related-grid">
            {relatedNumbered.map((r) => (
              <ProjectCard project={r.project} index={r.index} variant="wide" />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* ==========================================================================
     gallery (full width)
     ========================================================================== */
  .pd-gal {
    padding-block: var(--space-section);
    border-top: var(--hairline) solid var(--border);
  }

  .pd-gal__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
    padding-bottom: 1rem;
    border-bottom: var(--hairline) solid var(--border-faint);
  }

  .pd-gal__count {
    color: var(--fg-faint);
  }

  /* ==========================================================================
     header
     ========================================================================== */
  .pd-head {
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  .pd-crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pd-crumb {
    color: var(--fg-faint);
    transition: color var(--t-fast) var(--ease);
  }

  .pd-crumb:hover {
    color: var(--accent);
  }

  .pd-crumb--current {
    color: var(--fg-muted);
    /* Long titles must not push the breadcrumb off-screen. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 20ch;
  }

  .pd-crumb-sep {
    color: var(--border-strong);
  }

  .pd-cat {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
  }

  .pd-cat-item::after {
    content: '·';
    margin-inline-start: 0.5rem;
    color: var(--fg-faint);
  }

  .pd-cat-item:last-of-type::after {
    content: none;
  }

  .pd-cat-year {
    padding-inline-start: 0.5rem;
    border-inline-start: var(--hairline) solid var(--border);
    color: var(--fg-faint);
  }

  .pd-title {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.024em;
    color: var(--fg-strong);
    max-width: 24ch;
  }

  .pd-sub {
    margin-top: 0.7rem;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--accent);
  }

  .pd-tag {
    margin-top: 1.15rem;
    max-width: 62ch;
    font-size: var(--text-lg);
    color: var(--fg-muted);
  }

  .pd-meta {
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    border-top: var(--hairline) solid var(--border);
  }

  @media (min-width: 700px) {
    .pd-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }
  }

  @media (min-width: 1100px) {
    .pd-meta {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .pd-meta-row {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.85rem 0;
    border-bottom: var(--hairline) solid var(--border-faint);
  }

  .pd-meta dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--fg);
  }

  /* ==========================================================================
     hero visual
     ========================================================================== */
  .pd-hero {
    padding-block: clamp(2rem, 4vw, 3.5rem);
  }

  .pd-figure {
    margin: 0;
    overflow: hidden;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-xs);
    background-color: var(--surface-2);
    aspect-ratio: 1 / var(--ar, 0.6667);
    /*
      Very tall sources (a portrait journal cover, 2:3) would otherwise become a
      huge block. Capping the height and switching to `contain` shows the whole
      document inside the frame instead of cropping the title off the top — the
      right trade for a written artefact, and harmless for a screenshot.
    */
    max-height: 72vh;
  }

  .pd-figure img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* ==========================================================================
     body
     ========================================================================== */
  .pd-body {
    padding-bottom: var(--space-section);
  }

  .pd-body__shell {
    display: grid;
    gap: clamp(2rem, 4.5vw, 4rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .pd-body__shell {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .pd-block + .pd-block {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: var(--hairline) solid var(--border-faint);
  }

  .pd-h {
    display: block;
    margin-bottom: 1.1rem;
  }

  .pd-text {
    color: var(--fg-muted);
  }

  .pd-text--lead {
    max-width: 70ch;
    font-size: var(--text-lg);
    color: var(--fg);
  }

  .pd-points {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 72ch;
  }

  .pd-points li {
    position: relative;
    padding-inline-start: 1.5rem;
    color: var(--fg-muted);
  }

  /* A small accent tick instead of a bullet — matches the Experience page. */
  .pd-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 0.7rem;
    height: 1px;
    background-color: var(--accent);
  }

  .pd-outcomes {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 72ch;
  }

  .pd-outcomes li {
    padding: 0.7rem 0.85rem;
    border-inline-start: 2px solid var(--accent-line);
    background-color: var(--accent-soft);
    color: var(--fg);
    font-size: var(--text-sm);
  }

  .pd-none {
    max-width: 60ch;
    font-size: var(--text-sm);
    color: var(--fg-faint);
    font-style: italic;
  }

  .pd-todo {
    max-width: 72ch;
    padding: 0.7rem 0.85rem;
    border-inline-start: 2px solid var(--accent-line);
    background-color: var(--accent-soft);
    color: var(--fg-subtle);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .pd-todo-tag {
    display: inline-block;
    margin-inline-end: 0.5rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.6rem;
  }

  /* ==========================================================================
     side rail
     ========================================================================== */
  .pd-side {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2rem);
    padding-top: 0.25rem;
  }

  .pd-side-h {
    display: block;
    margin-bottom: 0.9rem;
    color: var(--accent);
  }

  .pd-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pd-tool {
    padding: 0.28rem 0.65rem;
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-full);
    color: var(--fg-subtle);
    text-transform: none;
    letter-spacing: 0.03em;
  }

  .pd-links {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
    A pending link: a FULL-SIZE button, in the position a real one occupies, but
    visually held back — a dashed edge and muted ink — so it is obviously not
    clickable yet. It keeps the button's weight so the rail looks complete and
    does not reflow when the URL arrives.
  */
  .pd-link--pending {
    border-style: dashed;
    border-color: var(--border-strong);
    color: var(--fg-subtle);
    cursor: default;
  }

  .pd-link--pending:hover {
    border-color: var(--border-strong);
    background-color: transparent;
    color: var(--fg-subtle);
  }

  .pd-link-tag {
    color: var(--accent);
  }

  .pd-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-xs);
    color: var(--fg);
    font-size: var(--text-sm);
    transition:
      border-color var(--t-base) var(--ease),
      background-color var(--t-base) var(--ease),
      color var(--t-base) var(--ease);
  }

  .pd-link:hover {
    border-color: var(--accent);
    background-color: var(--accent-soft);
    color: var(--accent);
  }

  .pd-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
    transition: color var(--t-fast) var(--ease);
  }

  .pd-back:hover {
    color: var(--accent);
  }

  .pd-back-arrow {
    transition: transform var(--t-base) var(--ease);
  }

  .pd-back:hover .pd-back-arrow {
    transform: translateX(-4px);
  }

  /* ==========================================================================
     related
     ========================================================================== */
  .pd-related {
    padding-block: var(--space-section);
    border-top: var(--hairline) solid var(--border);
    background-color: var(--band);
  }

  .pd-related-h {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .pd-related-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 800px) {
    .pd-related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
