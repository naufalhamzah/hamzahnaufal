---
/**
 * HOME — a curated professional introduction.
 *
 * NOT a content dump. Five previews, each earning its place, each handing off
 * to a real page. The rule for this file: nothing appears here that is not one
 * of the strongest things the site has.
 *
 *   HERO              identity + the single strongest photograph
 *   ABOUT             one paragraph + focus areas        → /about
 *   SELECTED WORK     3 featured projects, 2 sizes       → /projects
 *   EXPERIENCE        4 roles, typographic only          → /experience
 *   SKILLS            12 curated tool marks              → /skills
 *   CONTACT           the closing call to action         → /contact
 *
 * WHAT IS DELIBERATELY ABSENT
 *   · no gallery preview — the photographs are better served complete on
 *     /gallery than as a teaser that only adds length here
 *   · no certificate wall, no publication list, no achievement grid — each has
 *     its own page and each was previously making this page feel like a CV
 *
 * IMAGE BUDGET: 1 portrait + 1 about photo + 3 project visuals + skill marks.
 * That is the whole homepage.
 *
 * This file owns no content — it only composes sections.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import AboutPreview from '@/components/sections/AboutPreview.astro';
import FeaturedWork from '@/components/sections/FeaturedWork.astro';
import ExperiencePreview from '@/components/sections/ExperiencePreview.astro';
import SkillsPreview from '@/components/sections/SkillsPreview.astro';
import ContactPreview from '@/components/sections/ContactPreview.astro';
import { profile } from '@/data/profile';
---

<BaseLayout
  title={`${profile.name} — ${profile.headline}`}
  description="Portfolio of Hamzah Naufal Zuhdi — Information Systems graduate working across data analytics, information systems, business process improvement and digital solutions."
  isHome
>
  <Hero />
  <AboutPreview />
  <FeaturedWork />
  <ExperiencePreview />
  <SkillsPreview />
  <ContactPreview />
</BaseLayout>
