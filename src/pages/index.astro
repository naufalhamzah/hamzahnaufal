---
/**
 * HOME — a professional OVERVIEW.
 *
 * This page is deliberately short. It carries the strongest visual material and
 * hands off to real pages for the detail:
 *
 *   HERO            identity + the single strongest photograph
 *   ABOUT           one paragraph + focus areas        → /about
 *   SELECTED WORK   three featured projects            → /projects
 *   EXPERIENCE      a compact timeline, no images      → /experience
 *   SKILLS          readable tool logos                → /skills
 *   CREDENTIALS     certs + papers + awards            → /certifications
 *   MOMENTS         a composed collage                 → /gallery
 *   CONTACT         the closing call to action
 *
 * IMAGE BUDGET (enforced by what this file imports): 1 portrait, 1 about photo,
 * 3 project visuals, ~14 skill marks, 2 certificate scans, 6 gallery photos.
 * Everything else lives on its own page.
 *
 * This file owns NO content — it only composes sections.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import AboutPreview from '@/components/sections/AboutPreview.astro';
import FeaturedWork from '@/components/sections/FeaturedWork.astro';
import ExperiencePreview from '@/components/sections/ExperiencePreview.astro';
import SkillsPreview from '@/components/sections/SkillsPreview.astro';
import CredentialsPreview from '@/components/sections/CredentialsPreview.astro';
import GalleryPreview from '@/components/sections/GalleryPreview.astro';
import ContactPreview from '@/components/sections/ContactPreview.astro';
import { profile } from '@/data/profile';
---

<BaseLayout
  title={`${profile.name} — ${profile.headline}`}
  description="Portfolio of Hamzah Naufal Zuhdi — Information Systems graduate working across data analytics, information systems, business process improvement and digital solutions."
  isHome
>
  <Hero />
  <AboutPreview />
  <FeaturedWork />
  <ExperiencePreview />
  <SkillsPreview />
  <CredentialsPreview />
  <GalleryPreview />
  <ContactPreview />
</BaseLayout>
