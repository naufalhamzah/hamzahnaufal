---
/**
 * HOME PAGE
 *
 * Composition only: this file assembles the section components and owns no
 * content. Every fact the page renders comes from `src/content/*`.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import About from '@/components/sections/About.astro';
import FeaturedWork from '@/components/sections/FeaturedWork.astro';
import Experience from '@/components/sections/Experience.astro';
import Leadership from '@/components/sections/Leadership.astro';
import Projects from '@/components/sections/Projects.astro';
import Publications from '@/components/sections/Publications.astro';
import Skills from '@/components/sections/Skills.astro';
import Certifications from '@/components/sections/Certifications.astro';
import Achievements from '@/components/sections/Achievements.astro';
import Education from '@/components/sections/Education.astro';
import Contact from '@/components/sections/Contact.astro';
import { profile } from '@/content/profile';
---

<BaseLayout
  title={`${profile.name} — ${profile.headline}`}
  description="Portfolio of Hamzah Naufal Zuhdi — Information Systems graduate working across data analytics, information systems, business process improvement and digital solutions."
  isHome
>
  <!-- Anchor target for the header brand link -->
  <span id="top" aria-hidden="true"></span>

  <Hero />
  <About />
  <FeaturedWork />
  <Experience />
  <Leadership />
  <Projects />
  <Publications />
  <Skills />
  <Certifications />
  <Achievements />
  <Education />
  <Contact />
</BaseLayout>
