---
/**
 * BASE LAYOUT — the HTML shell used by every page.
 *
 * Owns: <head> metadata, the pre-paint theme bootstrap, the skip link, the
 * navbar, the footer, the shared lightbox, and two small progressive
 * enhancements (scroll reveal and the page-in transition).
 */
import '@/styles/global.css';

// Self-hosted fonts — no external requests, no layout shift, works offline.
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/playfair-display';

import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import Lightbox from '@/components/ui/Lightbox.astro';
import { site } from '@/utils/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  isHome?: boolean;
}

const { title, description, ogImage = site.defaultOgImage, isHome = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const socialImage = new URL(ogImage, Astro.site ?? site.url).href;

/**
 * JSON-LD Person markup, built ONLY from facts present in the source documents.
 *
 * `jobTitle` is deliberately the graduate positioning rather than the current
 * employer, matching the site's own identity rule. The internship is discoverable
 * through the Experience page instead.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Hamzah Naufal Zuhdi',
  jobTitle: 'Information Systems Graduate',
  description:
    'Information Systems graduate working across data analytics, information systems, business process improvement and digital solutions.',
  image: new URL('/images/hero/portrait.webp', Astro.site ?? site.url).href,
  alumniOf: [{ '@type': 'CollegeOrUniversity', name: 'Universitas Negeri Semarang' }],
  knowsAbout: [
    'Information Systems',
    'Data Analysis',
    'Data Visualization',
    'Business Process Improvement',
    'UI/UX Design',
  ],
  sameAs: [
    'https://www.linkedin.com/in/hamzahnaufal',
    'https://www.instagram.com/hamz_nz',
  ],
};
---

<!doctype html>
<html lang={site.locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={isHome ? 'profile' : 'website'} />
    <meta property="og:site_name" content="Hamzah Naufal Zuhdi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content={site.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <meta name="theme-color" content="#0d0c0b" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Pre-paint theme bootstrap: must run before first paint to avoid a light
         flash on a dark-first site, so it stays inline and blocking. It sets the
         theme WITHOUT the transition guard, so first paint is instant. -->
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem('hnz-theme');
          var t =
            s === 'dark' || s === 'light'
              ? s
              : window.matchMedia &&
                  window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          var r = document.documentElement;
          r.setAttribute('data-theme', t);
          r.style.colorScheme = t;
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Navbar />

    <!-- The page wrapper carries the fade-in transition, so the nav and footer
         stay put while the content settles. -->
    <main id="main" tabindex="-1" class="page-in">
      <slot />
    </main>

    <Footer />

    <!-- One shared viewer for every image with data-lightbox-src -->
    <Lightbox />

    <script>
      /**
       * Progressive enhancement:
       *  - marks that JS is available, so reveal styles only hide content when
       *    they can also un-hide it
       *  - reveals [data-reveal] elements as they scroll into view
       */
      const root = document.documentElement;
      root.classList.add('js');

      const targets = document.querySelectorAll('[data-reveal]');

      if (targets.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        );

        targets.forEach((t) => io.observe(t));
      }

      /* Stagger children of a [data-reveal-group] container. */
      document.querySelectorAll<HTMLElement>('[data-reveal-group]').forEach((group) => {
        group.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el, i) => {
          el.style.setProperty('--reveal-delay', `${Math.min(i * 55, 330)}ms`);
        });
      });
    </script>
  </body>
</html>
